[Unit]
Description=STALKER port guardian (restarts the supervisors, dashboard, watchers and night walk when they die or hang)
After=graphical-session.target

[Service]
KillMode=process
Type=simple
WorkingDirectory=%h/Documents/GitHub/ogsr-complete-merge
ExecStart=/usr/bin/python3 %h/Documents/GitHub/ogsr-complete-merge/tools/guardian.py
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
