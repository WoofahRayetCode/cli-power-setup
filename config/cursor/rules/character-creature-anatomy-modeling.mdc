## 2. Automated Retopology Target Setup (`bpy`)

When moving from a high-resolution organic sculpt (millions of polygons) to an animatable low-poly cage, set up a shrinkwrap retopology target automatically:

```python
import bpy

def setup_retopology_cage(sculpt_obj_name):
    high_obj = bpy.data.objects[sculpt_obj_name]
    
    # Create empty plane for retopology
    bpy.ops.mesh.primitive_plane_add(size=0.1, location=high_obj.location)
    retopo = bpy.context.active_object
    retopo.name = f"{high_obj.name}_Retopo_Cage"
    
    # Enable face snapping with projection
    bpy.context.scene.tool_settings.use_snap = True
    bpy.context.scene.tool_settings.snap_elements = {'FACE'}
    bpy.context.scene.tool_settings.use_snap_project = True
    
    # Add Shrinkwrap modifier targeting the sculpt
    sw = retopo.modifiers.new(name="SurfaceShrinkwrap", type='SHRINKWRAP')
    sw.target = high_obj
    sw.wrap_method = 'TARGET_NORMAL'
    sw.offset = 0.001
    
    # Add Mirror modifier for symmetrical anatomy
    mirror = retopo.modifiers.new(name="SymmetryMirror", type='MIRROR')
    mirror.use_clip = True
    mirror.mirror_object = high_obj
    
    print(f"Retopology cage configured for: {retopo.name}")
    return retopo
```

