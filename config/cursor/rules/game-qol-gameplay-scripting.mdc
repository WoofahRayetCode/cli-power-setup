# Game Quality-of-Life (QoL) Gameplay Scripting (`game-qol-gameplay-scripting`)

The `game-qol-gameplay-scripting` skill provides production-grade Lua patterns, spatial geometry algorithms, and state management recipes for implementing smart quality-of-life mechanics in video games (focusing on **S.T.A.L.K.E.R. X-Ray / OGSR** and open-world RPG runtimes).

---

## 1. Smart Proximity Scanner & Auto-Loot Architecture

Automatically vacuuming valuable or critical items into the player's inventory without collecting encumbering junk:

```lua
-- gamedata/scripts/smart_autoloot.script
local SCAN_RADIUS = 18.0 -- Radius in meters
local last_scan_time = 0

function update_autoloot()
    local tg = time_global()
    if tg - last_scan_time < 1000 then return end -- Scan once per second
    last_scan_time = tg

    if not db.actor or not db.actor:alive() then return end
    local actor_pos = db.actor:position()

    for id = 1, 65534 do
        local obj = level.object_by_id(id)
        if obj and not obj:parent() then -- Object is in the world, not inside an inventory box or corpse
            local dist = actor_pos:distance_to(obj:position())
            if dist <= SCAN_RADIUS then
                local sec = obj:section()
                if is_critical_or_useful_item(sec, obj) then
                    db.actor:transfer_item(obj, db.actor)
                    news_manager.send_tip(db.actor, "Auto-Loot: " .. game.translate_string(system_ini():r_string(sec, "inv_name")), nil, nil, 2000)
                end
            end
        end
    end
end

function is_critical_or_useful_item(sec, obj)
    local ini = system_ini()
    -- 1. Story / Quest Items
    if ini:line_exist(sec, "quest_item") and ini:r_bool(sec, "quest_item") then
        return true
    end
    -- 2. Flash drives, documents, and PDAs
    if string.find(sec, "flash") or string.find(sec, "document") or string.find(sec, "pda") then
        return true
    end
    -- 3. Medical Supplies (if health < 80% or bleeding)
    if sec == "medkit" or sec == "medkit_army" or sec == "medkit_scientic" or sec == "bandage" then
        return true
    end
    -- 4. Ammo for currently active weapon
    local active_item = db.actor:active_item()
    if active_item and is_weapon(active_item) then
        local wpn_ammo_class = ini:r_string(active_item:section(), "ammo_class")
        if string.find(wpn_ammo_class, sec) then
            return true
        end
    end
    return false
end
```

