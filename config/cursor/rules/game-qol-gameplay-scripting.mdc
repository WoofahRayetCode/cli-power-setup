## 2. Autonomous Proximity Self-Defense with Faction Safeguards

Spawns homing counter-measures against approaching hostiles while strictly protecting neutrals, allies, and quest NPCs:

```lua
-- gamedata/scripts/actor_autodefense.script
local DEFENSE_RADIUS = 22.0
local COOLDOWN_MS = 2500 -- Throttle audio stimulation: 1 projectile every 2.5s
local last_shot_time = 0

function update_autodefense()
    local tg = time_global()
    if tg - last_shot_time < COOLDOWN_MS then return end
    if not db.actor or not db.actor:alive() then return end

    local actor_pos = db.actor:position()
    local target = nil
    local min_dist = DEFENSE_RADIUS

    for id = 1, 65534 do
        local npc = level.object_by_id(id)
        if npc and (IsStalker(npc) or IsMonster(npc)) and npc:alive() and npc:id() ~= db.actor:id() then
            -- Verify enemy relationship
            local is_enemy = false
            if IsMonster(npc) then
                is_enemy = true
            elseif npc:relation(db.actor) == game_object.enemy then
                is_enemy = true
            end

            -- Ensure we NEVER target allies, loners, or neutral traders
            local comm = npc:character_community()
            if comm == "trader" or comm == "actor_loner" and not is_enemy then
                is_enemy = false
            end

            if is_enemy then
                local dist = actor_pos:distance_to(npc:position())
                if dist < min_dist then
                    min_dist = dist
                    target = npc
                end
            end
        end
    end

    if target then
        fire_countermeasure(target)
        last_shot_time = tg
    end
end

function fire_countermeasure(target)
    local launch_pos = db.actor:position()
    launch_pos.y = launch_pos.y + 1.6 -- Spawn at chest height
    
    -- Spawn guided rocket or explosive projectile
    local rocket = alife():create("wpn_fake_missile", launch_pos, db.actor:level_vertex_id(), db.actor:game_vertex_id())
    -- Apply directional impulse toward target
    level.add_call(
        function() return level.object_by_id(rocket.id) ~= nil end,
        function()
            local r_obj = level.object_by_id(rocket.id)
            if r_obj then
                local dir = target:position():sub(launch_pos):normalize()
                r_obj:set_const_force(dir, 120, 1000)
            end
        end
    )
end
```

