## 3. Automated Watertight Manifold Auditor & Repair (`bmesh`)
Before exporting `.stl` or `.3mf`, run this deterministic `bmesh` manifold repair and verification pass:

```python
import bpy
import bmesh

def repair_and_verify_manifold(obj: bpy.types.Object) -> dict:
    bm = bmesh.new()
    bm.from_mesh(obj.data)

    # 1. Merge coincident vertices & dissolve zero-area degenerate edges/faces
    bmesh.ops.remove_doubles(bm, verts=bm.verts, dist=0.0001)
    bmesh.ops.dissolve_degenerate(bm, dist=0.0001, edges=bm.edges)

    # 2. Fill boundary holes and recalculate outward normals
    non_manifold_edges = [e for e in bm.edges if not e.is_manifold]
    if non_manifold_edges:
        bmesh.ops.holes_fill(bm, edges=non_manifold_edges, sides=64)
    bmesh.ops.recalc_face_normals(bm, faces=bm.faces)
    bmesh.ops.triangulate(bm, faces=bm.faces)

    remaining_bad = sum(1 for e in bm.edges if not e.is_manifold)
    volume = bm.calc_volume()
    bm.to_mesh(obj.data)
    bm.free()
    obj.data.update()
    return {"is_watertight": remaining_bad == 0, "non_manifold_edges": remaining_bad, "volume_mm3": round(volume, 2)}
```

