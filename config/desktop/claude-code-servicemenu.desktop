[Desktop Entry]
Type=Service
MimeType=inode/directory;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel
Actions=openClaudeHere;openClaudeEcoHere;

[Desktop Action openClaudeHere]
Name=Open in Claude Code Here
Comment=Open Claude Code terminal in this directory
Icon=claude-code
Exec=konsole --workdir %f -e /home/ericparsley/.local/bin/claude

[Desktop Action openClaudeEcoHere]
Name=Open in Claude Code (Eco Mode) Here
Comment=Open Claude Code in low-effort Eco Mode in this directory
Icon=claude-eco
Exec=konsole --workdir %f -e /home/ericparsley/.local/bin/claude-eco
