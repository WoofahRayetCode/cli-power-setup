#!/usr/bin/env bash
# Launch Antigravity CLI in hands-free YOLO mode (auto-approves tool executions without prompting)
[ -t 1 ] && command -v agy-cheatsheet >/dev/null 2>&1 && agy-cheatsheet --banner
[ -t 1 ] && command -v agy-mic-button >/dev/null 2>&1 && agy-mic-button >/dev/null 2>&1 &
exec agy --dangerously-skip-permissions --mode auto "$@"
