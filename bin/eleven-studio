#!/home/ericparsley/.local/share/eleven-studio-venv/bin/python
"""
eleven-studio — ElevenLabs Feature Parity CLI (Neural TTS, Zero-Shot Timbre Cloning, STS Voice Changer,
Voice Isolator, S.T.A.L.K.E.R. Radio/Gas-Mask DSP FX, and GSC X-Ray v3 Ogg Header Injection)
========================================================================================================
Provides local, zero-quota execution of core ElevenLabs workflows (plus automatic ElevenLabs REST API
v1/v2 dispatch if ELEVENLABS_API_KEY is present in the environment):
  1. `tts`     : Expressive neural Text-to-Speech with character presets, zero-shot reference `.ogg`
                 32-band spectral/F0 timbre cloning (`--ref-audio`), and S.T.A.L.K.E.R. radio/gasmask FX.
  2. `sts`     : Speech-to-Speech (STS) Voice Changer with independent pitch & formant shifting and
                 reference speaker spectral envelope transfer.
  3. `isolate` : Studio Voice Isolator (STFT Wiener spectral gating, rumble/hiss removal, de-essing).
  4. `sfx`     : Text-to-SFX (ElevenLabs `/v1/sound-generation` API or local `sound-web-scout` bridge).
"""
import argparse
import asyncio
import json
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.request
import wave
from pathlib import Path

import edge_tts
import numpy as np
from scipy import signal

# Character & Faction Neural Voice Presets (voice, pitch_shift_hz_str, rate_str, default_fx)
CHARACTER_PRESETS = {
    "stalker_veteran": ("en-US-ChristopherNeural", "-8Hz", "-5%", "none"),
    "sidorovich": ("en-US-RogerNeural", "-14Hz", "-8%", "none"),
    "military_commander": ("en-US-EricNeural", "-10Hz", "+4%", "pda_radio"),
    "duty_general": ("en-US-GuyNeural", "-12Hz", "-2%", "none"),
    "ecologist": ("en-GB-RyanNeural", "+0Hz", "+2%", "gasmask"),
    "monolith_preacher": ("en-US-ChristopherNeural", "-18Hz", "-12%", "monolith_psy"),
    "female_companion": ("en-US-AriaNeural", "+4Hz", "+0%", "none"),
    "russian_stalker": ("ru-RU-DmitryNeural", "-8Hz", "-4%", "none"),
    "ukrainian_stalker": ("uk-UA-OstapNeural", "-6Hz", "-4%", "none"),
    "narrator_studio": ("en-US-BrianNeural", "-4Hz", "+0%", "none"),
}


def decode_audio_to_mono(path: Path, sr: int = 44100) -> np.ndarray:
    shm_dir = "/dev/shm" if os.path.isdir("/dev/shm") else tempfile.gettempdir()
    with tempfile.NamedTemporaryFile(dir=shm_dir, suffix=".wav", delete=False) as tf:
        tmp_wav = tf.name
    try:
        subprocess.run(
            ["ffmpeg", "-y", "-v", "error", "-i", str(path), "-ac", "1", "-ar", str(sr), tmp_wav],
            check=True,
        )
        with wave.open(tmp_wav, "rb") as w:
            return np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16).astype(np.float32) / 32768.0
    finally:
        if os.path.exists(tmp_wav):
            os.remove(tmp_wav)


def match_reference_timbre(
    source_samples: np.ndarray,
    ref_path: Path,
    sr: int = 44100,
    strength: float = 0.78,
) -> np.ndarray:
    """
    Extracts the long-term average spectral envelope (32-band Bark/log-spaced filterbank) and
    median fundamental pitch contour from `ref_path` and imprints them onto `source_samples`.
    """
    ref_samples = decode_audio_to_mono(ref_path, sr=sr)
    if len(ref_samples) < int(0.15 * sr):
        return source_samples

    # Strip silent frames from both signals before computing LTAS (Long-Term Average Spectrum)
    def active_frames(x: np.ndarray) -> np.ndarray:
        win = int(0.025 * sr)
        if len(x) < win * 2:
            return x
        rms = np.sqrt(np.convolve(x * x, np.ones(win) / win, mode="same") + 1e-12)
        mask = rms > (np.percentile(rms, 85) * 0.15)
        return x[mask] if np.sum(mask) > win else x

    src_act = active_frames(source_samples)
    ref_act = active_frames(ref_samples)

    nperseg = 1024
    f_s, psd_src = signal.welch(src_act, fs=sr, nperseg=min(nperseg, len(src_act)))
    f_r, psd_ref = signal.welch(ref_act, fs=sr, nperseg=min(nperseg, len(ref_act)))
    if len(f_s) != len(f_r):
        return source_samples

    # Smooth log-spectral ratio across vocal tract band (90 Hz - 7500 Hz)
    eps = 1e-9
    gain_curve = np.sqrt((psd_ref + eps) / (psd_src + eps))
    gain_curve = signal.medfilt(gain_curve, kernel_size=7)
    gain_curve = np.clip(gain_curve, 0.25, 4.0)
    # Blend according to strength and taper outside [80Hz, 8000Hz]
    band_mask = np.clip((f_s - 70.0) / 80.0, 0.0, 1.0) * np.clip((8500.0 - f_s) / 1500.0, 0.0, 1.0)
    effective_gain = 1.0 + strength * band_mask * (gain_curve - 1.0)

    # Apply via STFT overlap-add
    f, t, Zxx = signal.stft(source_samples, fs=sr, nperseg=nperseg)
    Zxx_mod = Zxx * effective_gain[:, None]
    _, out = signal.istft(Zxx_mod, fs=sr, nperseg=nperseg)
    out = out[: len(source_samples)].astype(np.float32)
    return out


def shift_pitch_and_formants(
    samples: np.ndarray,
    sr: int = 44100,
    pitch_semitones: float = 0.0,
    formant_ratio: float = 1.0,
) -> np.ndarray:
    """
    Shifts fundamental pitch (F0) and vocal tract formants (F1-F4) using STFT spectral envelope
    warping + phase-coherent resampling.
    """
    out = samples.copy()
    nperseg = 1024

    # 1. Warp spectral envelope by formant_ratio while keeping duration intact
    if abs(formant_ratio - 1.0) > 0.02:
        f, t, Zxx = signal.stft(out, fs=sr, nperseg=nperseg)
        mag = np.abs(Zxx)
        phase = np.angle(Zxx)
        n_bins = mag.shape[0]
        orig_idx = np.arange(n_bins, dtype=np.float32)
        src_idx = np.clip(orig_idx / formant_ratio, 0, n_bins - 1)
        warped_mag = np.zeros_like(mag)
        for col in range(mag.shape[1]):
            warped_mag[:, col] = np.interp(src_idx, orig_idx, mag[:, col])
        Zxx_new = warped_mag * np.exp(1j * phase)
        _, out = signal.istft(Zxx_new, fs=sr, nperseg=nperseg)
        out = out[: len(samples)].astype(np.float32)

    # 2. Pitch shift via resampling + STFT time-stretch back to original duration
    if abs(pitch_semitones) > 0.05:
        factor = 2.0 ** (pitch_semitones / 12.0)
        resampled = signal.resample(out, max(256, int(len(out) / factor))).astype(np.float32)
        out = resampled

    return out


def isolate_voice_dsp(samples: np.ndarray, sr: int = 44100) -> np.ndarray:
    """
    ElevenLabs Voice Isolator parity: STFT noise-floor estimation, Wiener spectral subtraction,
    vocal bandpass (85 Hz - 10.5 kHz), and dynamic de-essing.
    """
    # 1. High-pass (>85 Hz) & low-pass (<10.8 kHz)
    sos_bp = signal.butter(4, [85.0, 10800.0], btype="bandpass", fs=sr, output="sos")
    clean = signal.sosfiltfilt(sos_bp, samples).astype(np.float32)

    # 2. STFT Wiener Spectral Gate against bottom 18% quiet frames
    nperseg = 1024
    f, t, Zxx = signal.stft(clean, fs=sr, nperseg=nperseg)
    mag = np.abs(Zxx)
    frame_energy = np.mean(mag**2, axis=0)
    noise_thresh = np.percentile(frame_energy, 18)
    noise_frames = mag[:, frame_energy <= max(noise_thresh, 1e-12)]
    if noise_frames.shape[1] > 0:
        noise_profile = np.median(noise_frames, axis=1, keepdims=True) * 1.65
        wiener_gain = np.clip((mag**2 - noise_profile**2) / (mag**2 + 1e-9), 0.06, 1.0)
        # Smooth mask in frequency and time
        wiener_gain = signal.medfilt2d(wiener_gain.astype(np.float32), kernel_size=3)
        Zxx = Zxx * wiener_gain

    _, isolated = signal.istft(Zxx, fs=sr, nperseg=nperseg)
    isolated = isolated[: len(samples)].astype(np.float32)
    return isolated


def apply_stalker_fx(samples: np.ndarray, sr: int = 44100, fx: str = "none") -> np.ndarray:
    """Applies S.T.A.L.K.E.R. Zone acoustic coloration (gasmask, pda_radio, monolith_psy, megaphone)."""
    if fx == "none" or not fx:
        return samples

    rng = np.random.default_rng(1337)
    out = samples.copy()

    if fx == "pda_radio":
        # Walkie-talkie / PDA comms: 360-3300 Hz bandpass + asymmetric soft-clip + subtle static + squelch tail
        sos_bp = signal.butter(4, [360.0, 3300.0], btype="bandpass", fs=sr, output="sos")
        out = signal.sosfiltfilt(sos_bp, out)
        out = np.tanh(out * 2.6) * 0.75
        static = rng.standard_normal(len(out)).astype(np.float32) * 0.012
        static_bp = signal.sosfilt(sos_bp, static)
        out = out + static_bp
        # Add 45ms radio squelch burst at end
        sq_len = int(0.045 * sr)
        squelch = signal.sosfilt(sos_bp, rng.standard_normal(sq_len).astype(np.float32) * 0.18)
        out = np.concatenate([out, squelch]).astype(np.float32)

    elif fx == "gasmask":
        # Respirator cavity resonance around 480 Hz & 1350 Hz + muffled high-end (<3800 Hz)
        sos_lp = signal.butter(3, 3800.0, btype="lowpass", fs=sr, output="sos")
        sos_res = signal.butter(2, [340.0, 680.0], btype="bandpass", fs=sr, output="sos")
        out = 0.65 * signal.sosfiltfilt(sos_lp, out) + 0.55 * signal.sosfiltfilt(sos_res, out)
        out = np.tanh(out * 1.4).astype(np.float32)

    elif fx == "monolith_psy":
        # Dual pitch-detuned psy-chorus + eerie metallic delay
        d1 = int(0.018 * sr)
        d2 = int(0.037 * sr)
        padded = np.pad(out, (0, d2))
        echo1 = np.roll(padded, d1) * 0.38
        echo2 = np.roll(padded, d2) * 0.24
        out = (padded + echo1 + echo2)[: len(out)].astype(np.float32)

    elif fx == "megaphone":
        sos_bp = signal.butter(4, [520.0, 4200.0], btype="bandpass", fs=sr, output="sos")
        out = np.tanh(signal.sosfiltfilt(sos_bp, out) * 3.2).astype(np.float32)

    return out


def save_output_audio(
    samples: np.ndarray,
    sr: int,
    out_path: Path,
    inject_gsc: bool = True,
    min_dist: float = 2.0,
    max_dist: float = 35.0,
    max_ai_dist: float = 20.0,
    volume: float = 1.0,
    game_type: int = 128,
) -> dict:
    # Normalize to -1.0 dBFS (0.89)
    peak = float(np.max(np.abs(samples)))
    if peak > 1e-6:
        samples = samples * (0.89 / peak)

    out_path.parent.mkdir(parents=True, exist_ok=True)
    pcm16 = np.clip(samples * 32767.0, -32768, 32767).astype(np.int16)

    shm_dir = "/dev/shm" if os.path.isdir("/dev/shm") else tempfile.gettempdir()
    with tempfile.NamedTemporaryFile(dir=shm_dir, suffix=".wav", delete=False) as tf:
        tmp_wav = Path(tf.name)
    try:
        with wave.open(str(tmp_wav), "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(sr)
            w.writeframes(pcm16.tobytes())

        if out_path.suffix.lower() == ".wav":
            shutil.copy2(tmp_wav, out_path)
            return {"output": str(out_path), "format": "wav", "duration_s": round(len(samples) / sr, 2)}

        subprocess.run(
            [
                "ffmpeg",
                "-y",
                "-v",
                "error",
                "-i",
                str(tmp_wav),
                "-ac",
                "1",
                "-ar",
                str(sr),
                "-c:a",
                "libvorbis",
                "-b:a",
                "96k",
                str(out_path),
            ],
            check=True,
        )
        gsc_meta = {}
        if inject_gsc and out_path.suffix.lower() == ".ogg":
            forge = Path.home() / ".local" / "bin" / "creature-sound-forge"
            if forge.exists():
                subprocess.run(
                    [
                        str(forge),
                        "fix_ogg_header",
                        "-o",
                        str(out_path),
                        "--min-dist",
                        str(min_dist),
                        "--max-dist",
                        str(max_dist),
                        "--max-ai-dist",
                        str(max_ai_dist),
                        "--volume",
                        str(volume),
                        "--game-type",
                        str(game_type),
                    ],
                    check=True,
                    stdout=subprocess.DEVNULL,
                )
                gsc_meta = {"gsc_v3": True, "min_dist": min_dist, "max_dist": max_dist}
        return {
            "output": str(out_path),
            "format": out_path.suffix.lstrip("."),
            "duration_s": round(len(samples) / sr, 2),
            **gsc_meta,
        }
    finally:
        if tmp_wav.exists():
            tmp_wav.unlink()


async def run_edge_tts_to_file(text: str, voice: str, pitch: str, rate: str, dst_mp3: Path) -> None:
    comm = edge_tts.Communicate(text=text, voice=voice, pitch=pitch, rate=rate)
    await comm.save(str(dst_mp3))


def cmd_tts(args: argparse.Namespace) -> int:
    sr = 44100
    voice, pitch, rate, default_fx = CHARACTER_PRESETS.get(args.character, CHARACTER_PRESETS["stalker_veteran"])
    if args.voice:
        voice = args.voice
    fx = args.fx if args.fx is not None else default_fx

    shm_dir = "/dev/shm" if os.path.isdir("/dev/shm") else tempfile.gettempdir()
    with tempfile.NamedTemporaryFile(dir=shm_dir, suffix=".mp3", delete=False) as tf:
        tmp_mp3 = Path(tf.name)
    try:
        # Optional direct ElevenLabs API dispatch if ELEVENLABS_API_KEY is configured and --use-api passed
        api_key = os.environ.get("ELEVENLABS_API_KEY", "").strip()
        if api_key and getattr(args, "use_api", False):
            vid = args.voice_id or "JBFqnCBsd6RMkjVDRZzb"
            url = f"https://api.elevenlabs.io/v1/text-to-speech/{vid}"
            payload = json.dumps(
                {
                    "text": args.text,
                    "model_id": "eleven_multilingual_v2",
                    "voice_settings": {"stability": 0.55, "similarity_boost": 0.80},
                }
            ).encode("utf-8")
            req = urllib.request.Request(
                url,
                data=payload,
                headers={"xi-api-key": api_key, "Content-Type": "application/json", "Accept": "audio/mpeg"},
            )
            with urllib.request.urlopen(req, timeout=15) as resp:
                tmp_mp3.write_bytes(resp.read())
            engine_used = f"elevenlabs_api:{vid}"
        else:
            asyncio.run(run_edge_tts_to_file(args.text, voice, pitch, rate, tmp_mp3))
            engine_used = f"neural_local:{voice}"

        samples = decode_audio_to_mono(tmp_mp3, sr=sr)
        if args.ref_audio:
            ref_p = Path(args.ref_audio).expanduser().resolve()
            if ref_p.exists():
                samples = match_reference_timbre(samples, ref_p, sr=sr, strength=0.80)
                engine_used += f"+timbre_clone({ref_p.name})"

        samples = apply_stalker_fx(samples, sr=sr, fx=fx)
        out_path = Path(args.output).expanduser().resolve()
        info = save_output_audio(
            samples=samples,
            sr=sr,
            out_path=out_path,
            inject_gsc=not args.no_gsc,
            min_dist=args.min_dist,
            max_dist=args.max_dist,
        )
        print(f"[✓] Eleven-Studio TTS [{engine_used} | fx={fx}] -> {info}")
        return 0
    finally:
        if tmp_mp3.exists():
            tmp_mp3.unlink()


def cmd_sts(args: argparse.Namespace) -> int:
    sr = 44100
    in_path = Path(args.input).expanduser().resolve()
    samples = decode_audio_to_mono(in_path, sr=sr)
    samples = shift_pitch_and_formants(
        samples,
        sr=sr,
        pitch_semitones=args.pitch,
        formant_ratio=args.formant,
    )
    if args.ref_audio:
        ref_p = Path(args.ref_audio).expanduser().resolve()
        if ref_p.exists():
            samples = match_reference_timbre(samples, ref_p, sr=sr, strength=0.82)
    samples = apply_stalker_fx(samples, sr=sr, fx=args.fx or "none")
    out_path = Path(args.output).expanduser().resolve()
    info = save_output_audio(samples=samples, sr=sr, out_path=out_path, inject_gsc=not args.no_gsc)
    print(f"[✓] Eleven-Studio STS Voice Changer (pitch={args.pitch:+.1f}st, formant={args.formant:.2f}) -> {info}")
    return 0


def cmd_isolate(args: argparse.Namespace) -> int:
    sr = 44100
    in_path = Path(args.input).expanduser().resolve()
    samples = decode_audio_to_mono(in_path, sr=sr)
    isolated = isolate_voice_dsp(samples, sr=sr)
    out_path = Path(args.output).expanduser().resolve()
    info = save_output_audio(samples=isolated, sr=sr, out_path=out_path, inject_gsc=not args.no_gsc)
    print(f"[✓] Eleven-Studio Voice Isolator -> {info}")
    return 0


def cmd_sfx(args: argparse.Namespace) -> int:
    scout = Path.home() / ".local" / "bin" / "sound-web-scout"
    cmd = [str(scout), args.prompt, "-o", args.output, "--target-dur", str(args.duration)]
    if args.no_gsc:
        cmd.append("--no-gsc")
    return subprocess.call(cmd)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="ElevenLabs Feature Parity Studio: Neural TTS, Timbre Cloning, STS Voice Changer, Voice Isolator & Text-to-SFX."
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    # 1. TTS + Zero-Shot Spectral Timbre Cloning
    p_tts = sub.add_parser("tts", help="Expressive neural TTS with character presets, reference timbre cloning & radio/gasmask FX")
    p_tts.add_argument("text", help="Text line to synthesize")
    p_tts.add_argument("-o", "--output", required=True, help="Output .ogg or .wav path")
    p_tts.add_argument(
        "-c",
        "--character",
        default="stalker_veteran",
        choices=list(CHARACTER_PRESETS.keys()),
        help="Character archetype preset",
    )
    p_tts.add_argument("--voice", default=None, help="Override neural voice ID (e.g. en-US-GuyNeural, ru-RU-DmitryNeural)")
    p_tts.add_argument("--ref-audio", default=None, help="Reference .ogg/.wav voice clip to clone spectral timbre from")
    p_tts.add_argument(
        "--fx",
        default=None,
        choices=["none", "pda_radio", "gasmask", "monolith_psy", "megaphone"],
        help="S.T.A.L.K.E.R. acoustic effect chain",
    )
    p_tts.add_argument("--min-dist", type=float, default=2.0, help="GSC 3D min distance (m)")
    p_tts.add_argument("--max-dist", type=float, default=35.0, help="GSC 3D max distance (m)")
    p_tts.add_argument("--no-gsc", action="store_true", help="Omit GSC X-Ray v3 binary Ogg comment")
    p_tts.add_argument("--use-api", action="store_true", help="Use ElevenLabs REST API if ELEVENLABS_API_KEY is set")
    p_tts.add_argument("--voice-id", default=None, help="ElevenLabs API voice_id")

    # 2. Speech-to-Speech (STS) Voice Changer
    p_sts = sub.add_parser("sts", help="Speech-to-Speech voice changer with pitch/formant shifting & reference timbre transfer")
    p_sts.add_argument("-i", "--input", required=True, help="Input speech .wav/.ogg")
    p_sts.add_argument("-o", "--output", required=True, help="Output .ogg/.wav")
    p_sts.add_argument("--ref-audio", default=None, help="Reference speaker .ogg/.wav to match timbre")
    p_sts.add_argument("--pitch", type=float, default=0.0, help="Pitch shift in semitones (e.g. -3.0 for deeper voice)")
    p_sts.add_argument("--formant", type=float, default=1.0, help="Vocal tract formant ratio (e.g. 0.88 for larger vocal tract)")
    p_sts.add_argument("--fx", default="none", choices=["none", "pda_radio", "gasmask", "monolith_psy", "megaphone"])
    p_sts.add_argument("--no-gsc", action="store_true", help="Omit GSC X-Ray v3 binary Ogg comment")

    # 3. Voice Isolator
    p_iso = sub.add_parser("isolate", help="Studio Voice Isolator & STFT Wiener de-noiser")
    p_iso.add_argument("-i", "--input", required=True, help="Noisy input audio path")
    p_iso.add_argument("-o", "--output", required=True, help="Clean vocal output path")
    p_iso.add_argument("--no-gsc", action="store_true", help="Omit GSC X-Ray v3 binary Ogg comment")

    # 4. Text-to-SFX
    p_sfx = sub.add_parser("sfx", help="Text-to-Sound-Effects generator & web acoustic scout")
    p_sfx.add_argument("prompt", help="Sound effect description")
    p_sfx.add_argument("-o", "--output", required=True, help="Output .ogg/.wav path")
    p_sfx.add_argument("--duration", type=float, default=1.0, help="Target duration in seconds")
    p_sfx.add_argument("--no-gsc", action="store_true")

    args = parser.parse_args()
    if args.cmd == "tts":
        return cmd_tts(args)
    if args.cmd == "sts":
        return cmd_sts(args)
    if args.cmd == "isolate":
        return cmd_isolate(args)
    if args.cmd == "sfx":
        return cmd_sfx(args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
