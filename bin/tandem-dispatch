#!/usr/bin/env python3
"""
Tandem Dispatcher CLI (tandem-dispatch)
Sends targeted tasks, checkpoints, pause commands, and workload divisions to Argon (Pane 0), Fable (Pane 1), or both.
"""

import sys
import subprocess
import argparse
import json
from pathlib import Path

def run_cmd(cmd):
    return subprocess.run(cmd, shell=True, text=True, capture_output=True)

def find_tandem_session():
    res = run_cmd("tmux list-sessions -F '#{session_name}'")
    if res.returncode != 0 or not res.stdout.strip():
        return None
    sessions = res.stdout.strip().splitlines()
    for s in sessions:
        if s.startswith("tandem-yolo"):
            return s
    return None

def send_to_pane(session, pane_idx, message):
    safe_msg = message.replace("'", "'\\''")
    cmd = f"tmux send-keys -t '{session}:0.{pane_idx}' '{safe_msg}' Enter"
    run_cmd(cmd)

def main():
    parser = argparse.ArgumentParser(description="Dispatch tasks to tandem Argon and Fable agents")
    parser.add_argument("--to", choices=["argon", "fable", "both", "checkpoint", "stop", "pause", "split"], default="split", help="Target agent, action, or automatic split")
    parser.add_argument("message", nargs="*", help="Task instruction or prompt to dispatch")
    
    args = parser.parse_args()
    session = find_tandem_session()
    
    if not session:
        print("[-] No active 'tandem-yolo' tmux session found.")
        print("[*] Launch it first via the desktop shortcut or running: tandem-yolo")
        sys.exit(1)
        
    text = " ".join(args.message).strip()
    
    if args.to in ["stop", "pause"]:
        stop_prompt = (
            "STAGE_CHECKPOINT_AND_HALT: Snapshot all uncommitted in-flight diffs to .agents/checkpoints/, "
            "record your completed milestones and active hypothesis into .agents/handoff.json and .agents/memory/activeContext.md, "
            "commit any verified work to your branch, and gracefully stop all execution. Do not execute any further commands."
        )
        print(f"[*] Broadcasting checkpoint-and-stop command to both Argon and Fable in session {session}...")
        send_to_pane(session, 0, stop_prompt)
        send_to_pane(session, 1, stop_prompt)
        print("[✓] Both agents instructed to checkpoint and stop!")
        return

    if args.to == "checkpoint":
        checkpoint_prompt = (
            "Resume uninterrupted execution from .agents/handoff.json and .agents/memory/activeContext.md. "
            "Ingest current milestones, check assigned role, and immediately continue the next step."
        )
        print(f"[*] Broadcasting checkpoint resume to both Argon and Fable in session {session}...")
        send_to_pane(session, 0, checkpoint_prompt)
        send_to_pane(session, 1, checkpoint_prompt)
        print("[✓] Checkpoint resume dispatched!")
        return

    if not text:
        print("[-] Error: Please provide an instruction to dispatch.")
        sys.exit(1)

    if args.to == "split":
        argon_instruction = (
            f"[ROLE: ARGON - ASSETS, AUDIO & QA] Goal: {text}. "
            "Focus strictly on: asset extraction (retoc/repak), audio Ogg GSC comments, LTX ballistic curve configs, "
            "autonomous playtest verification, and Wine/Proton crash triage. Do not modify C++ engine code."
        )
        fable_instruction = (
            f"[ROLE: FABLE - C++ & SCRIPT ENGINE] Goal: {text}. "
            "Focus strictly on: C++ 64-bit engine code repairs, pointer alignment, LuaJIT FFI bindings, "
            "and unit/compiler test passes. Do not unpack raw asset containers."
        )
        print(f"[*] Intelligently splitting workload for: \"{text}\"")
        print(f"  -> Argon: Assets, Audio, LTX & Playtest QA")
        send_to_pane(session, 0, argon_instruction)
        print(f"  -> Fable: C++ 64-bit Engine Code & LuaJIT FFI")
        send_to_pane(session, 1, fable_instruction)
        print("[✓] Workload split and dispatched to both agents!")
        return
        
    if args.to in ["argon", "both"]:
        print(f"[*] Dispatching to Argon (Left Pane): {text}")
        send_to_pane(session, 0, text)
        
    if args.to in ["fable", "both"]:
        print(f"[*] Dispatching to Fable (Right Pane): {text}")
        send_to_pane(session, 1, text)
        
    print("[✓] Dispatched successfully!")

if __name__ == "__main__":
    main()
