#!/usr/bin/env bash
# tandem-yolo: Launch Argon, Fable, and a Control/Dispatch Pane side-by-side-by-side (vertical columns)
# Usage: tandem-yolo [/path/to/project/root]

set -euo pipefail

SESSION_NAME="tandem-yolo"
REPO_ROOT="${1:-$(pwd)}"

# Resolve repo paths
ARGON_DIR="${REPO_ROOT}"
FABLE_DIR="${REPO_ROOT}"

if [ -d "${REPO_ROOT}-argon" ]; then
    ARGON_DIR="${REPO_ROOT}-argon"
fi
if [ -d "${REPO_ROOT}-fable" ]; then
    FABLE_DIR="${REPO_ROOT}-fable"
fi

# Kill previous session with same name if dead or dangling
tmux kill-session -t "${SESSION_NAME}" 2>/dev/null || true

# 1. Create main session with Argon in Pane 0 (Column 1 - Left)
tmux new-session -d -s "${SESSION_NAME}" -n "tandem" "cd '${ARGON_DIR}' && agy-yolo"

# 2. Split vertically to put Fable in Pane 1 (Column 2 - Middle)
tmux split-window -h -t "${SESSION_NAME}:0" "cd '${FABLE_DIR}' && claude-yolo"

# 3. Split vertically again to put Controller in Pane 2 (Column 3 - Right)
tmux split-window -h -t "${SESSION_NAME}:0" "cd '${REPO_ROOT}' && echo -e '=== 🎮 TANDEM DISPATCH ===\nCommands:\n  tandem-dispatch \"<task>\"\n  tandem-dispatch --to checkpoint\n  tandem-dispatch --to argon \"<prompt>\"\n  tandem-dispatch --to fable \"<prompt>\"\n==========================' && exec bash"

# Set pure 33% / 33% / 33% vertical column layout (Side-by-Side-by-Side)
tmux select-layout -t "${SESSION_NAME}:0" even-horizontal

# Enable mouse support for clicking into panes and dragging border lines
tmux set-option -t "${SESSION_NAME}" mouse on

# Attach to session
if [ -t 0 ]; then
    exec tmux attach-session -t "${SESSION_NAME}"
else
    exec konsole -e tmux attach-session -t "${SESSION_NAME}"
fi
