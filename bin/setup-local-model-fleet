def check_ollama_service(endpoint: str = "http://localhost:11434") -> bool:
    try:
        req = urllib.request.Request(f"{endpoint.rstrip('/')}/api/tags")
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            return resp.status == 200
    except Exception:
        return False


def get_installed_models(endpoint: str = "http://localhost:11434") -> list[str]:
    try:
        req = urllib.request.Request(f"{endpoint.rstrip('/')}/api/tags")
        with urllib.request.urlopen(req, timeout=2.0) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                return [m.get("name", "") for m in data.get("models", []) if m.get("name")]
    except Exception:
        pass
    return []


def get_ollama_disk_usage() -> tuple[str, str]:
    total_size = "Unknown"
    avail_disk = "Unknown"
    for cand in ("/var/lib/ollama/blobs", "/var/lib/ollama", str(Path.home() / ".ollama")):
        p = Path(cand)
        if p.exists():
            try:
                proc = subprocess.run(["du", "-sh", cand], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
                if proc.stdout:
                    total_size = proc.stdout.split()[0]
                df_out = subprocess.run(["df", "-h", cand], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
                lines = df_out.stdout.strip().splitlines()
                if len(lines) >= 2:
                    parts = lines[1].split()
                    avail_disk = f"{parts[3]} free ({parts[4]} used of {parts[1]})"
                if total_size != "Unknown":
                    break
            except Exception:
                pass
    return total_size, avail_disk


def get_hardware_telemetry() -> dict[str, str]:
    res = {
        "cpu_threads": str(os.cpu_count() or "Unknown"),
        "ram_gb": "Unknown",
        "vram_mb": "Unknown",
    }
    # RAM
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    kb = int(line.split()[1])
                    res["ram_gb"] = f"{kb / (1024 * 1024):.1f} GB"
                    break
    except Exception:
        pass

    # VRAM via nvidia-smi
    try:
        out = subprocess.check_output(
            ["nvidia-smi", "--query-gpu=memory.total,memory.free", "--format=csv,noheader,nounits"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
        if out:
            total, free = [x.strip() for x in out.splitlines()[0].split(",")]
            res["vram_mb"] = f"{free} MB free / {total} MB total"
    except Exception:
        res["vram_mb"] = "N/A (CPU only)"

    return res


def install_symlinks():
    local_bin = Path.home() / ".local" / "bin"
    local_bin.mkdir(parents=True, exist_ok=True)

    links = {
        "local-coprocessor": REPO_ROOT / "config" / "skills" / "local-model-coprocessor" / "scripts" / "local_model_coprocessor.py",
        "setup-local-model-fleet": REPO_ROOT / "bin" / "setup-local-model-fleet",
        "agy-omni-mode": REPO_ROOT / "bin" / "agy-omni-mode",
        "local-research-scout": REPO_ROOT / "bin" / "local-research-scout",
        "gemini-reasoning-tuner": REPO_ROOT / "bin" / "gemini-reasoning-tuner",
        "voice-prompt-optimizer": REPO_ROOT / "bin" / "voice-prompt-optimizer",
        "model-quant-optimizer": REPO_ROOT / "bin" / "model-quant-optimizer",
    }

    installed = []
    for name, target in links.items():
        dest = local_bin / name
        if target.exists():
            target.chmod(0o755)
            if dest.is_symlink() or dest.exists():
                try:
                    dest.unlink()
                except Exception:
                    pass
            try:
                dest.symlink_to(target)
                installed.append(name)
            except Exception as e:
                print(f"{YELLOW}[!] Failed to symlink {name}: {e}{RESET}")

    if installed:
        print(f"{GREEN}[✓]{RESET} Symlinked {', '.join(installed)} into {local_bin}")


def build_custom_modelfiles():
    modelfile = MODEL_CONFIG_DIR / "Modelfile.blender-architect"
    if not modelfile.exists():
        print(f"{RED}[✗]{RESET} Modelfile {modelfile} not found.")
        return False

    print(f"\n{CYAN}Building custom model 'blender-architect:latest'...{RESET}")
    cmd = ["ollama", "create", "blender-architect", "-f", str(modelfile)]
    try:
        ret = subprocess.run(cmd, check=True)
        if ret.returncode == 0:
            print(f"{GREEN}[✓]{RESET} Successfully built custom model {BOLD}blender-architect:latest{RESET}")
            return True
    except subprocess.CalledProcessError as e:
        print(f"{RED}[✗]{RESET} Failed to build blender-architect: {e}")
        return False


def pull_model(model_name: str) -> bool:
    print(f"{CYAN}[→] Pulling {BOLD}{model_name}{RESET}...")
    try:
        proc = subprocess.Popen(["ollama", "pull", model_name], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in iter(proc.stdout.readline, ''):
            if line:
                sys.stdout.write(f"\r  {line.strip()[:75]:<75}")
                sys.stdout.flush()
        proc.wait()
        sys.stdout.write("\r" + " " * 80 + "\r")
        if proc.returncode == 0:
            print(f"{GREEN}[✓]{RESET} {BOLD}{model_name}{RESET} successfully downloaded and ready.")
            return True
        else:
            print(f"{RED}[✗]{RESET} Failed pulling {model_name} (code {proc.returncode})")
            return False
    except Exception as e:
        print(f"{RED}[✗]{RESET} Error executing ollama pull {model_name}: {e}")
        return False


def print_status():
    hw = get_hardware_telemetry()
    size_str, disk_str = get_ollama_disk_usage()
    service_ok = check_ollama_service()
    installed = set(get_installed_models())

    print(f"\n{BOLD}{CYAN}=== Local Ollama Model Fleet Telemetry ==={RESET}")
    print(f"  • Hardware Profile : {hw['cpu_threads']} CPU Threads | {hw['ram_gb']} System RAM | {hw['vram_mb']} VRAM")
    print(f"  • Ollama Service   : {GREEN+'Online'+RESET if service_ok else RED+'Offline (systemctl start ollama)'+RESET}")
    print(f"  • Physical Storage : {BOLD}{size_str}{RESET} consumed on disk | {disk_str}")
    print(f"  • Installed Models : {len(installed)} / {len(ALL_MODELS)} models ready\n")

    print(f"{BOLD}{'Model':<30} {'Size':<10} {'Status':<12} {'Specialization / Role'}{RESET}")
    print("-" * 92)

    for m in ALL_MODELS:
        size, desc = MODEL_SPECS.get(m, ("Unknown", "Specialized local coprocessor engine"))
        is_ready = m in installed or f"{m}:latest" in installed or m.replace(":latest", "") in installed
        status_tag = f"{GREEN}[✓ READY]{RESET}" if is_ready else f"{YELLOW}[MISSING]{RESET}"
        print(f"{m:<30} {size:<10} {status_tag:<21} {desc}")

    print("-" * 92)
    ready_count = sum(1 for m in ALL_MODELS if m in installed or f"{m}:latest" in installed)
    print(f"Summary: {BOLD}{ready_count}/{len(ALL_MODELS)}{RESET} models installed and active.")


def main():
    parser = argparse.ArgumentParser(
        description="Installer, synchronizer, and status inspector for the local Ollama language model fleet."
    )
    parser.add_argument("--status", action="store_true", help="Display installed models, physical storage usage, and hardware profile.")
    parser.add_argument("--tier", choices=list(FLEET_TIERS.keys()), help="Install models belonging to a specific functional tier.")
    parser.add_argument("--all", action="store_true", help="Download and synchronize all 23 local models.")
    parser.add_argument("--model", type=str, help="Download a specific individual model by name.")
    parser.add_argument("--build-custom", action="store_true", help="Build custom Modelfiles (e.g. blender-architect:latest).")
    parser.add_argument("--setup-symlinks", action="store_true", help="Ensure local-coprocessor and setup-local-model-fleet are symlinked in ~/.local/bin.")
    parser.add_argument("--test", action="store_true", help="Execute rapid test inferences across code, math, and translation models.")

    args = parser.parse_args()

    # Default action if no flags provided is --status
    if not any([args.status, args.tier, args.all, args.model, args.build_custom, args.setup_symlinks, args.test]):
        print_status()
        install_symlinks()
        return

    if args.setup_symlinks:
        install_symlinks()

    if args.status:
        print_status()

    if args.build_custom:
        build_custom_modelfiles()

    if args.model:
        pull_model(args.model)

    if args.tier:
        tier_info = FLEET_TIERS[args.tier]
        print(f"\n{BOLD}{CYAN}=== Syncing Tier: {args.tier} ==={RESET}")
        print(f"{DIM}{tier_info['description']}{RESET}\n")
        installed = set(get_installed_models())
        for m in tier_info["models"]:
            if m == "blender-architect:latest":
                build_custom_modelfiles()
            elif m in installed or f"{m}:latest" in installed:
                print(f"{GREEN}[✓]{RESET} {BOLD}{m}{RESET} already installed.")
            else:
                pull_model(m)

    if args.all:
        print(f"\n{BOLD}{CYAN}=== Synchronizing Complete 23-Model Fleet ==={RESET}")
        installed = set(get_installed_models())
        for m in ALL_MODELS:
            if m == "blender-architect:latest":
                if m not in installed:
                    build_custom_modelfiles()
                else:
                    print(f"{GREEN}[✓]{RESET} {BOLD}{m}{RESET} already built.")
            elif m in installed or f"{m}:latest" in installed:
                print(f"{GREEN}[✓]{RESET} {BOLD}{m}{RESET} already installed.")
            else:
                pull_model(m)
        install_symlinks()
        print(f"\n{GREEN}[✓] Full fleet synchronization complete!{RESET}")
        print_status()

    if args.test:
        print(f"\n{BOLD}{CYAN}=== Verifying Local Model Coprocessor Inferences ==={RESET}")
        test_tasks = [
            ("code", "Write a 1-line Python lambda checking if an integer is a power of 2."),
            ("math", "What is the exact derivative of e^(-lambda * t) with respect to t?"),
            ("translate", "Translate 'Привет Сталкер' into English."),
        ]
        coprocessor_bin = REPO_ROOT / "config" / "skills" / "local-model-coprocessor" / "scripts" / "local_model_coprocessor.py"
        for task, prompt in test_tasks:
            print(f"\n{CYAN}[→] Testing task '{task}'...{RESET}")
            t0 = time.time()
            try:
                res = subprocess.check_output(
                    [sys.executable, str(coprocessor_bin), "generate", "--task", task, "--prompt", prompt],
                    text=True,
                    timeout=20.0,
                    stderr=subprocess.DEVNULL,
                ).strip()
                elapsed = time.time() - t0
                print(f"{GREEN}[✓ PASS]{RESET} {BOLD}{task}{RESET} ({elapsed:.2f}s):\n  {res[:160]}...")
            except Exception as e:
                print(f"{RED}[✗ FAIL]{RESET} {task}: {e}")


if __name__ == "__main__":
    main()
