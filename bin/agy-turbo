#!/usr/bin/env bash
# Launch Antigravity CLI in high-speed Turbo mode
[ -t 1 ] && command -v agy-cheatsheet >/dev/null 2>&1 && agy-cheatsheet --banner
[ -t 1 ] && command -v agy-mic-button >/dev/null 2>&1 && agy-mic-button >/dev/null 2>&1 &
exec agy --model gemini-3.8-flash-low --effort low --dangerously-skip-permissions --mode auto "$@"
