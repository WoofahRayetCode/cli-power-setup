#!/usr/bin/env python3
import os
import sys
import time
import subprocess
from datetime import datetime

import glob
import json

CACHE_FILE = "/tmp/agy_quota_cache.txt"
LOCK_FILE = "/tmp/agy_quota_refresh.lock"
CACHE_TTL = 120  # 2 minutes

def get_token_savings():
    base_dir = os.path.expanduser("~/.gemini/antigravity-cli")
    presence_locks = glob.glob(f"{base_dir}/presence/*.lock")
    active_cid = None
    if presence_locks:
        latest_lock = max(presence_locks, key=os.path.getmtime)
        active_cid = os.path.basename(latest_lock).replace(".lock", "")

    transcript_path = None
    if active_cid:
        cand = f"{base_dir}/brain/{active_cid}/.system_generated/logs/transcript.jsonl"
        if os.path.exists(cand):
            transcript_path = cand

    if not transcript_path:
        transcripts = glob.glob(f"{base_dir}/brain/*/.system_generated/logs/transcript.jsonl")
        if transcripts:
            transcript_path = max(transcripts, key=os.path.getmtime)

    if not transcript_path or not os.path.exists(transcript_path):
        return ""

    cached_tokens = 0
    try:
        with open(transcript_path, "r") as f:
            for line in f:
                try:
                    row = json.loads(line)
                    cached_tokens += row.get("cache_read_tokens", 0)
                except Exception:
                    pass
    except Exception:
        return ""

    if cached_tokens <= 0:
        return ""

    if cached_tokens >= 1_000_000:
        val_str = f"{cached_tokens / 1_000_000:.1f}M"
    elif cached_tokens >= 1_000:
        val_str = f"{cached_tokens / 1_000:.1f}k"
    else:
        val_str = str(cached_tokens)

    return f"💾 Saved: {val_str} tok"

def refresh_now():
    try:
        res = subprocess.run(
            ["agy", "-p", "/usage"],
            capture_output=True,
            text=True,
            timeout=15
        )
        if res.returncode == 0 and res.stdout:
            data = {}
            for line in res.stdout.strip().splitlines():
                parts = line.split("\t")
                if len(parts) >= 3:
                    data[(parts[0].strip(), parts[1].strip())] = (parts[2].strip(), parts[3].strip() if len(parts) > 3 else "")

            g_5h, g_5h_reset = data.get(("Gemini Models", "Five Hour Limit Remaining"), ("--%", ""))
            g_wk, _ = data.get(("Gemini Models", "Weekly Limit Remaining"), ("--%", ""))

            reset_str = ""
            if "T" in g_5h_reset:
                try:
                    dt = datetime.fromisoformat(g_5h_reset.replace("Z", "+00:00")).astimezone()
                    reset_str = f" (reset {dt.strftime('%H:%M')})"
                except Exception:
                    pass

            formatted = f"⚡ Gemini: 5h: {g_5h}{reset_str} | Wk: {g_wk}"
            with open(CACHE_FILE, "w") as f:
                f.write(formatted)
            return formatted
    except Exception:
        pass
    finally:
        try:
            if os.path.exists(LOCK_FILE):
                os.remove(LOCK_FILE)
        except Exception:
            pass
    return None

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--refresh":
        refresh_now()
        return

    now = time.time()
    cached = None

    if os.path.exists(CACHE_FILE):
        try:
            mtime = os.path.getmtime(CACHE_FILE)
            with open(CACHE_FILE, "r") as f:
                cached = f.read().strip()
            if now - mtime > CACHE_TTL:
                # Spawn background refresh if lock not held
                if not os.path.exists(LOCK_FILE):
                    with open(LOCK_FILE, "w") as f:
                        f.write(str(os.getpid()))
                    subprocess.Popen(
                        [sys.executable, __file__, "--refresh"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL
                    )
        except Exception:
            pass

    saved_str = get_token_savings()
    suffix = f" | {saved_str}" if saved_str else ""

    if cached:
        print(f"{cached}{suffix}")
    else:
        # Generate initial cache
        res = refresh_now()
        base = res if res else "⚡ Gemini: [5h: --% | Wk: --%]"
        print(f"{base}{suffix}")

if __name__ == "__main__":
    main()
