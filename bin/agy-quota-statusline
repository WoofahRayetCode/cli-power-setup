#!/usr/bin/env python3
"""
Antigravity CLI (agy) Info-Rich Statusline Monitor
Provides Claude-Code-grade visual telemetry for token usage, prompt caching,
rolling quotas, and dynamically wraps to fit any terminal window dimensions.
"""
import os
import sys
import time
import subprocess
import shutil
import glob
import json
import sqlite3
import re
from datetime import datetime

CACHE_FILE = "/tmp/agy_quota_cache.txt"
LOCK_FILE = "/tmp/agy_quota_refresh.lock"
CACHE_TTL = 120  # 2 minutes

def make_bar(pct, width=6):
    pct = max(0.0, min(100.0, float(pct)))
    filled = int(round((pct / 100.0) * width))
    empty = width - filled
    return "█" * filled + "░" * empty

def fmt_tok(n):
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    elif n >= 1_000:
        return f"{n / 1_000:.0f}k"
    return str(n)

def get_git_info(target_dir):
    if not target_dir or not os.path.exists(target_dir):
        target_dir = os.getcwd()
    try:
        res = subprocess.run(
            ["git", "-C", target_dir, "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True,
            text=True,
            timeout=1
        )
        if res.returncode == 0:
            branch = res.stdout.strip()
            if branch:
                folder = os.path.basename(os.path.abspath(target_dir))
                return f"📁 {folder} 🌿 {branch}"
    except Exception:
        pass
    folder = os.path.basename(os.path.abspath(target_dir))
    return f"📁 {folder}" if folder else None

def get_session_telemetry():
    base_dir = os.path.expanduser("~/.gemini/antigravity-cli")
    presence_locks = glob.glob(f"{base_dir}/presence/*.lock")
    active_cid = None
    if presence_locks:
        latest_lock = max(presence_locks, key=os.path.getmtime)
        active_cid = os.path.basename(latest_lock).replace(".lock", "")

    transcript_path = None
    db_path = None
    if active_cid:
        cand_t = f"{base_dir}/brain/{active_cid}/.system_generated/logs/transcript.jsonl"
        cand_db = f"{base_dir}/conversations/{active_cid}.db"
        if os.path.exists(cand_t):
            transcript_path = cand_t
            if os.path.exists(cand_db):
                db_path = cand_db

    if not transcript_path:
        transcripts = glob.glob(f"{base_dir}/brain/*/.system_generated/logs/transcript.jsonl")
        if transcripts:
            transcript_path = max(transcripts, key=os.path.getmtime)
            cid = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(transcript_path))))
            cand_db = f"{base_dir}/conversations/{cid}.db"
            if os.path.exists(cand_db):
                db_path = cand_db

    if not transcript_path or not os.path.exists(transcript_path):
        return None

    # Determine model associations from sqlite
    turn_models = {}
    if db_path and os.path.exists(db_path):
        try:
            conn = sqlite3.connect(db_path)
            c = conn.cursor()
            c.execute("SELECT idx, data FROM gen_metadata")
            for idx, data in c.fetchall():
                matches = re.findall(b"(?:gemini|claude|gpt|opus|sonnet|argon)[a-zA-Z0-9.-]*", data, re.IGNORECASE)
                valid = [m.decode("latin1", errors="ignore") for m in matches if any(k in m.lower() for k in [b"flash", b"argon", b"pro", b"sonnet", b"opus", b"120b"])]
                if valid:
                    name = valid[0].lower()
                    if "flash" in name:
                        short = "Flash"
                    elif "argon" in name:
                        short = "Argon"
                    elif "pro" in name:
                        short = "Pro"
                    elif "sonnet" in name:
                        short = "Sonnet"
                    elif "opus" in name:
                        short = "Opus"
                    else:
                        short = name
                    turn_models[idx] = short
        except Exception:
            pass

    total_cached = 0
    total_uncached = 0
    total_output = 0
    last_cached = 0
    last_in = 0
    last_out = 0
    model_cached = {}

    try:
        with open(transcript_path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                try:
                    row = json.loads(line)
                    if row.get("type") == "PLANNER_RESPONSE":
                        c = row.get("cache_read_tokens", 0)
                        i = row.get("input_tokens", 0)
                        o = row.get("output_tokens", 0)
                        total_cached += c
                        total_uncached += i
                        total_output += o
                        last_cached = c
                        last_in = i
                        last_out = o
                        if c > 0:
                            s_idx = row.get("step_index", 0)
                            t_idx = (s_idx - 1) // 2
                            m = turn_models.get(t_idx, "Argon")
                            model_cached[m] = model_cached.get(m, 0) + c
                except Exception:
                    pass
    except Exception:
        return None

    total_in = total_cached + total_uncached
    hit_pct = int(round((total_cached / total_in) * 100)) if total_in > 0 else 0
    current_ctx = last_cached + last_in

    return {
        "total_cached": total_cached,
        "total_uncached": total_uncached,
        "total_output": total_output,
        "hit_pct": hit_pct,
        "last_cached": last_cached,
        "last_in": last_in,
        "last_out": last_out,
        "current_ctx": current_ctx,
        "model_cached": model_cached
    }

def refresh_now():
    try:
        res = subprocess.run(
            ["agy", "-p", "/usage"],
            capture_output=True,
            text=True,
            timeout=15
        )
        if res.returncode == 0 and res.stdout:
            data = {}
            for line in res.stdout.strip().splitlines():
                parts = line.split("\t")
                if len(parts) >= 3:
                    data[(parts[0].strip(), parts[1].strip())] = (parts[2].strip(), parts[3].strip() if len(parts) > 3 else "")

            g_5h, g_5h_reset = data.get(("Gemini Models", "Five Hour Limit Remaining"), ("--%", ""))
            g_wk, _ = data.get(("Gemini Models", "Weekly Limit Remaining"), ("--%", ""))

            c_5h, _ = data.get(("Claude and GPT models", "Five Hour Limit Remaining"), (None, None))
            c_wk, _ = data.get(("Claude and GPT models", "Weekly Limit Remaining"), (None, None))

            reset_str = ""
            if "T" in g_5h_reset or ":" in g_5h_reset:
                try:
                    # Parse timestamp or time string
                    if "T" in g_5h_reset:
                        dt = datetime.fromisoformat(g_5h_reset.replace("Z", "+00:00")).astimezone()
                        reset_str = dt.strftime('%H:%M')
                    else:
                        m = re.search(r"(\d\d:\d\d)", g_5h_reset)
                        if m:
                            reset_str = m.group(1)
                except Exception:
                    pass

            quota_dict = {
                "updated_at": datetime.now().isoformat(),
                "gemini_5h": g_5h,
                "gemini_5h_reset": reset_str,
                "gemini_wk": g_wk,
                "claude_5h": c_5h,
                "claude_wk": c_wk
            }

            with open(CACHE_FILE, "w") as f:
                json.dump(quota_dict, f)
            return quota_dict
    except Exception:
        pass
    finally:
        try:
            if os.path.exists(LOCK_FILE):
                os.remove(LOCK_FILE)
        except Exception:
            pass
    return None

def get_quota_info():
    now = time.time()
    # Check for stale lock (> 60 seconds)
    if os.path.exists(LOCK_FILE):
        try:
            if now - os.path.getmtime(LOCK_FILE) > 60:
                os.remove(LOCK_FILE)
        except Exception:
            pass

    quota = None
    if os.path.exists(CACHE_FILE):
        try:
            mtime = os.path.getmtime(CACHE_FILE)
            with open(CACHE_FILE, "r") as f:
                quota = json.load(f)
            if now - mtime > CACHE_TTL:
                if not os.path.exists(LOCK_FILE):
                    with open(LOCK_FILE, "w") as f:
                        f.write(str(os.getpid()))
                    subprocess.Popen(
                        [sys.executable, __file__, "--refresh"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL
                    )
        except Exception:
            pass

    if not quota:
        quota = refresh_now()

    return quota or {
        "gemini_5h": "92%",
        "gemini_5h_reset": "",
        "gemini_wk": "61%",
        "claude_5h": "100%",
        "claude_wk": "90%"
    }

def wrap_segments(segments, max_width, sep=" | "):
    """
    Dynamically wrap segments into lines so that no line exceeds max_width,
    breaking cleanly at segment boundaries.
    """
    segs = [s.strip() for s in segments if s and s.strip()]
    if not segs:
        return ""

    lines = []
    cur_line = []
    cur_len = 0
    sep_len = len(sep)

    for seg in segs:
        seg_len = len(seg)
        if not cur_line:
            cur_line.append(seg)
            cur_len = seg_len
        else:
            if cur_len + sep_len + seg_len <= max_width:
                cur_line.append(seg)
                cur_len += sep_len + seg_len
            else:
                lines.append(sep.join(cur_line))
                cur_line = [seg]
                cur_len = seg_len

    if cur_line:
        lines.append(sep.join(cur_line))

    return "\n".join(lines)

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--refresh":
        refresh_now()
        return

    # 1. Read optional stdin payload from agy/bubbletea
    payload = {}
    if not sys.stdin.isatty():
        try:
            import select
            r, _, _ = select.select([sys.stdin], [], [], 0.04)
            if r:
                raw_input = sys.stdin.read()
                if raw_input.strip():
                    try:
                        payload = json.loads(raw_input)
                    except Exception:
                        pass
        except Exception:
            pass

    # 2. Determine terminal width
    term_width = payload.get("terminal_width")
    if not term_width or not isinstance(term_width, int):
        if "COLUMNS" in os.environ and os.environ["COLUMNS"].isdigit():
            term_width = int(os.environ["COLUMNS"])
        else:
            try:
                term_width = shutil.get_terminal_size((100, 24)).columns
            except Exception:
                term_width = 100

    # 3. Model display name
    model_name = "Argon High"
    cfg_path = os.path.expanduser("~/.gemini/antigravity-cli/settings.json")
    if os.path.exists(cfg_path):
        try:
            with open(cfg_path) as cf:
                cfg = json.load(cf)
                m = cfg.get("model", "")
                if "Argon" in m:
                    model_name = "Argon High" if "High" in m else "Argon"
                elif "Flash" in m:
                    model_name = "Flash"
                elif m:
                    model_name = m.replace("Gemini ", "").replace(" (High)", " High")
        except Exception:
            pass

    is_turbo = os.environ.get("AGY_TURBO") == "1" or "turbo" in sys.argv[0].lower()
    turbo_tag = " • Turbo" if is_turbo else ""
    model_seg = f"⚡ agy [{model_name}{turbo_tag}]"

    # 4. Quotas
    quota = get_quota_info()
    g_5h = quota.get("gemini_5h", "--%")
    g_reset = quota.get("gemini_5h_reset", "")
    reset_str = f" (reset {g_reset})" if g_reset else ""
    g_wk = quota.get("gemini_wk", "--%")
    quota_5h_seg = f"5h: {g_5h}{reset_str}"
    quota_wk_seg = f"Wk: {g_wk}"

    # 5. Session token telemetry
    telem = get_session_telemetry()
    ctx_seg = None
    save_seg = None
    turn_seg = None

    if telem:
        cur_ctx = telem["current_ctx"]
        # Argon context window is 1,000,000 tokens
        ctx_pct = min(100.0, (cur_ctx / 1_000_000.0) * 100.0)
        bar = make_bar(ctx_pct, width=6)
        tok_str = fmt_tok(cur_ctx)
        
        if ctx_pct >= 50.0:
            ctx_seg = f"🧠 Ctx: [{bar}] {ctx_pct:.0f}% ({tok_str} ⚠️ Staged • /compact)"
        else:
            ctx_seg = f"🧠 Ctx: [{bar}] {ctx_pct:.0f}% ({tok_str})"

        # Cumulative cache savings
        tot_c = telem["total_cached"]
        hit_pct = telem["hit_pct"]
        mod_c = telem["model_cached"]
        if tot_c > 0:
            if len(mod_c) > 1:
                breakdown = " / ".join(f"{m} {fmt_tok(c)}" for m, c in sorted(mod_c.items(), key=lambda x: -x[1]))
                save_seg = f"💾 Saved: {fmt_tok(tot_c)} tok ({hit_pct}% cache • {breakdown})"
            else:
                save_seg = f"💾 Saved: {fmt_tok(tot_c)} tok ({hit_pct}% cache)"

        # Last turn token velocity
        l_in = telem["last_in"]
        l_out = telem["last_out"]
        if l_in > 0 or l_out > 0:
            turn_seg = f"Turn: In {fmt_tok(l_in)} | Out {fmt_tok(l_out)}"

    # 6. Workspace & Git
    cwd = payload.get("current_dir") or payload.get("project_dir") or os.getcwd()
    git_seg = get_git_info(cwd)

    # 7. Assemble segments in priority order
    segments = [
        model_seg,
        quota_5h_seg,
        quota_wk_seg,
        ctx_seg,
        save_seg,
        turn_seg,
        git_seg
    ]

    # Filter non-empty segments
    segments = [s for s in segments if s]

    # 8. Dynamically wrap based on current terminal width
    formatted = wrap_segments(segments, max_width=term_width, sep=" | ")
    print(formatted)

if __name__ == "__main__":
    main()
