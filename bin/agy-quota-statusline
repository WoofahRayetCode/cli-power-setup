#!/usr/bin/env python3
"""
Antigravity CLI (agy) Info-Rich Statusline Monitor
Provides Claude-Code-grade visual telemetry for token usage, prompt caching,
rolling quotas, and dynamically wraps to fit any terminal window dimensions.
"""
import os
import sys
import time
import subprocess
import shutil
import glob
import json
import sqlite3
import re
import tempfile
from datetime import datetime
from pathlib import Path

_TMP = tempfile.gettempdir()
CACHE_FILE = os.path.join(_TMP, "agy_quota_cache.txt")
LOCK_FILE = os.path.join(_TMP, "agy_quota_refresh.lock")
CACHE_TTL = 120  # 2 minutes

def make_bar(pct, width=6):
    pct = max(0.0, min(100.0, float(pct)))
    filled = int(round((pct / 100.0) * width))
    empty = width - filled
    return "█" * filled + "░" * empty

def fmt_tok(n):
    if n >= 1_000_000_000:
        return f"{n / 1_000_000_000:.2f}B"
    elif n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    elif n >= 1_000:
        return f"{n / 1_000:.0f}k"
    return str(n)

def get_git_info(target_dir):
    if not target_dir or not os.path.exists(target_dir):
        target_dir = os.getcwd()
    try:
        res = subprocess.run(
            ["git", "-C", target_dir, "status", "--porcelain", "--branch"],
            capture_output=True,
            text=True,
            timeout=1.0
        )
        if res.returncode == 0 and res.stdout:
            lines = res.stdout.splitlines()
            header = lines[0] if lines else ""
            dirty_cnt = len(lines) - 1 if len(lines) > 1 else 0
            branch = "HEAD"
            m_br = re.match(r"^##\s+([^\.\s]+)", header)
            if m_br:
                branch = m_br.group(1)
            ahead = 0
            behind = 0
            m_ah = re.search(r"ahead\s+(\d+)", header)
            if m_ah:
                ahead = int(m_ah.group(1))
            m_bh = re.search(r"behind\s+(\d+)", header)
            if m_bh:
                behind = int(m_bh.group(1))
            badges = []
            if dirty_cnt > 0:
                badges.append(f"✏️{dirty_cnt}")
            if ahead > 0:
                badges.append(f"⬆️{ahead}")
            if behind > 0:
                badges.append(f"⬇️{behind}")
            badge_str = f" ({' '.join(badges)})" if badges else " (✓)"
            folder = os.path.basename(os.path.abspath(target_dir))
            return f"📁 {folder} 🌿 {branch}{badge_str}"
    except Exception:
        pass
    folder = os.path.basename(os.path.abspath(target_dir))
    return f"📁 {folder}" if folder else None

def get_session_telemetry():
    base_dir = os.path.expanduser("~/.gemini/antigravity-cli")
    presence_locks = glob.glob(f"{base_dir}/presence/*.lock")
    active_cid = None
    if presence_locks:
        latest_lock = max(presence_locks, key=os.path.getmtime)
        active_cid = os.path.basename(latest_lock).replace(".lock", "")

    transcript_path = None
    db_path = None
    if active_cid:
        cand_t = f"{base_dir}/brain/{active_cid}/.system_generated/logs/transcript.jsonl"
        cand_db = f"{base_dir}/conversations/{active_cid}.db"
        if os.path.exists(cand_t):
            transcript_path = cand_t
            if os.path.exists(cand_db):
                db_path = cand_db

    if not transcript_path:
        transcripts = glob.glob(f"{base_dir}/brain/*/.system_generated/logs/transcript.jsonl")
        if transcripts:
            transcript_path = max(transcripts, key=os.path.getmtime)
            cid = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(transcript_path))))
            cand_db = f"{base_dir}/conversations/{cid}.db"
            if os.path.exists(cand_db):
                db_path = cand_db

    if not transcript_path or not os.path.exists(transcript_path):
        return None

    # Determine model associations from sqlite
    turn_models = {}
    if db_path and os.path.exists(db_path):
        try:
            conn = sqlite3.connect(db_path)
            c = conn.cursor()
            c.execute("SELECT idx, data FROM gen_metadata")
            for idx, data in c.fetchall():
                matches = re.findall(b"(?:gemini|claude|gpt|opus|sonnet|argon)[a-zA-Z0-9.-]*", data, re.IGNORECASE)
                valid = [m.decode("latin1", errors="ignore") for m in matches if any(k in m.lower() for k in [b"flash", b"argon", b"pro", b"sonnet", b"opus", b"120b"])]
                if valid:
                    name = valid[0].lower()
                    if "flash" in name:
                        short = "Flash"
                    elif "argon" in name:
                        short = "Argon"
                    elif "pro" in name:
                        short = "Pro"
                    elif "sonnet" in name:
                        short = "Sonnet"
                    elif "opus" in name:
                        short = "Opus"
                    else:
                        short = name
                    turn_models[idx] = short
        except Exception:
            pass

    total_cached = 0
    total_uncached = 0
    total_output = 0
    last_cached = 0
    last_in = 0
    last_out = 0
    model_cached = {}

    try:
        with open(transcript_path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                try:
                    row = json.loads(line)
                    if row.get("type") == "PLANNER_RESPONSE":
                        c = row.get("cache_read_tokens", 0)
                        i = row.get("input_tokens", 0)
                        o = row.get("output_tokens", 0)
                        total_cached += c
                        total_uncached += i
                        total_output += o
                        last_cached = c
                        last_in = i
                        last_out = o
                        if c > 0:
                            s_idx = row.get("step_index", 0)
                            t_idx = (s_idx - 1) // 2
                            m = turn_models.get(t_idx, "Argon")
                            model_cached[m] = model_cached.get(m, 0) + c
                except Exception:
                    pass
    except Exception:
        return None

    total_in = total_cached + total_uncached
    hit_pct = int(round((total_cached / total_in) * 100)) if total_in > 0 else 0
    current_ctx = last_cached + last_in

    return {
        "total_cached": total_cached,
        "total_uncached": total_uncached,
        "total_output": total_output,
        "hit_pct": hit_pct,
        "last_cached": last_cached,
        "last_in": last_in,
        "last_out": last_out,
        "current_ctx": current_ctx,
        "model_cached": model_cached
    }

def refresh_now():
    try:
        res = subprocess.run(
            ["agy", "-p", "/usage"],
            capture_output=True,
            text=True,
            timeout=15
        )
        if res.returncode == 0 and res.stdout:
            data = {}
            for line in res.stdout.strip().splitlines():
                parts = re.split(r"\s{2,}|\t", line.strip())
                if len(parts) >= 3:
                    data[(parts[0].strip(), parts[1].strip())] = (parts[2].strip(), parts[3].strip() if len(parts) > 3 else "")

            g_5h, g_5h_reset = data.get(("Gemini Models", "Five Hour Limit Remaining"), ("--%", ""))
            g_wk, g_wk_reset = data.get(("Gemini Models", "Weekly Limit Remaining"), ("--%", ""))

            c_5h, _ = data.get(("Claude and GPT models", "Five Hour Limit Remaining"), (None, None))
            c_wk, _ = data.get(("Claude and GPT models", "Weekly Limit Remaining"), (None, None))

            reset_str = ""
            if "T" in g_5h_reset or ":" in g_5h_reset:
                try:
                    # Parse timestamp or time string
                    if "T" in g_5h_reset:
                        dt = datetime.fromisoformat(g_5h_reset.replace("Z", "+00:00")).astimezone()
                        reset_str = dt.strftime('%H:%M')
                    else:
                        m = re.search(r"(\d\d:\d\d)", g_5h_reset)
                        if m:
                            reset_str = m.group(1)
                except Exception:
                    pass

            wk_reset_str = ""
            if g_wk_reset:
                try:
                    if "T" in g_wk_reset:
                        dt_wk = datetime.fromisoformat(g_wk_reset.replace("Z", "+00:00")).astimezone()
                        wk_reset_str = dt_wk.strftime("%a %m/%d %H:%M")
                    else:
                        m_wk = re.search(r"(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2})", g_wk_reset)
                        if m_wk:
                            dt_wk = datetime.strptime(f"{m_wk.group(1)} {m_wk.group(2)}", "%Y-%m-%d %H:%M")
                            wk_reset_str = dt_wk.strftime("%a %m/%d %H:%M")
                        else:
                            wk_reset_str = g_wk_reset.strip()
                except Exception:
                    pass

            quota_dict = {
                "updated_at": datetime.now().isoformat(),
                "gemini_5h": g_5h,
                "gemini_5h_reset": reset_str,
                "gemini_wk": g_wk,
                "gemini_wk_reset": wk_reset_str,
                "claude_5h": c_5h,
                "claude_wk": c_wk
            }

            with open(CACHE_FILE, "w") as f:
                json.dump(quota_dict, f)

            # Auto-aggregate live token_ledger.json across all CLI & IDE brains
            try:
                t_files = (
                    glob.glob(os.path.expanduser("~/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript.jsonl"))
                    + glob.glob(os.path.expanduser("~/.gemini/antigravity/brain/*/.system_generated/logs/transcript.jsonl"))
                )
                tot_c = tot_i = tot_o = tot_t = 0
                for tf in t_files:
                    with open(tf, "r", encoding="utf-8", errors="ignore") as f_tr:
                        for ln in f_tr:
                            if '"PLANNER_RESPONSE"' in ln:
                                r = json.loads(ln)
                                if r.get("type") == "PLANNER_RESPONSE":
                                    tot_t += 1
                                    tot_c += r.get("cache_read_tokens", 0)
                                    tot_i += r.get("input_tokens", 0)
                                    tot_o += r.get("output_tokens", 0)
                if tot_c > 0:
                    hit_rate = round(tot_c / (tot_c + tot_i) * 100.0, 2) if (tot_c + tot_i) > 0 else 0.0
                    ledger_p = Path.home() / ".cli_power_setup" / "token_ledger.json"
                    if ledger_p.exists():
                        ld = json.loads(ledger_p.read_text(encoding="utf-8"))
                    else:
                        ld = {}
                    ls = ld.get("lifetime_summary", {})
                    ls["total_cached_tokens_saved"] = max(ls.get("total_cached_tokens_saved", 0), tot_c)
                    ls["total_sessions_tracked"] = max(ls.get("total_sessions_tracked", 0), len(t_files))
                    ls["cache_hit_rate_pct"] = hit_rate
                    ls["total_uncached_input_tokens"] = max(ls.get("total_uncached_input_tokens", 0), tot_i)
                    ls["total_output_tokens"] = max(ls.get("total_output_tokens", 0), tot_o)
                    ls["total_turns_executed"] = max(ls.get("total_turns_executed", 0), tot_t)
                    ls["last_updated"] = datetime.now().isoformat()
                    ld["lifetime_summary"] = ls
                    ledger_p.parent.mkdir(parents=True, exist_ok=True)
                    ledger_p.write_text(json.dumps(ld, indent=2), encoding="utf-8")
            except Exception:
                pass

            return quota_dict
    except Exception:
        pass
    finally:
        try:
            if os.path.exists(LOCK_FILE):
                os.remove(LOCK_FILE)
        except Exception:
            pass
    return None

def get_quota_info():
    now = time.time()
    # Check for stale lock (> 60 seconds)
    if os.path.exists(LOCK_FILE):
        try:
            if now - os.path.getmtime(LOCK_FILE) > 60:
                os.remove(LOCK_FILE)
        except Exception:
            pass

    quota = None
    if os.path.exists(CACHE_FILE):
        try:
            mtime = os.path.getmtime(CACHE_FILE)
            with open(CACHE_FILE, "r") as f:
                quota = json.load(f)
            if now - mtime > CACHE_TTL:
                if not os.path.exists(LOCK_FILE):
                    with open(LOCK_FILE, "w") as f:
                        f.write(str(os.getpid()))
                    subprocess.Popen(
                        [sys.executable, __file__, "--refresh"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL
                    )
        except Exception:
            pass

    if not quota:
        quota = refresh_now()

    return quota or {
        "gemini_5h": "92%",
        "gemini_5h_reset": "",
        "gemini_wk": "61%",
        "claude_5h": "100%",
        "claude_wk": "90%"
    }

def wrap_segments(segments, max_width, sep=" | "):
    """
    Dynamically wrap segments into lines so that no line exceeds max_width,
    breaking cleanly at segment boundaries.
    """
    segs = [s.strip() for s in segments if s and s.strip()]
    if not segs:
        return ""

    lines = []
    cur_line = []
    cur_len = 0
    sep_len = len(sep)

    for seg in segs:
        seg_len = len(seg)
        if not cur_line:
            cur_line.append(seg)
            cur_len = seg_len
        else:
            if cur_len + sep_len + seg_len <= max_width:
                cur_line.append(seg)
                cur_len += sep_len + seg_len
            else:
                lines.append(sep.join(cur_line))
                cur_line = [seg]
                cur_len = seg_len

    if cur_line:
        lines.append(sep.join(cur_line))

    return "\n".join(lines)

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--refresh":
        refresh_now()
        return

    # 1. Read optional stdin payload from agy/bubbletea
    payload = {}
    if not sys.stdin.isatty():
        try:
            import select
            r, _, _ = select.select([sys.stdin], [], [], 0.04)
            if r:
                raw_input = sys.stdin.read()
                if raw_input.strip():
                    try:
                        payload = json.loads(raw_input)
                    except Exception:
                        pass
        except Exception:
            pass

    # 2. Determine terminal width
    term_width = payload.get("terminal_width")
    if not term_width or not isinstance(term_width, int):
        if "COLUMNS" in os.environ and os.environ["COLUMNS"].isdigit():
            term_width = int(os.environ["COLUMNS"])
        else:
            try:
                term_width = shutil.get_terminal_size((100, 24)).columns
            except Exception:
                term_width = 100

    # 3. Model display name
    model_name = "Argon High"
    cfg_path = os.path.expanduser("~/.gemini/antigravity-cli/settings.json")
    if os.path.exists(cfg_path):
        try:
            with open(cfg_path) as cf:
                cfg = json.load(cf)
                m = cfg.get("model", "")
                if "Argon" in m:
                    model_name = "Argon High" if "High" in m else "Argon"
                elif "Flash" in m:
                    model_name = "Flash"
                elif m:
                    model_name = m.replace("Gemini ", "").replace(" (High)", " High")
        except Exception:
            pass

    is_turbo = os.environ.get("AGY_TURBO") == "1" or "turbo" in sys.argv[0].lower()
    turbo_tag = " • Turbo" if is_turbo else ""
    model_seg = f"⚡ agy [{model_name}{turbo_tag}]"

    # 4. Quotas
    quota = get_quota_info()
    g_5h = quota.get("gemini_5h", "--%")
    g_reset = quota.get("gemini_5h_reset", "")
    reset_str = f" (reset {g_reset})" if g_reset else ""
    g_wk = quota.get("gemini_wk", "--%")
    g_wk_reset = quota.get("gemini_wk_reset", "")
    wk_reset_str = f" (reset {g_wk_reset})" if g_wk_reset else ""
    quota_5h_seg = f"5h: {g_5h}{reset_str}"
    quota_wk_seg = f"Wk: {g_wk}{wk_reset_str}"

    # 5. Session token telemetry
    telem = get_session_telemetry()
    ctx_seg = None
    save_seg = None
    turn_seg = None

    if telem:
        cur_ctx = telem["current_ctx"]
        # Argon context window is 1,000,000 tokens
        ctx_pct = min(100.0, (cur_ctx / 1_000_000.0) * 100.0)
        bar = make_bar(ctx_pct, width=6)
        tok_str = fmt_tok(cur_ctx)
        
        if cur_ctx >= 250_000:
            ctx_seg = f"🧠 Ctx: [{bar}] {ctx_pct:.0f}% ({tok_str} ⚠️ Gate 250k • /compact)"
        else:
            rem_gate = fmt_tok(250_000 - cur_ctx)
            ctx_seg = f"🧠 Ctx: [{bar}] {ctx_pct:.0f}% ({tok_str} • 🧹{rem_gate} to gate)"

        # Cumulative cache savings (Active Session)
        tot_c = telem["total_cached"]
        hit_pct = telem["hit_pct"]
        mod_c = telem["model_cached"]
        if tot_c > 0:
            if len(mod_c) > 1:
                breakdown = " / ".join(f"{m} {fmt_tok(c)}" for m, c in sorted(mod_c.items(), key=lambda x: -x[1]))
                save_seg = f"💾 Session: {fmt_tok(tot_c)} tok ({hit_pct}% cache • {breakdown})"
            else:
                save_seg = f"💾 Session: {fmt_tok(tot_c)} tok ({hit_pct}% cache)"

        # Last turn token velocity
        l_in = telem["last_in"]
        l_out = telem["last_out"]
        if l_in > 0 or l_out > 0:
            turn_seg = f"Turn: In {fmt_tok(l_in)} | Out {fmt_tok(l_out)}"

    # 6. Global Lifetime Token Ledger (Cache + Local LLM Fleet Savings)
    global_saved_seg = None
    ledger_path = os.path.expanduser("~/.cli_power_setup/token_ledger.json")
    if os.path.exists(ledger_path):
        try:
            with open(ledger_path, "r") as lf:
                ld = json.load(lf)
                ls = ld.get("lifetime_summary", {})
                lt_tok = ls.get("total_cached_tokens_saved", 0)
                lt_hit = ls.get("cache_hit_rate_pct", 0)
                lls = ld.get("local_llm_savings", {})
                loc_saved = lls.get("total_cloud_tokens_saved", 0)
                if lt_tok > 0:
                    loc_tag = f" • 🤖Local: {fmt_tok(loc_saved)}" if loc_saved > 0 else ""
                    global_saved_seg = f"🌐 Global Saved: {fmt_tok(lt_tok)} ({lt_hit:.1f}% cache{loc_tag})"
        except Exception:
            pass

    # 7. Workspace, Git, Mic Pill & Dynamic Bottom-of-Statusline Cheat Sheet
    cwd = payload.get("current_dir") or payload.get("project_dir") or os.getcwd()
    git_seg = get_git_info(cwd)

    # Check & auto-ensure Clickable Floating Mic Button (`agy-mic-button`) is active
    mic_seg = "🎙️ Mic: Ready"
    try:
        tmp_dir = Path(tempfile.gettempdir())
        mic_pid_file = tmp_dir / "agy_mic_button.pid"
        mic_state_file = tmp_dir / "agy_mic_state.json"
        mic_state = {}
        if mic_state_file.is_file():
            mic_state = json.loads(mic_state_file.read_text(encoding="utf-8"))
        mic_running = False
        if mic_pid_file.is_file():
            try:
                os.kill(int(mic_pid_file.read_text(encoding="utf-8").strip()), 0)
                mic_running = True
            except Exception:
                pass
        if not mic_running and not mic_state.get("closed_by_user") and shutil.which("agy-mic-button"):
            subprocess.Popen(
                ["agy-mic-button"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            mic_running = True
        if mic_state.get("recording"):
            mic_seg = "🔴 MIC LIVE (Click Pill to Stop)"
        elif mic_running:
            pin_tag = "•📌" if mic_state.get("pinned") else ""
            auto_tag = "•Auto" if mic_state.get("auto_send") else ""
            mic_seg = f"🎙️ Mic{pin_tag}{auto_tag}"
        else:
            mic_seg = ""
    except Exception:
        pass

    cs_active_segs = []
    cs_fleet_segs = []
    try:
        res_cs = subprocess.run(
            ["agy-cheatsheet", "--statusline-bars", cwd],
            capture_output=True,
            text=True,
            timeout=0.8
        )
        if res_cs.returncode == 0 and res_cs.stdout.strip():
            cs_data = json.loads(res_cs.stdout.strip())
            cs_active_segs = cs_data.get("active_segments", [])
            cs_fleet_segs = cs_data.get("fleet_segments", [])
    except Exception:
        pass

    # 7b. Detect Real-Time Active Skills + Hardware/Swarm/VRAM/RAMDisk telemetry
    live_skills_segs = get_live_active_skills(cwd)
    hw_swarm_segs = get_hw_and_swarm_segments()

    # 8. Assemble telemetry segments in priority order
    segments = [
        model_seg,
        quota_5h_seg,
        quota_wk_seg,
        ctx_seg,
        save_seg,
        global_saved_seg,
        turn_seg,
        git_seg,
        mic_seg,
    ]
    segments = [s for s in segments if s]

    # 9. Dynamically wrap telemetry + Hardware/Swarm + Live Active Skills + Bottom Cheat Sheet
    lines = [wrap_segments(segments, max_width=term_width, sep=" | ")]
    if hw_swarm_segs:
        lines.append(wrap_segments(hw_swarm_segs, max_width=term_width, sep=" | "))
    if live_skills_segs:
        lines.append(wrap_segments(live_skills_segs, max_width=term_width, sep=" • "))
    if cs_active_segs:
        lines.append(wrap_segments(cs_active_segs, max_width=term_width, sep=" | "))
    if cs_fleet_segs:
        lines.append(wrap_segments(cs_fleet_segs, max_width=term_width, sep=" • "))

    print("\n".join(line for line in lines if line))


def get_hw_and_swarm_segments() -> list[str]:
    """
    Fast (<1ms cached, 4s TTL) hardware thermals, fan RPM, OMEN profile, Lid-Lock badge,
    RTX 5060 VRAM, /dev/shm RAM-disk usage, and active subagent/build process monitor.
    """
    cache_path = os.path.join(_TMP, "agy_hw_swarm_cache.json")
    now = time.time()
    try:
        if os.path.exists(cache_path) and (now - os.path.getmtime(cache_path)) < 4.0:
            return json.loads(Path(cache_path).read_text(encoding="utf-8")).get("segments", [])
    except Exception:
        pass

    # 1. CPU Temp & Fan RPM from /sys/class/hwmon (<0.5ms)
    cpu_temp = "--°C"
    fan_rpm = ""
    try:
        for hdir in glob.glob("/sys/class/hwmon/hwmon*"):
            name_f = os.path.join(hdir, "name")
            if not os.path.isfile(name_f):
                continue
            hname = Path(name_f).read_text(encoding="utf-8").strip()
            if hname in ("k10temp", "coretemp", "zenpower"):
                t_f = os.path.join(hdir, "temp1_input")
                if os.path.isfile(t_f):
                    val = int(Path(t_f).read_text(encoding="utf-8").strip()) // 1000
                    cpu_temp = f"{val}°C"
            elif hname in ("hp", "omen"):
                f_f = os.path.join(hdir, "fan1_input")
                if os.path.isfile(f_f):
                    rpm = int(Path(f_f).read_text(encoding="utf-8").strip())
                    if rpm > 0:
                        fan_rpm = f"•{rpm}rpm"
    except Exception:
        pass

    # 2. Power Profile & Clamshell Lid-Lock
    prof_badge = "⚖️Bal"
    try:
        pp_file = "/sys/firmware/acpi/platform_profile"
        if os.path.isfile(pp_file):
            pp = Path(pp_file).read_text(encoding="utf-8").strip().lower()
            if "perf" in pp:
                prof_badge = "⚡Perf"
            elif "low" in pp or "quiet" in pp or "power" in pp:
                prof_badge = "🌙Quiet"
    except Exception:
        pass

    lid_lock_str = ""
    inh_pid_file = os.path.expanduser("~/.cache/agy_lid_inhibit.pid")
    if os.path.isfile(inh_pid_file):
        try:
            os.kill(int(Path(inh_pid_file).read_text(encoding="utf-8").strip()), 0)
            lid_lock_str = " • 🔒Lid-Safe"
        except Exception:
            pass

    # 3. Dual GPU Telemetry: dGPU (NVIDIA RTX 5060) + iGPU (AMD Radeon 610M via sysfs)
    dgpu_str = "dGPU:--°C"
    vram_str = ""
    if shutil.which("nvidia-smi"):
        try:
            res = subprocess.run(
                [
                    "nvidia-smi",
                    "--query-gpu=temperature.gpu,utilization.gpu,memory.used,memory.total",
                    "--format=csv,noheader,nounits",
                ],
                capture_output=True,
                text=True,
                timeout=0.5,
            )
            if res.returncode == 0 and res.stdout.strip():
                parts = [p.strip() for p in res.stdout.strip().split(",")]
                if len(parts) >= 4:
                    dgpu_str = f"dGPU:{parts[0]}°C({parts[1]}%)"
                    used_g = float(parts[2]) / 1024.0
                    tot_g = float(parts[3]) / 1024.0
                    vram_str = f"dVRAM:{used_g:.1f}/{tot_g:.0f}G"
        except Exception:
            pass

    igpu_str = ""
    ivram_str = ""
    try:
        for cdev in glob.glob("/sys/class/drm/card[0-9]/device"):
            vf = os.path.join(cdev, "vendor")
            if os.path.isfile(vf) and Path(vf).read_text(encoding="utf-8").strip().lower() == "0x1002":
                busy_f = os.path.join(cdev, "gpu_busy_percent")
                busy = Path(busy_f).read_text(encoding="utf-8").strip() if os.path.isfile(busy_f) else "0"
                itmp = "--"
                for tf in glob.glob(os.path.join(cdev, "hwmon/hwmon*/temp1_input")):
                    itmp = str(int(Path(tf).read_text(encoding="utf-8").strip()) // 1000)
                    break
                igpu_str = f" iGPU:{itmp}°C({busy}%)"
                vu_f = os.path.join(cdev, "mem_info_vram_used")
                if os.path.isfile(vu_f):
                    vu_mb = int(Path(vu_f).read_text(encoding="utf-8").strip()) / (1024 * 1024)
                    ivram_str = f"iVRAM:{vu_mb:.0f}M"
                break
    except Exception:
        pass

    # 4. /dev/shm RAM-Disk usage
    shm_str = ""
    if os.path.exists("/dev/shm"):
        try:
            du = shutil.disk_usage("/dev/shm")
            used_mb = du.used / (1024 * 1024)
            tot_gb = du.total / (1024 ** 3)
            if used_mb >= 1024:
                shm_str = f"/dev/shm:{used_mb / 1024:.1f}/{tot_gb:.0f}G"
            else:
                shm_str = f"/dev/shm:{used_mb:.0f}M/{tot_gb:.0f}G"
        except Exception:
            pass

    # 5. Active Local Ollama Model (/api/ps + state file + per-model token savings) & Heavy Processes
    local_model_str = "🤖 Local: Standby"
    state_f = os.path.join(_TMP, "agy_local_model_state.json")
    last_state = {}
    if os.path.isfile(state_f):
        try:
            last_state = json.loads(Path(state_f).read_text(encoding="utf-8"))
        except Exception:
            pass

    lls = {}
    ledger_p = Path.home() / ".cli_power_setup" / "token_ledger.json"
    if ledger_p.exists():
        try:
            lls = json.loads(ledger_p.read_text(encoding="utf-8")).get("local_llm_savings", {})
        except Exception:
            pass

    last_m_name = last_state.get("model") or lls.get("last_model") or ""

    try:
        import urllib.request
        with urllib.request.urlopen("http://localhost:11434/api/ps", timeout=0.15) as resp:
            if resp.status == 200:
                ps_data = json.loads(resp.read().decode("utf-8"))
                loaded = ps_data.get("models", [])
                if loaded:
                    m_info = loaded[0]
                    m_name = m_info.get("name", "local").replace(":latest", "")
                    v_gb = m_info.get("size_vram", m_info.get("size", 0)) / (1024 ** 3)
                    is_running = last_state.get("active") and (now - last_state.get("ts", 0)) < 60
                    bolt = "⚡" if is_running else ""
                    local_model_str = f"🤖 Local: {bolt}{m_name}({v_gb:.1f}G)"
                elif last_m_name:
                    m_name = str(last_m_name).replace(":latest", "")
                    local_model_str = f"🤖 Local: Standby(last:{m_name})"
                else:
                    local_model_str = "🤖 Local: Standby(42)"
    except Exception:
        if last_m_name:
            m_name = str(last_m_name).replace(":latest", "")
            local_model_str = f"🤖 Local: {m_name}"

    tot_loc_saved = lls.get("total_cloud_tokens_saved", 0)
    if tot_loc_saved > 0:
        def _fmt_loc(v: int) -> str:
            if v >= 1_000_000:
                return f"{v / 1_000_000:.1f}M"
            if v >= 100_000:
                return f"{v / 1_000:.0f}k"
            if v >= 1_000:
                return f"{v / 1_000:.1f}k"
            return str(v)

        short_map = {
            "blender-architect": "blender-arch",
            "minicpm-v:8b": "minicpm-v",
            "deepseek-r1:8b": "r1:8b",
            "qwen2.5-coder:7b": "qwen7b",
            "qwen2.5-coder:1.5b": "qwen1.5b",
            "deepseek-coder:6.7b-instruct": "dscoder6.7b",
            "granite-code:8b": "granite8b",
            "starcoder2:7b": "starcoder7b",
            "codellama:7b-python": "codellama-py",
            "llama3.2:3b": "llama3.2",
            "llama3.1:8b": "llama3.1",
            "aya:8b": "aya",
            "sqlcoder:7b": "sqlcoder",
            "hermes3:8b": "hermes3",
            "mistral-nemo:12b": "nemo12b",
            "phi4:14b": "phi4",
            "mathstral:7b": "mathstral",
            "wizard-math:7b": "wizmath",
            "qwen2.5:7b": "qwen2.5-7b",
            "gemma2:9b": "gemma2",
            "moondream": "moondream",
            "bge-m3": "bge-m3",
            "nomic-embed-text": "nomic",
        }
        by_m = lls.get("by_model", {})
        sorted_m = sorted(by_m.items(), key=lambda x: -x[1].get("cloud_tokens_saved", 0))
        top_parts = []
        for mk, mv in sorted_m[:3]:
            ms = mv.get("cloud_tokens_saved", 0)
            if ms > 0:
                s_lbl = short_map.get(mk, mk.split(":")[0])
                top_parts.append(f"{s_lbl}:{_fmt_loc(ms)}")
        bk_str = f" [{'•'.join(top_parts)}]" if top_parts else ""
        local_model_str = f"{local_model_str} • 💰{_fmt_loc(tot_loc_saved)} saved{bk_str}"

    active_jobs = []
    try:
        ps_out = subprocess.check_output(["ps", "-eo", "comm"], text=True, timeout=0.4).lower().splitlines()
        pset = {p.strip() for p in ps_out}
        if "blender" in pset:
            active_jobs.append("🎨Blender")
        if pset & {"cmake", "ninja", "cc1plus", "cargo", "rustc"}:
            active_jobs.append("🔨Build")
        if pset & {"xrengine.exe", "wine64-preloader", "wineserver"}:
            active_jobs.append("🎮OGSR")
    except Exception:
        pass

    job_str = f"{local_model_str} • ⚙️{'+'.join(active_jobs)}" if active_jobs else local_model_str
    therm_seg = f"🌡️ CPU:{cpu_temp} {dgpu_str}{igpu_str} ({prof_badge}{fan_rpm}{lid_lock_str})"
    mem_parts = [p for p in (vram_str, ivram_str, shm_str) if p]
    mem_seg = f"🚀 {' • '.join(mem_parts)}" if mem_parts else ""

    segs = [s for s in (therm_seg, mem_seg, job_str) if s]
    try:
        Path(cache_path).write_text(json.dumps({"segments": segs}), encoding="utf-8")
    except Exception:
        pass
    return segs


CLI_TO_SKILL_MAP = {
    "agy-cheatsheet": "dynamic-repo-model-cheatsheet",
    "skill-optimize": "autonomous-skill-ecosystem-optimizer",
    "skill-evolve": "self-evolving-skill-synthesizer",
    "repo-auto-sync": "autonomous-git-repo-sync-governor",
    "laptop-perf": "laptop-performance-profile",
    "laptop_performance_controller": "laptop-performance-profile",
    "agy-mic-button": "voice-speech-audio-synthesis",
    "game-math-solver": "game-3d-linear-algebra-quaternions",
    "agy-context": "agy-context-telemetry",
    "agy-doctor": "agy-cli-doctor",
    "agy-init": "agy-codebase-init",
    "steam-mod-scanner": "game-modding",
    "silhouette-iou-profiler": "concept-art-sketch-to-3d-sculptor",
    "local-ast-compiler": "argon-ast-syntax-gate",
    "local-rag": "local-vector-rag-engine",
    "local-coprocessor": "local-model-coprocessor",
    "slice-reader": "selective-context-ingestor",
    "token-guard": "shell-output-token-guard",
    "skills-audit-update": "skills-updater-and-auditor",
    "blender": "blender-3d-engineering",
}


def get_live_active_skills(cwd: str) -> list[str]:
    """
    Detect the top 4 skills actively being used right now in real time (<5ms cached)
    by inspecting the tail of the most recently active transcript.jsonl + current workspace.
    """
    cache_path = os.path.join(_TMP, "agy_live_skills_cache.json")
    now = time.time()
    try:
        if os.path.exists(cache_path) and (now - os.path.getmtime(cache_path)) < 2.0:
            cached = json.loads(Path(cache_path).read_text(encoding="utf-8"))
            if cached.get("cwd") == cwd and cached.get("segments"):
                return cached["segments"]
    except Exception:
        pass

    skills_root = os.path.expanduser("~/.gemini/config/skills")
    valid_skills = set()
    if os.path.isdir(skills_root):
        try:
            valid_skills = {d for d in os.listdir(skills_root) if not d.startswith(".")}
        except Exception:
            pass

    found_skills: list[str] = []

    def add_skill(sname: str) -> None:
        if sname and sname in valid_skills and sname not in found_skills:
            found_skills.append(sname)

    # 1. Inspect the tail (last 40KB) of the most recently active transcript across CLI & IDE brains
    t_candidates = (
        glob.glob(os.path.expanduser("~/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript.jsonl"))
        + glob.glob(os.path.expanduser("~/.gemini/antigravity/brain/*/.system_generated/logs/transcript.jsonl"))
    )
    if t_candidates:
        latest_t = max(t_candidates, key=os.path.getmtime)
        try:
            fsize = os.path.getsize(latest_t)
            with open(latest_t, "rb") as bf:
                if fsize > 40960:
                    bf.seek(fsize - 40960)
                tail_text = bf.read().decode("utf-8", errors="ignore")
            tail_lines = tail_text.splitlines()[-14:]
            # Walk backwards from the newest step so the most recent skill is #1
            for line in reversed(tail_lines):
                # Check explicit /skills/<name>/ file paths first
                for m in re.findall(r"/skills/([a-z0-9][a-z0-9_-]+)/", line):
                    add_skill(m)
                # Check CLI binary invocations mapped to skills
                for cli_key, mapped_skill in CLI_TO_SKILL_MAP.items():
                    if cli_key in line:
                        add_skill(mapped_skill)
                # Check exact skill identifiers mentioned in recent steps
                for cand in re.findall(r"\b([a-z0-9]+(?:-[a-z0-9]+){1,6})\b", line):
                    if cand in valid_skills:
                        add_skill(cand)
                if len(found_skills) >= 5:
                    break
        except Exception:
            pass

    # 2. Enrich with workspace-specific domain skills based on active repo
    repo_low = os.path.basename(os.path.abspath(cwd)).lower()
    if "ogsr" in repo_low:
        for s in ("cpp-64bit-engine-port-sanitizer", "argon-dynamic-subagent-swarm", "game-modding"):
            add_skill(s)
    elif "zoneforge" in repo_low:
        for s in ("game-modding", "xray-lua-scripting", "game-audio-ogg-gsc-encoder"):
            add_skill(s)
    elif "omen" in repo_low:
        for s in ("linux-hardware-acpi", "rust-engineering", "laptop-performance-profile"):
            add_skill(s)
    elif "rea" in repo_low or "gta" in repo_low:
        for s in ("binary-re-workflows", "rea-mcp-obligation-ledger-orchestrator"):
            add_skill(s)
    else:
        for s in ("token-economy", "dynamic-repo-model-cheatsheet"):
            add_skill(s)

    top_skills = found_skills[:3]
    if not top_skills:
        return []

    segs = [f"🛠️ Skills [Live]: {top_skills[0]}"] + top_skills[1:]
    try:
        Path(cache_path).write_text(json.dumps({"cwd": cwd, "segments": segs}), encoding="utf-8")
    except Exception:
        pass
    return segs


if __name__ == "__main__":
    main()
