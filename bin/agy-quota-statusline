#!/usr/bin/env python3
import os
import sys
import time
import subprocess
from datetime import datetime

import glob
import json
import sqlite3
import re

CACHE_FILE = "/tmp/agy_quota_cache.txt"
LOCK_FILE = "/tmp/agy_quota_refresh.lock"
CACHE_TTL = 120  # 2 minutes

def get_token_savings():
    base_dir = os.path.expanduser("~/.gemini/antigravity-cli")
    presence_locks = glob.glob(f"{base_dir}/presence/*.lock")
    active_cid = None
    if presence_locks:
        latest_lock = max(presence_locks, key=os.path.getmtime)
        active_cid = os.path.basename(latest_lock).replace(".lock", "")

    transcript_path = None
    db_path = None
    if active_cid:
        cand_t = f"{base_dir}/brain/{active_cid}/.system_generated/logs/transcript.jsonl"
        cand_db = f"{base_dir}/conversations/{active_cid}.db"
        if os.path.exists(cand_t):
            transcript_path = cand_t
            if os.path.exists(cand_db):
                db_path = cand_db

    if not transcript_path:
        transcripts = glob.glob(f"{base_dir}/brain/*/.system_generated/logs/transcript.jsonl")
        if transcripts:
            transcript_path = max(transcripts, key=os.path.getmtime)
            cid = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(transcript_path))))
            cand_db = f"{base_dir}/conversations/{cid}.db"
            if os.path.exists(cand_db):
                db_path = cand_db

    if not transcript_path or not os.path.exists(transcript_path):
        return ""

    turn_models = {}
    if db_path and os.path.exists(db_path):
        try:
            conn = sqlite3.connect(db_path)
            c = conn.cursor()
            c.execute("SELECT idx, data FROM gen_metadata")
            for idx, data in c.fetchall():
                matches = re.findall(b"(?:gemini|claude|gpt|opus|sonnet|argon)[a-zA-Z0-9.-]*", data, re.IGNORECASE)
                valid = [m.decode("latin1") for m in matches if any(k in m.lower() for k in [b"flash", b"argon", b"pro", b"sonnet", b"opus", b"120b"])]
                if valid:
                    name = valid[0].lower()
                    if "flash" in name:
                        short = "Flash"
                    elif "argon" in name:
                        short = "Argon"
                    elif "pro" in name:
                        short = "Pro"
                    elif "sonnet" in name:
                        short = "Sonnet"
                    elif "opus" in name:
                        short = "Opus"
                    else:
                        short = name
                    turn_models[idx] = short
        except Exception:
            pass

    model_tokens = {}
    total_saved = 0
    try:
        with open(transcript_path, "r") as f:
            for line in f:
                try:
                    row = json.loads(line)
                    if row.get("type") == "PLANNER_RESPONSE":
                        tokens = row.get("cache_read_tokens", 0)
                        if tokens > 0:
                            total_saved += tokens
                            s_idx = row.get("step_index", 0)
                            t_idx = (s_idx - 1) // 2
                            m = turn_models.get(t_idx, "Flash")
                            model_tokens[m] = model_tokens.get(m, 0) + tokens
                except Exception:
                    pass
    except Exception:
        return ""

    if total_saved <= 0:
        return ""

    def fmt(n):
        if n >= 1_000_000:
            return f"{n / 1_000_000:.1f}M"
        elif n >= 1_000:
            return f"{n / 1_000:.1f}k"
        return str(n)

    if len(model_tokens) > 1:
        breakdown = " | ".join(f"{m}: {fmt(t)}" for m, t in sorted(model_tokens.items(), key=lambda x: -x[1]))
        return f"💾 Saved: {fmt(total_saved)} tok ({breakdown})"
    elif len(model_tokens) == 1:
        m = list(model_tokens.keys())[0]
        return f"💾 Saved: {fmt(total_saved)} tok ({m})"
    return f"💾 Saved: {fmt(total_saved)} tok"

def format_claude_statusline(payload):
    try:
        model_info = payload.get("model", {})
        model_name = model_info.get("display_name", "Claude") if isinstance(model_info, dict) else str(model_info)
        short_model = model_name.replace("Claude ", "").replace("Anthropic ", "")

        parts = [f"⚡ Claude [{short_model}]"]

        # Rate limits (5-hour and 7-day rolling quota windows)
        rate_limits = payload.get("rate_limits", {})
        five_h = rate_limits.get("five_hour", {})
        if five_h:
            used = five_h.get("used_percentage")
            resets_at = five_h.get("resets_at")
            if used is not None:
                rem = max(0, 100 - int(round(used)))
                reset_str = ""
                if resets_at:
                    try:
                        dt = datetime.fromtimestamp(resets_at).astimezone()
                        reset_str = f" (reset {dt.strftime('%H:%M')})"
                    except Exception:
                        pass
                parts.append(f"5h: {rem}%{reset_str}")

        seven_d = rate_limits.get("seven_day", {})
        if seven_d:
            used = seven_d.get("used_percentage")
            resets_at_wk = seven_d.get("resets_at")
            if used is not None:
                rem = max(0, 100 - int(round(used)))
                reset_str_wk = ""
                if resets_at_wk:
                    try:
                        dt_wk = datetime.fromtimestamp(resets_at_wk).astimezone()
                        now_dt = datetime.now().astimezone()
                        diff_sec = (dt_wk - now_dt).total_seconds()
                        if diff_sec > 0 and diff_sec < 86400:
                            mins = int(round(diff_sec / 60))
                            if mins < 60:
                                reset_str_wk = f" (reset in {mins}m)"
                            else:
                                reset_str_wk = f" (reset {dt_wk.strftime('%H:%M')})"
                        else:
                            reset_str_wk = f" (reset {dt_wk.strftime('%a %H:%M')})"
                    except Exception:
                        pass
                parts.append(f"Wk: {rem}%{reset_str_wk}")

        # Context window utilization
        ctx = payload.get("context_window", {})
        used_pct = ctx.get("used_percentage")
        if used_pct is not None:
            parts.append(f"🧠 Ctx: {float(used_pct):.0f}%")

        # Cost tracking
        cost_info = payload.get("cost", {})
        cost_usd = cost_info.get("total_cost_usd") if isinstance(cost_info, dict) else None
        if cost_usd is not None and cost_usd > 0:
            parts.append(f"💲 ${cost_usd:.2f}")

        return " | ".join(parts)
    except Exception:
        return None

def refresh_now():
    try:
        res = subprocess.run(
            ["agy", "-p", "/usage"],
            capture_output=True,
            text=True,
            timeout=15
        )
        if res.returncode == 0 and res.stdout:
            data = {}
            for line in res.stdout.strip().splitlines():
                parts = line.split("\t")
                if len(parts) >= 3:
                    data[(parts[0].strip(), parts[1].strip())] = (parts[2].strip(), parts[3].strip() if len(parts) > 3 else "")

            g_5h, g_5h_reset = data.get(("Gemini Models", "Five Hour Limit Remaining"), ("--%", ""))
            g_wk, _ = data.get(("Gemini Models", "Weekly Limit Remaining"), ("--%", ""))

            reset_str = ""
            if "T" in g_5h_reset:
                try:
                    dt = datetime.fromisoformat(g_5h_reset.replace("Z", "+00:00")).astimezone()
                    reset_str = f" (reset {dt.strftime('%H:%M')})"
                except Exception:
                    pass

            formatted = f"⚡ Gemini: 5h: {g_5h}{reset_str} | Wk: {g_wk}"
            with open(CACHE_FILE, "w") as f:
                f.write(formatted)
            try:
                def parse_pct(s):
                    m = re.search(r"(\d+)%", str(s))
                    return int(m.group(1)) if m else None
                with open("/tmp/agy_quota_state.json", "w") as jf:
                    json.dump({
                        "updated_at": datetime.now().isoformat(),
                        "five_hour_remaining": parse_pct(g_5h),
                        "five_hour_resets_at": reset_str.strip(" ()"),
                        "weekly_remaining": parse_pct(g_wk)
                    }, jf, indent=2)
            except Exception:
                pass
            return formatted
    except Exception:
        pass
    finally:
        try:
            if os.path.exists(LOCK_FILE):
                os.remove(LOCK_FILE)
        except Exception:
            pass
    return None

def main():
    # Check for Claude Code piped JSON payload via stdin
    if not sys.stdin.isatty():
        try:
            import select
            r, _, _ = select.select([sys.stdin], [], [], 0.04)
            if r:
                raw_input = sys.stdin.read()
                if raw_input.strip():
                    try:
                        payload = json.loads(raw_input)
                        if "model" in payload or "context_window" in payload:
                            output = format_claude_statusline(payload)
                            if output:
                                print(output)
                                return
                    except Exception:
                        pass
        except Exception:
            pass

    if len(sys.argv) > 1 and sys.argv[1] == "--refresh":
        refresh_now()
        return

    now = time.time()
    cached = None

    if os.path.exists(CACHE_FILE):
        try:
            mtime = os.path.getmtime(CACHE_FILE)
            with open(CACHE_FILE, "r") as f:
                cached = f.read().strip()
            if now - mtime > CACHE_TTL:
                # Spawn background refresh if lock not held
                if not os.path.exists(LOCK_FILE):
                    with open(LOCK_FILE, "w") as f:
                        f.write(str(os.getpid()))
                    subprocess.Popen(
                        [sys.executable, __file__, "--refresh"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL
                    )
        except Exception:
            pass

    saved_str = get_token_savings()
    suffix = f" | {saved_str}" if saved_str else ""

    if cached:
        print(f"{cached}{suffix}")
    else:
        # Generate initial cache
        res = refresh_now()
        base = res if res else "⚡ Gemini: [5h: --% | Wk: --%]"
        print(f"{base}{suffix}")

if __name__ == "__main__":
    main()
