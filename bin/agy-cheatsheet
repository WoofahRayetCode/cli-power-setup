#!/usr/bin/env python3
"""
agy-cheatsheet: Dynamic Repo-Aware Model & Reasoning Cheat Sheet for Antigravity (agy) & Claude Code.
Automatically scans ~/Documents/GitHub and the current working directory (uncommitted diffs, recent commits,
file extensions, and error states) to recommend the exact Model + Reasoning Effort + Hardware Offload.
Dynamically updates as you work on new repos or modify different file types.
"""

from __future__ import annotations
import argparse
