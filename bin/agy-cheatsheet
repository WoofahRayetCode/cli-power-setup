#!/usr/bin/env python3
"""
agy-cheatsheet: Dynamic Repo-Aware Model & Reasoning Cheat Sheet for Antigravity (agy) & Claude Code.
Automatically scans ~/Documents/GitHub and the current working directory (uncommitted diffs, recent commits,
file extensions, and error states) to recommend the exact Model + Reasoning Effort + Hardware Offload.
Dynamically updates as you work on new repos or modify different file types.
"""

from __future__ import annotations
import argparse
import json
import os
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
from pathlib import Path

def _resolve_github_root() -> Path:
    candidates = [
        Path.home() / "Documents" / "GitHub",
        Path.home() / "source" / "repos",
        Path("C:/GitHub"),
        Path("D:/GitHub"),
    ]
    for c in candidates:
        if c.exists():
            return c
    return candidates[0]

GITHUB_ROOT = _resolve_github_root()
CONFIG_STATE_PATH = GITHUB_ROOT / "cli-power-setup" / "config" / "repo_cheatsheet.json"
USER_STATE_PATH = Path.home() / ".cli_power_setup" / "repo_cheatsheet.json"
STATUSLINE_CACHE = Path(tempfile.gettempdir()) / "agy_cheatsheet_statusline.json"

# ANSI Colors
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_DIM = "\033[2m"
C_CYAN = "\033[36m"
C_GREEN = "\033[32m"
C_YELLOW = "\033[33m"
C_MAGENTA = "\033[35m"
C_BLUE = "\033[34m"
C_RED = "\033[31m"


def run_git(repo: Path, *args: str, timeout: float = 2.0) -> str:
    try:
        res = subprocess.run(
            ["git", "-C", str(repo), *args],
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
        return res.stdout.strip() if res.returncode == 0 else ""
    except Exception:
        return ""


def fmt_age(ts: float) -> str:
    if ts <= 0:
        return "never"
    diff = max(0, int(time.time() - ts))
    if diff < 60:
        return f"{diff}s ago"
    if diff < 3600:
        return f"{diff // 60}m ago"
    if diff < 86400:
        return f"{diff // 3600}h ago"
    days = diff // 86400
    if days < 30:
        return f"{days}d ago"
    return f"{days // 30}mo ago"


def classify_workload(
    repo_name: str,
    ext_counts: dict[str, int],
    dirty_exts: dict[str, int],
    recent_exts: list[str] | None = None,
    has_crash_or_retry: bool = False,
) -> dict[str, str]:
    """
    Determines the stack label, active work right now, and explicit model recommendations for:
    - Planning (📐 Plan)
    - Implementing (🔨 Implement)
    - General File Editing (✏️ Edit Files)
    along with Local Hardware Offload hints.
    """
    name_low = repo_name.lower()
    recent_set = set(recent_exts or [])
    active_exts = dirty_exts if sum(dirty_exts.values()) > 0 else ext_counts

    def has_ext(*exts: str) -> bool:
        return any(ext_counts.get(e, 0) > 0 for e in exts)

    def dirty_has(*exts: str) -> bool:
        return any(dirty_exts.get(e, 0) > 0 or e in recent_set for e in exts)

    # 1. S.T.A.L.K.E.R. X-Ray / OGSR 64-Bit C++ Engine & Merge Worktrees
    if "ogsr" in name_low or (has_ext(".cpp", ".h") and has_ext(".ps", ".vs", ".ltx")):
        stack = "C++20 / X-Ray 64b / DX11"
        edit_short = "Flash•Low (LTX/Diffs)"
        edit_full = "Flash • Low (LTX/XML/Copy-Patch Diffs)"
        hw = "RTX 5060 + 32-Thr /dev/shm"

        if "merge" in name_low:
            if dirty_has(".ogf", ".dm", ".blend", ".dds") and dirty_has(".py", ".cpp"):
                work_now = "3D/OGF & C++ Port"
                plan_short = "Argon•High (64b/3D)"
                impl_short = "Argon•Med(3D)/High(C++)"
            elif dirty_has(".ps", ".vs", ".hlsl", ".xr"):
                work_now = "DX11/RTX Shaders"
                plan_short = "Argon•High (RTX/Render)"
                impl_short = "Argon•High (HLSL/C++)"
            elif dirty_has(".ogg", ".wav"):
                work_now = "GSC Ogg Audio & Lua"
                plan_short = "Argon•Med (Audio Spec)"
                impl_short = "Flash•Low(Ogg)/Med(Lua)"
            elif dirty_has(".script", ".lua"):
                work_now = "X-Ray Lua & Playtest"
                plan_short = "Argon•High (Quest/Nav)"
                impl_short = "Argon•Med(Lua)/High(C++)"
            else:
                work_now = "64b C++ & Mod Merge"
                plan_short = "Argon•High (64b/Arch)"
                impl_short = "Argon•High(C++)+Flash"
            plan_full = "Argon • High (64b Engine, Crash & Port Plan)"
            impl_full = "Argon • High (C++/Shaders) │ Med (3D/Lua)"
            live_rec = "Argon•High+Flash"
            live_reason = f"{work_now} (Plan:High • Impl:High/Med • Edit:Flash)"
        else:
            work_now = "64b C++ Engine & DX11"
            plan_short = "Argon•High (64b Arch)"
            impl_short = "Argon•High (C++20/DX11)"
            plan_full = "Argon • High (64b Memory & DX11 Render Plan)"
            impl_full = "Argon • High (C++20 Engine, SIMD & Shaders)"
            live_rec = "Argon • High"
            live_reason = "Engine C++ / 64b safety"

    # 2. ZoneForge / S.T.A.L.K.E.R. Modding Suite
    elif "zoneforge" in name_low or has_ext(".ltx", ".script"):
        stack = "S.T.A.L.K.E.R. LTX/Lua/Py"
        work_now = "Lua/OGF Codecs" if dirty_has(".script", ".py") else "LTX/DDS Mod Assets"
        plan_short = "Argon•Med (Mod/Parser)"
        impl_short = "Argon•Med (Lua/Py/OGF)"
        edit_short = "Flash•Low (LTX/DDS/XML)"
        plan_full = "Argon • Med (Mod Architecture & Binary Formats)"
        impl_full = "Argon • Med (Python Codecs, Lua & OGF/XDB)"
        edit_full = "Flash • Low (LTX Configs, String XML & UI)"
        hw = "CUDA/NumPy 32-Thr + /dev/shm"
        live_rec = "Argon • Med" if dirty_has(".script", ".py") else "Flash • Low"
        live_reason = work_now

    # 3. Reverse Engineering / Binary Analysis (rea, GTA ASI fixes)
    elif name_low == "rea" or "gta" in name_low or has_ext(".asi"):
        stack = "Binary RE / Rust / TS / ASI"
        work_now = "Binary RE & ASI Hooks" if dirty_has(".rs", ".cpp", ".c", ".asi") else "RE MCP & Tooling"
        plan_short = "Argon•High (Decomp/RE)"
        impl_short = "Argon•High (Rust/C++)"
        edit_short = "Flash•Low (TS/INI/VDF)"
        plan_full = "Argon • High (Decompilation & Memory Hook Design)"
        impl_full = "Argon • High (Rust/C++ ASI Hooks & REA Ledger)"
        edit_full = "Flash • Low (TypeScript Schemas, INI & VDF)"
        hw = "REA MCP + 32-Thr Cargo"
        live_rec = "Argon • High" if dirty_has(".rs", ".cpp", ".c", ".asi") else "Argon • Med"
        live_reason = work_now

    # 4. Linux Kernel ACPI / Hardware Daemons (omen-acpi, omen-space)
    elif "omen" in name_low or (has_ext(".rs") and "acpi" in name_low):
        stack = "Linux Kernel / Rust / ACPI"
        work_now = "EC/ACPI & Thermals" if dirty_has(".rs", ".c", ".h") else "Systemd & Packaging"
        plan_short = "Argon•High (EC/Kernel)"
        impl_short = "Argon•High (Rust/DKMS)"
        edit_short = "Flash•Low (Systemd/UI)"
        plan_full = "Argon • High (ACPI DSDT/EC & Kernel Safety Plan)"
        impl_full = "Argon • High (Rust D-Bus Daemon & C DKMS Module)"
        edit_full = "Flash • Low (Systemd Units, PKGBUILD & UI Config)"
        hw = "CARGO_BUILD_JOBS=32"
        live_rec = "Argon • High" if dirty_has(".rs", ".c", ".h") else "Flash • Low"
        live_reason = work_now

    # 5. Godot 4 Game Projects (.gd, .tscn, .glb)
    elif has_ext(".gd", ".godot", ".import"):
        stack = "Godot 4 (GDScript / 3D GLB)"
        work_now = "3D GLB & Shaders" if dirty_has(".glb", ".blend", ".gdshader") else "GDScript & Scenes"
        plan_short = "Argon•Med (Scene/3D)"
        impl_short = "Argon•Med(3D)/Flash(GD)"
        edit_short = "Flash•Low (TSCN/UI)"
        plan_full = "Argon • Med (Scene Tree, Signals & 3D Topology)"
        impl_full = "Argon • Med (3D Shaders/Nav) │ Flash • Low (GDScript)"
        edit_full = "Flash • Low (TSCN/TRES Properties & UI Tweaks)"
        hw = "RTX 5060 OptiX (Blender)"
        live_rec = "Argon • Med" if dirty_has(".glb", ".blend", ".gdshader") else "Flash • Low"
        live_reason = work_now

    # 6. Unity / C# / Avalonia Cross-Platform (SuperRCProHams, PS-Multi-Tools)
    elif has_ext(".cs", ".axaml", ".unity"):
        stack = "C# .NET / Unity / Avalonia"
        work_now = "C# Async & Logic" if dirty_has(".cs") else "AXAML UI & Assets"
        plan_short = "Argon•Med (MVVM/Async)"
        impl_short = "Argon•Med (C# .NET/AOT)"
        edit_short = "Flash•Low (AXAML/UI)"
        plan_full = "Argon • Med (MVVM Architecture & Async/AOT Plan)"
        impl_full = "Argon • Med (C# Core Logic, Span<T> & P/Invoke)"
        edit_full = "Flash • Low (AXAML/XAML Views, CSProj & Configs)"
        hw = "Dotnet Parallel Build"
        live_rec = "Argon • Med" if dirty_has(".cs") else "Flash • Low"
        live_reason = work_now

    # 7. Android Kotlin / NDK (tetherfusenet, NSZ-Android)
    elif has_ext(".kt", ".kts"):
        stack = "Android Kotlin / NDK / VPN"
        work_now = "Kotlin/NDK Services" if dirty_has(".kt", ".cpp", ".c") else "Gradle & Manifests"
        plan_short = "Argon•Med (Service/NDK)"
        impl_short = "Argon•Med (Kotlin/JNI)"
        edit_short = "Flash•Low (Gradle/XML)"
        plan_full = "Argon • Med (Android Foreground Service & NDK Plan)"
        impl_full = "Argon • Med (Kotlin Coroutines, VPN & JNI C++)"
        edit_full = "Flash • Low (Gradle KTS, AndroidManifest & XML UI)"
        hw = "ADB + Radeon 610M iGPU"
        live_rec = "Argon • Med" if dirty_has(".kt", ".cpp", ".c") else "Flash • Low"
        live_reason = work_now

    # 8. CLI Power Setup (Skills, Multi-Agent Orchestration, Hardware Offload)
    elif "cli-power-setup" in name_low:
        stack = "AI Skills / Python / Bash"
        work_now = "CLI Daemons & Skills" if dirty_has(".py", ".sh") else "Skills & Rules"
        plan_short = "Argon•High (Quota/Arch)"
        impl_short = "Argon•Med (Py/Sh CLI)"
        edit_short = "Flash•Low (Skills/Sync)"
        plan_full = "Argon • High (Quota Forensics & Multi-Agent Design)"
        impl_full = "Argon • Med (Python/Bash CLI Daemons & AST Tools)"
        edit_full = "Flash • Low (SKILL.md, GEMINI.md Rules & Repo Sync)"
        hw = "Local AST/RAG + 32-Thr"
        live_rec = "Argon • Med" if dirty_has(".py", ".sh") else "Flash • Low"
        live_reason = work_now

    # 9. Homelab / NAS / Docker (raspberry-pi-nas-setup)
    elif "nas" in name_low or "docker" in name_low:
        stack = "Homelab / Docker / Samba"
        work_now = "Docker & NAS Config"
        plan_short = "Argon•Med (Storage/Net)"
        impl_short = "Flash•Low (Compose/Sh)"
        edit_short = "Flash•Low (Env/Samba)"
        plan_full = "Argon • Med (RAID Storage, Network & Security Plan)"
        impl_full = "Flash • Low (Docker Compose Stacks & Systemd Timers)"
        edit_full = "Flash • Low (.env Variables, Samba & Shell Edits)"
        hw = "Local ShellCheck Gate"
        live_rec = "Flash • Low"
        live_reason = work_now

    # 10. Console Homebrew & Crypto Utilities (nsz, switch-softmod-prep, BadUpdate, AegisVault, obtainium)
    elif any(k in name_low for k in ("nsz", "switch", "badupdate", "aegis", "vault", "obtainium")):
        stack = "Python / Crypto / Homebrew"
        if "aegis" in name_low or "vault" in name_low:
            work_now = "Vault Crypto & Security"
            plan_short = "Argon•High (Crypto/Sec)"
            plan_full = "Argon • High (Cryptographic Threat Model & KDF Spec)"
        else:
            work_now = "Homebrew & Binary Tools"
            plan_short = "Argon•Med (Binary Spec)"
            plan_full = "Argon • Med (Binary Container & Partition Layout Plan)"
        impl_short = "Argon•Med (Py/Crypto)"
        edit_short = "Flash•Low (CLI/Feeds)"
        impl_full = "Argon • Med (Python Crypto, Binary I/O & Compression)"
        edit_full = "Flash • Low (CLI Flags, JSON Feeds & Documentation)"
        hw = "32-Thr ProcessPool + /dev/shm"
        live_rec = "Argon • Med" if dirty_has(".py", ".so", ".spec") else "Flash • Low"
        live_reason = work_now

    # 11. Web / Static Sites / JS / Browser Extensions (ModernizedSites, ClutterlessSocial, Wlfryt-Android-Messages)
    elif has_ext(".html", ".js", ".ts", ".tsx", ".css", ".webp"):
        stack = "Web / JS / Extension"
        work_now = "Web UI & JS Components"
        plan_short = "Argon•Med (UX/System)"
        impl_short = "Flash•Low (JS/TS/CSS)"
        edit_short = "Flash•Low (HTML/Styles)"
        plan_full = "Argon • Med (UI/UX Architecture & State Flow Plan)"
        impl_full = "Flash • Low (JS/TS Components & Tailwind/CSS)"
        edit_full = "Flash • Low (HTML Markup, Copy & Style Tweaks)"
        hw = "Radeon 610M iGPU Preview"
        live_rec = "Flash • Low"
        live_reason = work_now

    # Default fallback for any newly created or research repo
    else:
        top_ext = next(iter(active_exts.keys()), ".md")
        stack = f"Research / Docs ({top_ext})"
        work_now = f"Docs & Research ({top_ext})"
        plan_short = "Argon•Med (Research)"
        impl_short = "Flash•Low (Drafting)"
        edit_short = "Flash•Low (Markdown)"
        plan_full = "Argon • Med (Deep Research & Synthesis Plan)"
        impl_full = "Flash • Low (Document Drafting & Helper Scripts)"
        edit_full = "Flash • Low (Markdown Formatting & Fast Edits)"
        hw = "Local Vector RAG"
        live_rec = "Flash • Low"
        live_reason = work_now

    if has_crash_or_retry:
        work_now = "⚠️ Crash / Error Triage"
        plan_short = "Argon•High (Root Cause)"
        impl_short = "Argon•High (Crash Fix)"
        live_rec = "Argon • High"
        live_reason = "⚠️ Recent error/retry escalation"

    return {
        "stack": stack,
        "work_now": work_now,
        "plan_short": plan_short,
        "impl_short": impl_short,
        "edit_short": edit_short,
        "plan_full": plan_full,
        "impl_full": impl_full,
        "edit_full": edit_full,
        "routine": edit_short,
        "deep": plan_short,
        "live_rec": live_rec,
        "live_reason": live_reason,
        "hw": hw,
    }


SKIP_AUTHORED_DIRS = {
    "node_modules", "target", "build", "venv", ".venv", "dist", "__pycache__",
    "shots", "logs", "bench", "walk", "crashes", "aisha_v1_backup", "aisha_v2_backup",
    "_appdata_", "bin_x64",
}
SKIP_AUTHORED_FILES = {
    "token_ledger.json", "repo_cheatsheet.json", "skill_ecosystem_graph.json",
    "adaptive_reasoning_state.json",
}


def analyze_repo(repo: Path) -> dict:
    """Scans a single repository for file signatures, git status, recent authored files, and timestamps."""
    ext_counts: dict[str, int] = {}
    latest_mtime = 0.0
    authored_files: list[tuple[float, str]] = []
    is_git = (repo / ".git").exists()

    try:
        for root, dirs, files in os.walk(repo):
            dirs[:] = [
                d
                for d in dirs
                if not d.startswith(".")
                and not d.startswith("_appdata")
                and d not in SKIP_AUTHORED_DIRS
            ]
            for f in files:
                if f in SKIP_AUTHORED_FILES:
                    continue
                fp = Path(root) / f
                ext = fp.suffix.lower()
                if ext:
                    ext_counts[ext] = ext_counts.get(ext, 0) + 1
                try:
                    mt = fp.stat().st_mtime
                    if mt > latest_mtime:
                        latest_mtime = mt
                    if ext and ext not in (".png", ".jpg", ".sav", ".log"):
                        authored_files.append((mt, ext))
                except OSError:
                    pass
    except Exception:
        pass

    authored_files.sort(reverse=True)
    recent_exts: list[str] = []
    for _, ext in authored_files[:15]:
        if ext not in recent_exts:
            recent_exts.append(ext)
        if len(recent_exts) >= 3:
            break

    git_ts = 0.0
    last_commit_subj = ""
    dirty_files: list[str] = []
    dirty_exts: dict[str, int] = {}
    recent_commit_exts: dict[str, int] = {}

    if is_git:
        git_ts_str = run_git(repo, "log", "-1", "--format=%ct")
        git_ts = float(git_ts_str) if git_ts_str.isdigit() else 0.0
        last_commit_subj = run_git(repo, "log", "-1", "--format=%s")[:50]

        porcelain = run_git(repo, "status", "--porcelain")
        for line in porcelain.splitlines():
            if len(line) > 3:
                rel = line[3:].strip().strip('"')
                dirty_files.append(rel)
                top_part = Path(rel).parts[0] if Path(rel).parts else ""
                if top_part.startswith(".") or top_part.startswith("_appdata") or top_part in SKIP_AUTHORED_DIRS:
                    continue
                dp = repo / rel
                if dp.is_dir():
                    for r_root, r_dirs, r_files in os.walk(dp):
                        r_dirs[:] = [d for d in r_dirs if not d.startswith(".") and d not in SKIP_AUTHORED_DIRS]
                        for rf in r_files:
                            ext = Path(rf).suffix.lower()
                            if ext and ext not in (".png", ".jpg", ".sav", ".log"):
                                dirty_exts[ext] = dirty_exts.get(ext, 0) + 1
                else:
                    if dp.name in SKIP_AUTHORED_FILES:
                        continue
                    ext = dp.suffix.lower()
                    if ext and ext not in (".png", ".jpg", ".sav", ".log"):
                        dirty_exts[ext] = dirty_exts.get(ext, 0) + 1

        if not dirty_exts:
            diff_files = run_git(repo, "diff-tree", "--no-commit-id", "--name-only", "-r", "HEAD")
            for cf in diff_files.splitlines():
                ext = Path(cf.strip()).suffix.lower()
                if ext:
                    recent_commit_exts[ext] = recent_commit_exts.get(ext, 0) + 1

    # Check adaptive reasoning state for active errors
    has_crash_or_retry = False
    state_file = repo / ".agents" / "memory" / "adaptive_reasoning_state.json"
    if state_file.exists():
        try:
            st = json.loads(state_file.read_text(encoding="utf-8"))
            if st.get("current_tier", 1) >= 3:
                has_crash_or_retry = True
        except Exception:
            pass

    effective_dirty = dirty_exts if dirty_exts else recent_commit_exts
    profile = classify_workload(repo.name, ext_counts, effective_dirty, recent_exts, has_crash_or_retry)

    activity_ts = max(git_ts, latest_mtime)
    top_exts = [k for k, _ in sorted(ext_counts.items(), key=lambda x: -x[1])[:3]]

    return {
        "name": repo.name,
        "path": str(repo),
        "is_git": is_git,
        "activity_ts": activity_ts,
        "age_str": fmt_age(activity_ts),
        "dirty_count": len(dirty_files),
        "dirty_exts": dirty_exts,
        "recent_exts": recent_exts,
        "top_exts": top_exts,
        "last_commit": last_commit_subj,
        **profile,
    }


def scan_all_repos(save: bool = True) -> list[dict]:
    repos = []
    if GITHUB_ROOT.exists():
        for p in GITHUB_ROOT.iterdir():
            if p.is_dir() and not p.name.startswith("."):
                repos.append(p)

    with ThreadPoolExecutor(max_workers=min(16, max(1, len(repos)))) as ex:
        results = list(ex.map(analyze_repo, repos))

    # Sort by dirty first, then most recent activity timestamp
    results.sort(key=lambda r: (r["dirty_count"] > 0, r["activity_ts"]), reverse=True)

    if save:
        home_str = str(Path.home())
        sanitized = [{**r, "path": r["path"].replace(home_str, "~")} for r in results]
        payload = {
            "updated_at": datetime.now().isoformat(),
            "total_repos": len(sanitized),
            "repos": sanitized,
        }
        try:
            CONFIG_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
            CONFIG_STATE_PATH.write_text(json.dumps(payload, indent=2), encoding="utf-8")
            USER_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
            if not USER_STATE_PATH.exists() and not USER_STATE_PATH.is_symlink():
                USER_STATE_PATH.symlink_to(CONFIG_STATE_PATH)
        except Exception:
            pass

    return results


def color_rec(rec: str) -> str:
    if "Argon•High+Flash" in rec or "Swarm" in rec:
        return f"{C_YELLOW}{C_BOLD}{rec}{C_RESET}"
    if "Argon • High" in rec:
        return f"{C_MAGENTA}{C_BOLD}{rec}{C_RESET}"
    if "Argon • Med" in rec:
        return f"{C_CYAN}{C_BOLD}{rec}{C_RESET}"
    return f"{C_GREEN}{C_BOLD}{rec}{C_RESET}"


def _short_tier(model_str: str) -> str:
    if "Argon•High" in model_str or "Argon • High" in model_str:
        return "High"
    if "Argon•Med" in model_str or "Argon • Med" in model_str:
        return "Med"
    return "Flash"


def get_statusline_bars(target_dir: str | None = None) -> dict:
    """Fast (<15ms cached) bottom-of-statusline cheat sheet bars for agy-quota-statusline."""
    cwd = Path(target_dir or os.getcwd()).resolve()
    now = time.time()

    # 5-second cache keyed by directory so file edits update almost immediately
    if STATUSLINE_CACHE.exists():
        try:
            cache = json.loads(STATUSLINE_CACHE.read_text(encoding="utf-8"))
            if (
                cache.get("schema_v") == 7
                and cache.get("cwd") == str(cwd)
                and (now - cache.get("ts", 0)) < 5
                and "active_segments" in cache
            ):
                return cache
        except Exception:
            pass

    # Load or refresh fleet index (refresh if older than 60s or outdated schema)
    fleet: list[dict] = []
    need_scan = True
    if CONFIG_STATE_PATH.exists():
        try:
            if (now - CONFIG_STATE_PATH.stat().st_mtime) < 60:
                data = json.loads(CONFIG_STATE_PATH.read_text(encoding="utf-8"))
                fleet = data.get("repos", [])
                if fleet and "plan_short" in fleet[0]:
                    need_scan = False
        except Exception:
            pass
    if need_scan or not fleet:
        fleet = scan_all_repos(save=True)

    # Find containing git repo or project folder in ~/Documents/GitHub
    repo_dir = cwd
    found_repo = False
    while repo_dir != repo_dir.parent:
        if (repo_dir / ".git").exists() or repo_dir.parent == GITHUB_ROOT:
            found_repo = True
            break
        repo_dir = repo_dir.parent

    if found_repo and repo_dir.is_dir():
        info = analyze_repo(repo_dir)
        prefix_label = info["name"]
    elif fleet:
        top_name = fleet[0]["name"]
        top_path = GITHUB_ROOT / top_name
        info = analyze_repo(top_path) if top_path.is_dir() else fleet[0]
        prefix_label = f"Latest:{info['name']}"
    else:
        info = {
            "name": cwd.name,
            "dirty_count": 0,
            "dirty_exts": {},
            "recent_exts": [],
            "work_now": "Standard Workflow",
            "plan_short": "Argon•Med (Plan)",
            "impl_short": "Argon•Med (Code)",
            "edit_short": "Flash•Low (Edits)",
            "live_rec": "Flash • Low",
            "live_reason": "Standard workflow",
            "routine": "Flash•Low",
            "deep": "Argon•High",
            "hw": "32-Thr CPU + /dev/shm",
        }
        prefix_label = cwd.name

    recent_exts = info.get("recent_exts") or list(info.get("dirty_exts", {}).keys())[:2]
    ext_badge = ",".join(recent_exts[:2]) if recent_exts else "clean"
    short_prefix = prefix_label.replace("ogsr-complete-", "ogsr-")
    plan_tier_only = info["plan_short"].split(" (")[0]

    active_segments = [
        f"🧭 {short_prefix} ({info['work_now']} {ext_badge})",
        f"📐 Plan: {plan_tier_only}",
        f"🔨 Implement: {info['impl_short'].replace(' (', '(')}",
        f"✏️ Edit Files: {info['edit_short'].replace(' (', '(')}",
    ]

    # Build top active fleet strip (Hardware offload + top 3 other active repos with Plan/Impl/Edit)
    fleet_items = []
    for r in fleet:
        if r["name"] == info["name"]:
            continue
        short_name = (
            r["name"]
            .replace("ogsr-complete-", "ogsr-")
            .replace("cli-power-setup", "cli-power")
            .replace("wlfryt-", "")[:14]
        )
        p_t = _short_tier(r.get("plan_short", "Argon•Med"))
        i_t = _short_tier(r.get("impl_short", "Argon•Med"))
        e_t = _short_tier(r.get("edit_short", "Flash•Low"))
        fleet_items.append(f"{short_name}({p_t}/{i_t}/{e_t})")
        if len(fleet_items) >= 3:
            break

    fleet_segments = [f"🚀 HW: {info['hw']}"]
    if fleet_items:
        fleet_segments.append(f"📚 Other Repos: {fleet_items[0]}")
        fleet_segments.extend(fleet_items[1:])

    out = {
        "schema_v": 7,
        "cwd": str(cwd),
        "ts": now,
        "seg": f"📐Plan:{_short_tier(info['plan_short'])} 🔨Impl:{_short_tier(info['impl_short'])} ✏️Edit:{_short_tier(info['edit_short'])}",
        "active_segments": active_segments,
        "fleet_segments": fleet_segments,
    }
    try:
        STATUSLINE_CACHE.write_text(json.dumps(out), encoding="utf-8")
    except Exception:
        pass
    return out


def get_statusline_rec(target_dir: str | None = None) -> str:
    return get_statusline_bars(target_dir).get("seg", "📐Plan:Med 🔨Impl:Med ✏️Edit:Flash")


def print_banner(cwd: Path, results: list[dict], top_n: int = 5) -> None:
    """Compact cheat sheet printed automatically when launching agy-yolo / agy-turbo."""
    cur_repo = next((r for r in results if str(cwd).startswith(r["path"])), results[0] if results else None)

    print(f"{C_CYAN}╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮{C_RESET}")
    print(f"{C_CYAN}│{C_RESET} 🧠 {C_BOLD}AGY DYNAMIC MODEL & WORKFLOW CHEAT SHEET{C_RESET} {C_DIM}(What model to use for Planning, Implementing & File Editing){C_RESET}          {C_CYAN}│{C_RESET}")
    if cur_repo:
        exts = ",".join(cur_repo.get("recent_exts", [])[:3]) or "clean"
        print(
            f"{C_CYAN}│{C_RESET} 📍 {C_BOLD}Active Repo:{C_RESET} {C_BOLD}{cur_repo['name']:<22}{C_RESET} │ 🔥 {C_BOLD}Current Work:{C_RESET} {C_YELLOW}{cur_repo.get('work_now', ''):<26}{C_RESET} ({exts})"
        )
        print(
            f"{C_CYAN}│{C_RESET}    ├─ 📐 {C_BOLD}Use for Planning     :{C_RESET} {C_MAGENTA}{cur_repo.get('plan_full', cur_repo['plan_short'])}{C_RESET}"
        )
        print(
            f"{C_CYAN}│{C_RESET}    ├─ 🔨 {C_BOLD}Use for Implementing :{C_RESET} {C_CYAN}{cur_repo.get('impl_full', cur_repo['impl_short'])}{C_RESET}"
        )
        print(
            f"{C_CYAN}│{C_RESET}    ├─ ✏️  {C_BOLD}Use for File Editing :{C_RESET} {C_GREEN}{cur_repo.get('edit_full', cur_repo['edit_short'])}{C_RESET}"
        )
        print(
            f"{C_CYAN}│{C_RESET}    └─ 🚀 {C_BOLD}Local HW Offload     :{C_RESET} {C_YELLOW}{cur_repo['hw']}{C_RESET}"
        )

    print(f"{C_CYAN}├────────────────────────┬──────────────────────────┬──────────────────────────┬─────────────────────────────┬──────────────────────────┤{C_RESET}")
    print(f"{C_CYAN}│{C_RESET} {C_BOLD}{'Recent Active Repo':<22}{C_RESET} │ {C_BOLD}{'Current Work':<24}{C_RESET} │ {C_BOLD}{'📐 Plan Model':<24}{C_RESET} │ {C_BOLD}{'🔨 Implement Model':<27}{C_RESET} │ {C_BOLD}{'✏️ File Edit Model':<24}{C_RESET} {C_CYAN}│{C_RESET}")
    print(f"{C_CYAN}├────────────────────────┼──────────────────────────┼──────────────────────────┼─────────────────────────────┼──────────────────────────┤{C_RESET}")
    for r in results[:top_n]:
        name_col = r["name"][:22]
        work_col = r.get("work_now", r["stack"])[:24]
        plan_col = r.get("plan_short", r["deep"])[:24]
        impl_col = r.get("impl_short", r["live_rec"])[:27]
        edit_col = r.get("edit_short", r["routine"])[:24]
        print(
            f"{C_CYAN}│{C_RESET} {name_col:<22} │ {work_col:<24} │ {C_MAGENTA}{plan_col:<24}{C_RESET} │ {C_CYAN}{impl_col:<27}{C_RESET} │ {C_GREEN}{edit_col:<24}{C_RESET} {C_CYAN}│{C_RESET}"
        )
    print(f"{C_CYAN}╰────────────────────────┴──────────────────────────┴──────────────────────────┴─────────────────────────────┴──────────────────────────╯{C_RESET}")
    print(f"{C_DIM}  Tip: Run `agy-cheatsheet` (or `cs`) anytime for full table, or `agy-cheatsheet --all` for all {len(results)} repos.{C_RESET}\n")


def print_full_table(cwd: Path, results: list[dict], show_all: bool = False) -> None:
    limit = len(results) if show_all else min(14, len(results))
    cur_repo = next((r for r in results if str(cwd).startswith(r["path"])), results[0] if results else None)

    print(f"\n{C_CYAN}========================================================================================================================================{C_RESET}")
    print(f" 🧠 {C_BOLD}ANTIGRAVITY (AGY) & CLAUDE MODEL SELECTION CHEAT SHEET — PLAN vs. IMPLEMENT vs. EDIT FILES{C_RESET} ({len(results)} GitHub Repos Indexed)")
    print(f"{C_CYAN}========================================================================================================================================{C_RESET}")

    if cur_repo:
        exts = ", ".join(cur_repo.get("recent_exts", [])[:3]) or "clean"
        dirty_info = (
            f"{cur_repo['dirty_count']} uncommitted files (Recent active: {exts})"
            if cur_repo["dirty_count"]
            else f"Working tree clean (Recent active: {exts})"
        )
        print(f" 📍 {C_BOLD}ACTIVE WORKSPACE:{C_RESET}       {C_BOLD}{cur_repo['name']}{C_RESET}  │  🔥 {C_BOLD}Current Work:{C_RESET} {C_YELLOW}{cur_repo.get('work_now', '')}{C_RESET}  │  {dirty_info}")
        print(f"    📐 {C_BOLD}USE FOR PLANNING:{C_RESET}     {C_MAGENTA}{C_BOLD}{cur_repo.get('plan_full', cur_repo['plan_short'])}{C_RESET}")
        print(f"    🔨 {C_BOLD}USE FOR IMPLEMENTING:{C_RESET} {C_CYAN}{C_BOLD}{cur_repo.get('impl_full', cur_repo['impl_short'])}{C_RESET}")
        print(f"    ✏️  {C_BOLD}USE FOR FILE EDITING:{C_RESET} {C_GREEN}{C_BOLD}{cur_repo.get('edit_full', cur_repo['edit_short'])}{C_RESET}")
        print(f"    🚀 {C_BOLD}LOCAL HW OFF-LOAD:{C_RESET}    {C_YELLOW}{cur_repo['hw']}{C_RESET}")
        print(f"{C_CYAN}----------------------------------------------------------------------------------------------------------------------------------------{C_RESET}")

    header = f" {'Repository':<24} | {'Current Work':<23} | {'📐 Plan With':<25} | {'🔨 Implement With':<29} | {'✏️ Edit Files With':<25}"
    print(C_BOLD + header + C_RESET)
    print(f"{C_CYAN}----------------------------------------------------------------------------------------------------------------------------------------{C_RESET}")

    for r in results[:limit]:
        marker = "▶" if (cur_repo and r["name"] == cur_repo["name"]) else ("*" if r["dirty_count"] > 0 else " ")
        name_str = f"{marker} {r['name'][:22]}"
        work_str = r.get("work_now", r["stack"])[:23]
        plan_str = r.get("plan_short", r["deep"])[:25]
        impl_str = r.get("impl_short", r["live_rec"])[:29]
        edit_str = r.get("edit_short", r["routine"])[:25]
        print(
            f" {name_str:<24} | {work_str:<23} | {C_MAGENTA}{plan_str:<25}{C_RESET} | {C_CYAN}{impl_str:<29}{C_RESET} | {C_GREEN}{edit_str:<25}{C_RESET}"
        )

    print(f"{C_CYAN}========================================================================================================================================{C_RESET}")
    print(f" {C_BOLD}HOW TO CHOOSE THE RIGHT MODEL BY WORKFLOW PHASE:{C_RESET}")
    print(f"  • 📐 {C_MAGENTA}{C_BOLD}Planning (`/plan`, Root-Cause Triage):{C_RESET} Use {C_MAGENTA}Argon • High{C_RESET} for 64b C++/Shaders/RE/Kernel/Crypto; {C_CYAN}Argon • Med{C_RESET} for 3D/Lua/App specs.")
    print(f"  • 🔨 {C_CYAN}{C_BOLD}Implementing (New Code, Shaders, 3D):{C_RESET}  Use {C_MAGENTA}Argon • High{C_RESET} for C++20/HLSL/Hooks; {C_CYAN}Argon • Med{C_RESET} for Blender `bpy`/Lua/Kotlin/C#/Python.")
    print(f"  • ✏️  {C_GREEN}{C_BOLD}General File Editing (Configs, Diffs):{C_RESET} Use {C_GREEN}Flash • Low{C_RESET} for LTX/JSON/XML, Copy-Then-Patch (`cp` + `replace_file_content`), and docs.")
    if not show_all and len(results) > limit:
        print(f"  {C_DIM}(Showing top {limit} most active repos. Run `agy-cheatsheet --all` to view all {len(results)} repos.){C_RESET}")
    print()


def main() -> None:
    parser = argparse.ArgumentParser(description="Dynamic Repo-Aware Model & Reasoning Cheat Sheet")
    parser.add_argument("--all", action="store_true", help="Show all repositories in ~/Documents/GitHub")
    parser.add_argument("--banner", action="store_true", help="Print compact startup banner for agy-yolo/agy-turbo")
    parser.add_argument("--statusline", nargs="?", const=".", help="Print compact 1-segment recommendation for statusline")
    parser.add_argument("--statusline-bars", nargs="?", const=".", help="Output JSON cheat sheet bars for bottom of statusline")
    parser.add_argument("--update", action="store_true", help="Silently scan and update repo_cheatsheet.json")
    parser.add_argument("--json", action="store_true", help="Output full cheat sheet telemetry as JSON")
    args = parser.parse_args()

    if args.statusline_bars is not None:
        print(json.dumps(get_statusline_bars(args.statusline_bars)))
        return

    if args.statusline is not None:
        print(get_statusline_rec(args.statusline))
        return

    results = scan_all_repos(save=True)
    cwd = Path.cwd().resolve()

    if args.update:
        print(f"[✓] Updated dynamic model cheat sheet ({len(results)} repos indexed).")
        return

    if args.json:
        print(json.dumps(results, indent=2))
        return

    if args.banner:
        print_banner(cwd, results, top_n=5)
    else:
        print_full_table(cwd, results, show_all=args.all)


if __name__ == "__main__":
    main()
