        edit_short = "Flash•Low+🤖qwen1.5b(LTX/Diffs)"
        edit_full = "Flash • Low + 🤖 qwen2.5-coder:1.5b/bge-m3 (LTX/XML Diffs, RAG & Commit Msg)"
        hw = "RTX 5060 OptiX + 32-Thr /dev/shm"

        if "merge" in name_low:
            if dirty_has(".ogf", ".dm", ".blend", ".dds") and dirty_has(".py", ".cpp"):
                work_now = "3D/OGF & C++ Port"
                plan_short = "Argon•High+🤖minicpm-v(3D/64b)"
                impl_short = "Argon•Med+🤖blender-arch(3D)/High(C++)"
            elif dirty_has(".ps", ".vs", ".hlsl", ".xr"):
                work_now = "DX11/RTX Shaders"
                plan_short = "Argon•High+🤖r1:8b(RTX/Math)"
                impl_short = "Argon•High+🤖qwen7b(HLSL/C++)"
