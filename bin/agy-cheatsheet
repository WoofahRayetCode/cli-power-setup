SKIP_AUTHORED_DIRS = {
    "node_modules", "target", "build", "venv", ".venv", "dist", "__pycache__",
    "shots", "logs", "bench", "walk", "crashes", "aisha_v1_backup", "aisha_v2_backup",
    "_appdata_", "bin_x64",
}
SKIP_AUTHORED_FILES = {
    "token_ledger.json", "repo_cheatsheet.json", "skill_ecosystem_graph.json",
    "adaptive_reasoning_state.json",
}


def analyze_repo(repo: Path) -> dict:
    """Scans a single repository for file signatures, git status, recent authored files, and timestamps."""
    ext_counts: dict[str, int] = {}
    latest_mtime = 0.0
    authored_files: list[tuple[float, str]] = []
    is_git = (repo / ".git").exists()

    try:
        for root, dirs, files in os.walk(repo):
            dirs[:] = [
                d
                for d in dirs
                if not d.startswith(".")
                and not d.startswith("_appdata")
                and d not in SKIP_AUTHORED_DIRS
            ]
            for f in files:
                if f in SKIP_AUTHORED_FILES:
                    continue
                fp = Path(root) / f
                ext = fp.suffix.lower()
                if ext:
                    ext_counts[ext] = ext_counts.get(ext, 0) + 1
                try:
                    mt = fp.stat().st_mtime
                    if mt > latest_mtime:
                        latest_mtime = mt
                    if ext and ext not in (".png", ".jpg", ".sav", ".log"):
                        authored_files.append((mt, ext))
                except OSError:
                    pass
    except Exception:
        pass

    authored_files.sort(reverse=True)
    recent_exts: list[str] = []
    for _, ext in authored_files[:15]:
        if ext not in recent_exts:
            recent_exts.append(ext)
        if len(recent_exts) >= 3:
            break

    git_ts = 0.0
    last_commit_subj = ""
    dirty_files: list[str] = []
    dirty_exts: dict[str, int] = {}
    recent_commit_exts: dict[str, int] = {}

    if is_git:
        git_ts_str = run_git(repo, "log", "-1", "--format=%ct")
        git_ts = float(git_ts_str) if git_ts_str.isdigit() else 0.0
        last_commit_subj = run_git(repo, "log", "-1", "--format=%s")[:50]

        porcelain = run_git(repo, "status", "--porcelain")
        for line in porcelain.splitlines():
            if len(line) > 3:
                rel = line[3:].strip().strip('"')
                dirty_files.append(rel)
                top_part = Path(rel).parts[0] if Path(rel).parts else ""
                if top_part.startswith(".") or top_part.startswith("_appdata") or top_part in SKIP_AUTHORED_DIRS:
                    continue
                dp = repo / rel
                if dp.is_dir():
                    for r_root, r_dirs, r_files in os.walk(dp):
                        r_dirs[:] = [d for d in r_dirs if not d.startswith(".") and d not in SKIP_AUTHORED_DIRS]
                        for rf in r_files:
                            ext = Path(rf).suffix.lower()
                            if ext and ext not in (".png", ".jpg", ".sav", ".log"):
                                dirty_exts[ext] = dirty_exts.get(ext, 0) + 1
                else:
                    if dp.name in SKIP_AUTHORED_FILES:
                        continue
                    ext = dp.suffix.lower()
                    if ext and ext not in (".png", ".jpg", ".sav", ".log"):
                        dirty_exts[ext] = dirty_exts.get(ext, 0) + 1

        if not dirty_exts:
            diff_files = run_git(repo, "diff-tree", "--no-commit-id", "--name-only", "-r", "HEAD")
            for cf in diff_files.splitlines():
                ext = Path(cf.strip()).suffix.lower()
                if ext:
                    recent_commit_exts[ext] = recent_commit_exts.get(ext, 0) + 1

    # Check adaptive reasoning state for active errors
    has_crash_or_retry = False
    state_file = repo / ".agents" / "memory" / "adaptive_reasoning_state.json"
    if state_file.exists():
        try:
            st = json.loads(state_file.read_text(encoding="utf-8"))
            if st.get("current_tier", 1) >= 3:
                has_crash_or_retry = True
        except Exception:
            pass

    effective_dirty = dirty_exts if dirty_exts else recent_commit_exts
    profile = classify_workload(repo.name, ext_counts, effective_dirty, recent_exts, has_crash_or_retry)

    activity_ts = max(git_ts, latest_mtime)
    top_exts = [k for k, _ in sorted(ext_counts.items(), key=lambda x: -x[1])[:3]]

    return {
        "name": repo.name,
        "path": str(repo),
        "is_git": is_git,
        "activity_ts": activity_ts,
        "age_str": fmt_age(activity_ts),
        "dirty_count": len(dirty_files),
        "dirty_exts": dirty_exts,
        "recent_exts": recent_exts,
        "top_exts": top_exts,
        "last_commit": last_commit_subj,
        **profile,
    }


def scan_all_repos(save: bool = True) -> list[dict]:
    repos = []
    if GITHUB_ROOT.exists():
        for p in GITHUB_ROOT.iterdir():
            if p.is_dir() and not p.name.startswith("."):
                repos.append(p)

    with ThreadPoolExecutor(max_workers=min(16, max(1, len(repos)))) as ex:
        results = list(ex.map(analyze_repo, repos))

    # Sort by dirty first, then most recent activity timestamp
    results.sort(key=lambda r: (r["dirty_count"] > 0, r["activity_ts"]), reverse=True)

    if save:
        home_str = str(Path.home())
        sanitized = [{**r, "path": r["path"].replace(home_str, "~")} for r in results]
        payload = {
            "updated_at": datetime.now().isoformat(),
            "total_repos": len(sanitized),
            "repos": sanitized,
        }
        try:
            CONFIG_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
            CONFIG_STATE_PATH.write_text(json.dumps(payload, indent=2), encoding="utf-8")
            USER_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
            if not USER_STATE_PATH.exists() and not USER_STATE_PATH.is_symlink():
                USER_STATE_PATH.symlink_to(CONFIG_STATE_PATH)
        except Exception:
            pass

    return results


def color_rec(rec: str) -> str:
    if "Argon•High+Flash" in rec or "Swarm" in rec:
        return f"{C_YELLOW}{C_BOLD}{rec}{C_RESET}"
    if "Argon • High" in rec:
        return f"{C_MAGENTA}{C_BOLD}{rec}{C_RESET}"
    if "Argon • Med" in rec:
        return f"{C_CYAN}{C_BOLD}{rec}{C_RESET}"
    return f"{C_GREEN}{C_BOLD}{rec}{C_RESET}"


def _short_tier(model_str: str) -> str:
    base = "Flash"
    if "Argon•High" in model_str or "Argon • High" in model_str:
        base = "High"
    elif "Argon•Med" in model_str or "Argon • Med" in model_str:
        base = "Med"
    if "blender-arch" in model_str:
        return f"{base}+🤖blend"
    if "minicpm" in model_str:
        return f"{base}+🤖vlm"
    if "r1:8b" in model_str:
        return f"{base}+🤖r1"
    if "qwen7b" in model_str:
        return f"{base}+🤖q7b"
    if "qwen1.5b" in model_str:
        return f"{base}+🤖q1.5"
    return base


def get_statusline_bars(target_dir: str | None = None) -> dict:
    """Fast (<15ms cached) bottom-of-statusline cheat sheet bars for agy-quota-statusline."""
    cwd = Path(target_dir or os.getcwd()).resolve()
    now = time.time()

    # 5-second cache keyed by directory so file edits update almost immediately
    if STATUSLINE_CACHE.exists():
        try:
            cache = json.loads(STATUSLINE_CACHE.read_text(encoding="utf-8"))
            if (
                cache.get("schema_v") == 8
                and cache.get("cwd") == str(cwd)
                and (now - cache.get("ts", 0)) < 5
                and "active_segments" in cache
            ):
                return cache
        except Exception:
            pass

    # Load or refresh fleet index (refresh if older than 60s or outdated schema)
    fleet: list[dict] = []
    need_scan = True
    if CONFIG_STATE_PATH.exists():
        try:
            if (now - CONFIG_STATE_PATH.stat().st_mtime) < 60:
                data = json.loads(CONFIG_STATE_PATH.read_text(encoding="utf-8"))
                fleet = data.get("repos", [])
                if fleet and "🤖" in fleet[0].get("plan_short", ""):
                    need_scan = False
        except Exception:
            pass
    if need_scan or not fleet:
        fleet = scan_all_repos(save=True)

    # Find containing git repo or project folder in ~/Documents/GitHub
    repo_dir = cwd
    found_repo = False
    while repo_dir != repo_dir.parent:
        if (repo_dir / ".git").exists() or repo_dir.parent == GITHUB_ROOT:
            found_repo = True
            break
        repo_dir = repo_dir.parent

    if found_repo and repo_dir.is_dir():
        info = analyze_repo(repo_dir)
        prefix_label = info["name"]
    elif fleet:
        top_name = fleet[0]["name"]
        top_path = GITHUB_ROOT / top_name
        info = analyze_repo(top_path) if top_path.is_dir() else fleet[0]
        prefix_label = f"Latest:{info['name']}"
    else:
        info = {
            "name": cwd.name,
            "dirty_count": 0,
            "dirty_exts": {},
            "recent_exts": [],
            "work_now": "Standard Workflow",
            "plan_short": "Argon•Med+🤖r1:8b(Plan)",
            "impl_short": "Argon•Med+🤖qwen7b(Code)",
            "edit_short": "Flash•Low+🤖qwen1.5b(Edits)",
            "live_rec": "Flash•Low+🤖qwen1.5b",
            "live_reason": "Standard workflow",
            "routine": "Flash•Low+🤖qwen1.5b",
            "deep": "Argon•High+🤖r1:8b",
            "hw": "32-Thr CPU + /dev/shm",
        }
        prefix_label = cwd.name

    recent_exts = info.get("recent_exts") or list(info.get("dirty_exts", {}).keys())[:2]
    ext_badge = ",".join(recent_exts[:2]) if recent_exts else "clean"
    short_prefix = prefix_label.replace("ogsr-complete-", "ogsr-")

    active_segments = [
        f"🧭 {short_prefix} ({info['work_now']} {ext_badge})",
        f"📐 Plan: {info['plan_short'].replace(' (', '(')}",
        f"🔨 Implement: {info['impl_short'].replace(' (', '(')}",
        f"✏️ Edit Files: {info['edit_short'].replace(' (', '(')}",
    ]

    # Build top active fleet strip (Hardware offload + top 3 other active repos with Plan/Impl/Edit)
    fleet_items = []
    for r in fleet:
        if r["name"] == info["name"]:
            continue
        short_name = (
            r["name"]
            .replace("ogsr-complete-", "ogsr-")
            .replace("cli-power-setup", "cli-power")
            .replace("wlfryt-", "")[:14]
        )
        p_t = _short_tier(r.get("plan_short", "Argon•Med"))
        i_t = _short_tier(r.get("impl_short", "Argon•Med"))
        e_t = _short_tier(r.get("edit_short", "Flash•Low"))
        fleet_items.append(f"{short_name}({p_t}/{i_t}/{e_t})")
        if len(fleet_items) >= 3:
            break

    fleet_segments = [f"🚀 HW: {info['hw']}"]
    if fleet_items:
        fleet_segments.append(f"📚 Other Repos: {fleet_items[0]}")
        fleet_segments.extend(fleet_items[1:])

    out = {
        "schema_v": 8,
        "cwd": str(cwd),
        "ts": now,
        "seg": f"📐Plan:{_short_tier(info['plan_short'])} 🔨Impl:{_short_tier(info['impl_short'])} ✏️Edit:{_short_tier(info['edit_short'])}",
        "active_segments": active_segments,
        "fleet_segments": fleet_segments,
    }
    try:
        STATUSLINE_CACHE.write_text(json.dumps(out), encoding="utf-8")
    except Exception:
        pass
    return out


def get_statusline_rec(target_dir: str | None = None) -> str:
    return get_statusline_bars(target_dir).get("seg", "📐Plan:Med+🤖r1 🔨Impl:Med+🤖q7b ✏️Edit:Flash+🤖q1.5")


def print_banner(cwd: Path, results: list[dict], top_n: int = 5) -> None:
    """Compact cheat sheet printed automatically when launching agy-yolo / agy-turbo."""
    cur_repo = next((r for r in results if str(cwd).startswith(r["path"])), results[0] if results else None)

    print(f"{C_CYAN}╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮{C_RESET}")
    print(f"{C_CYAN}│{C_RESET} 🧠 {C_BOLD}AGY DYNAMIC CLOUD + LOCAL LLM CHEAT SHEET{C_RESET} {C_DIM}(What Cloud + Local Model to use for Planning, Implementing & Editing){C_RESET}                 {C_CYAN}│{C_RESET}")
    if cur_repo:
        exts = ",".join(cur_repo.get("recent_exts", [])[:3]) or "clean"
        print(
            f"{C_CYAN}│{C_RESET} 📍 {C_BOLD}Active Repo:{C_RESET} {C_BOLD}{cur_repo['name']:<22}{C_RESET} │ 🔥 {C_BOLD}Current Work:{C_RESET} {C_YELLOW}{cur_repo.get('work_now', ''):<26}{C_RESET} ({exts})"
        )
        print(
            f"{C_CYAN}│{C_RESET}    ├─ 📐 {C_BOLD}Use for Planning     :{C_RESET} {C_MAGENTA}{cur_repo.get('plan_full', cur_repo['plan_short'])}{C_RESET}"
        )
        print(
            f"{C_CYAN}│{C_RESET}    ├─ 🔨 {C_BOLD}Use for Implementing :{C_RESET} {C_CYAN}{cur_repo.get('impl_full', cur_repo['impl_short'])}{C_RESET}"
        )
        print(
            f"{C_CYAN}│{C_RESET}    ├─ ✏️  {C_BOLD}Use for File Editing :{C_RESET} {C_GREEN}{cur_repo.get('edit_full', cur_repo['edit_short'])}{C_RESET}"
        )
        print(
            f"{C_CYAN}│{C_RESET}    └─ 🚀 {C_BOLD}Local HW Offload     :{C_RESET} {C_YELLOW}{cur_repo['hw']}{C_RESET}"
        )

    print(f"{C_CYAN}├──────────────────────┬───────────────────────┬────────────────────────────────┬──────────────────────────────────────┬────────────────────────────────┤{C_RESET}")
    print(f"{C_CYAN}│{C_RESET} {C_BOLD}{'Recent Active Repo':<20}{C_RESET} │ {C_BOLD}{'Current Work':<21}{C_RESET} │ {C_BOLD}{'📐 Plan (Cloud + Local)':<30}{C_RESET} │ {C_BOLD}{'🔨 Implement (Cloud + Local)':<36}{C_RESET} │ {C_BOLD}{'✏️ Edit Files (Cloud + Local)':<30}{C_RESET} {C_CYAN}│{C_RESET}")
    print(f"{C_CYAN}├──────────────────────┼───────────────────────┼────────────────────────────────┼──────────────────────────────────────┼────────────────────────────────┤{C_RESET}")
    for r in results[:top_n]:
        name_col = r["name"][:20]
        work_col = r.get("work_now", r["stack"])[:21]
        plan_col = r.get("plan_short", r["deep"])[:30]
        impl_col = r.get("impl_short", r["live_rec"])[:36]
        edit_col = r.get("edit_short", r["routine"])[:30]
        print(
            f"{C_CYAN}│{C_RESET} {name_col:<20} │ {work_col:<21} │ {C_MAGENTA}{plan_col:<30}{C_RESET} │ {C_CYAN}{impl_col:<36}{C_RESET} │ {C_GREEN}{edit_col:<30}{C_RESET} {C_CYAN}│{C_RESET}"
        )
    print(f"{C_CYAN}╰──────────────────────┴───────────────────────┴────────────────────────────────┴──────────────────────────────────────┴────────────────────────────────╯{C_RESET}")
    print(f"{C_DIM}  Tip: Run `agy-cheatsheet` (or `cs`) anytime for full table, or `agy-cheatsheet --all` for all {len(results)} repos.{C_RESET}\n")


def print_full_table(cwd: Path, results: list[dict], show_all: bool = False) -> None:
    limit = len(results) if show_all else min(14, len(results))
    cur_repo = next((r for r in results if str(cwd).startswith(r["path"])), results[0] if results else None)

    print(f"\n{C_CYAN}========================================================================================================================================================{C_RESET}")
    print(f" 🧠 {C_BOLD}ANTIGRAVITY (AGY) CLOUD + LOCAL LLM CHEAT SHEET — PLAN vs. IMPLEMENT vs. EDIT FILES{C_RESET} ({len(results)} GitHub Repos Indexed)")
    print(f"{C_CYAN}========================================================================================================================================================{C_RESET}")

    if cur_repo:
        exts = ", ".join(cur_repo.get("recent_exts", [])[:3]) or "clean"
        dirty_info = (
            f"{cur_repo['dirty_count']} uncommitted files (Recent active: {exts})"
            if cur_repo["dirty_count"]
            else f"Working tree clean (Recent active: {exts})"
        )
        print(f" 📍 {C_BOLD}ACTIVE WORKSPACE:{C_RESET}       {C_BOLD}{cur_repo['name']}{C_RESET}  │  🔥 {C_BOLD}Current Work:{C_RESET} {C_YELLOW}{cur_repo.get('work_now', '')}{C_RESET}  │  {dirty_info}")
        print(f"    📐 {C_BOLD}USE FOR PLANNING:{C_RESET}     {C_MAGENTA}{C_BOLD}{cur_repo.get('plan_full', cur_repo['plan_short'])}{C_RESET}")
        print(f"    🔨 {C_BOLD}USE FOR IMPLEMENTING:{C_RESET} {C_CYAN}{C_BOLD}{cur_repo.get('impl_full', cur_repo['impl_short'])}{C_RESET}")
        print(f"    ✏️  {C_BOLD}USE FOR FILE EDITING:{C_RESET} {C_GREEN}{C_BOLD}{cur_repo.get('edit_full', cur_repo['edit_short'])}{C_RESET}")
        print(f"    🚀 {C_BOLD}LOCAL HW OFF-LOAD:{C_RESET}    {C_YELLOW}{cur_repo['hw']}{C_RESET}")
        print(f"{C_CYAN}--------------------------------------------------------------------------------------------------------------------------------------------------------{C_RESET}")

    header = f" {'Repository':<22} | {'Current Work':<21} | {'📐 Plan (Cloud + Local)':<30} | {'🔨 Implement (Cloud + Local)':<36} | {'✏️ Edit Files (Cloud + Local)':<31}"
    print(C_BOLD + header + C_RESET)
    print(f"{C_CYAN}--------------------------------------------------------------------------------------------------------------------------------------------------------{C_RESET}")

    for r in results[:limit]:
        marker = "▶" if (cur_repo and r["name"] == cur_repo["name"]) else ("*" if r["dirty_count"] > 0 else " ")
        name_str = f"{marker} {r['name'][:20]}"
        work_str = r.get("work_now", r["stack"])[:21]
        plan_str = r.get("plan_short", r["deep"])[:30]
        impl_str = r.get("impl_short", r["live_rec"])[:36]
        edit_str = r.get("edit_short", r["routine"])[:31]
        print(
            f" {name_str:<22} | {work_str:<21} | {C_MAGENTA}{plan_str:<30}{C_RESET} | {C_CYAN}{impl_str:<36}{C_RESET} | {C_GREEN}{edit_str:<31}{C_RESET}"
        )

    print(f"{C_CYAN}========================================================================================================================================================{C_RESET}")
    print(f" {C_BOLD}HOW TO PAIR CLOUD + LOCAL OLLAMA MODELS BY WORKFLOW PHASE:{C_RESET}")
    print(f"  • 📐 {C_MAGENTA}{C_BOLD}Planning (`/plan`, Triage):{C_RESET}   Pair {C_MAGENTA}Argon•High/Med{C_RESET} with local {C_MAGENTA}🤖 deepseek-r1:8b{C_RESET} (math/crash CoT) & {C_MAGENTA}🤖 minicpm-v:8b{C_RESET} (3D/UI render critique).")
    print(f"  • 🔨 {C_CYAN}{C_BOLD}Implementing (Code, 3D, Lua):{C_RESET} Pair {C_CYAN}Argon•High/Med{C_RESET} with local {C_CYAN}🤖 blender-architect{C_RESET} (`bpy`/SDF/OGF), {C_CYAN}🤖 qwen2.5-coder:7b{C_RESET}, & {C_CYAN}🤖 moondream{C_RESET} (live QA).")
    print(f"  • ✏️  {C_GREEN}{C_BOLD}Editing Files (Diffs, Docs):{C_RESET}  Pair {C_GREEN}Flash•Low{C_RESET} with local {C_GREEN}🤖 qwen2.5-coder:1.5b{C_RESET} (commits/docstrings/LTX) & {C_GREEN}🤖 bge-m3{C_RESET} (8k hybrid RAG).")
    if not show_all and len(results) > limit:
        print(f"  {C_DIM}(Showing top {limit} most active repos. Run `agy-cheatsheet --all` to view all {len(results)} repos.){C_RESET}")
    print()


def main() -> None:
    parser = argparse.ArgumentParser(description="Dynamic Repo-Aware Model & Reasoning Cheat Sheet")
    parser.add_argument("--all", action="store_true", help="Show all repositories in ~/Documents/GitHub")
    parser.add_argument("--banner", action="store_true", help="Print compact startup banner for agy-yolo/agy-turbo")
    parser.add_argument("--statusline", nargs="?", const=".", help="Print compact 1-segment recommendation for statusline")
    parser.add_argument("--statusline-bars", nargs="?", const=".", help="Output JSON cheat sheet bars for bottom of statusline")
    parser.add_argument("--update", action="store_true", help="Silently scan and update repo_cheatsheet.json")
    parser.add_argument("--json", action="store_true", help="Output full cheat sheet telemetry as JSON")
    args = parser.parse_args()

    if args.statusline_bars is not None:
        print(json.dumps(get_statusline_bars(args.statusline_bars)))
        return

    if args.statusline is not None:
        print(get_statusline_rec(args.statusline))
        return

    results = scan_all_repos(save=True)
    cwd = Path.cwd().resolve()

    if args.update:
        print(f"[✓] Updated dynamic model cheat sheet ({len(results)} repos indexed).")
        return

    if args.json:
        print(json.dumps(results, indent=2))
        return

    if args.banner:
        print_banner(cwd, results, top_n=5)
    else:
        print_full_table(cwd, results, show_all=args.all)


if __name__ == "__main__":
    main()
