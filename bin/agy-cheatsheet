from pathlib import Path

def _resolve_github_root() -> Path:
    candidates = [
        Path.home() / "Documents" / "GitHub",
        Path.home() / "source" / "repos",
        Path("C:/GitHub"),
        Path("D:/GitHub"),
    ]
    for c in candidates:
        if c.exists():
            return c
    return candidates[0]

GITHUB_ROOT = _resolve_github_root()
CONFIG_STATE_PATH = GITHUB_ROOT / "cli-power-setup" / "config" / "repo_cheatsheet.json"
USER_STATE_PATH = Path.home() / ".cli_power_setup" / "repo_cheatsheet.json"
STATUSLINE_CACHE = Path(tempfile.gettempdir()) / "agy_cheatsheet_statusline.json"

# ANSI Colors
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_DIM = "\033[2m"
C_CYAN = "\033[36m"
C_GREEN = "\033[32m"
C_YELLOW = "\033[33m"
C_MAGENTA = "\033[35m"
C_BLUE = "\033[34m"
C_RED = "\033[31m"


def run_git(repo: Path, *args: str, timeout: float = 2.0) -> str:
    try:
        res = subprocess.run(
            ["git", "-C", str(repo), *args],
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
        return res.stdout.strip() if res.returncode == 0 else ""
    except Exception:
        return ""


def fmt_age(ts: float) -> str:
    if ts <= 0:
        return "never"
    diff = max(0, int(time.time() - ts))
    if diff < 60:
        return f"{diff}s ago"
    if diff < 3600:
        return f"{diff // 60}m ago"
    if diff < 86400:
        return f"{diff // 3600}h ago"
    days = diff // 86400
    if days < 30:
        return f"{days}d ago"
    return f"{days // 30}mo ago"


def classify_workload(
