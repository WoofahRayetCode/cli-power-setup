#!/usr/bin/env bash
# ==============================================================================
# Claude Code CLI Turbo Launcher (claude-turbo)
# Launches Claude Code with Turbo acceleration across all reasoning levels:
# - Low: Fast edits & routine tasks (default, <= 1024 thinking tokens)
# - Medium: Standard feature work (<= 4096 thinking tokens)
# - High: Deep architecture & complex debugging (<= 16384 thinking tokens)
# ==============================================================================
export CLAUDE_TURBO=1
export CLAUDE_CODE_NO_FLICKER=1
export CLAUDE_MODE=1

EFFORT_VAL="low"
USER_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --effort|-e)
            EFFORT_VAL="$2"
            shift 2
            ;;
        --effort=*)
            EFFORT_VAL="${1#*=}"
            shift
            ;;
        *)
            USER_ARGS+=("$1")
            shift
            ;;
    esac
done

case "$EFFORT_VAL" in
    high|max)
        export MAX_THINKING_TOKENS=16384
        EFFORT_FLAG="--effort high"
        ;;
    med|medium)
        export MAX_THINKING_TOKENS=4096
        EFFORT_FLAG="--effort medium"
        ;;
    *)
        export MAX_THINKING_TOKENS=1024
        EFFORT_FLAG="--effort low"
        ;;
esac

[ -t 1 ] && command -v agy-cheatsheet >/dev/null 2>&1 && agy-cheatsheet --banner
exec claude $EFFORT_FLAG "${USER_ARGS[@]}"

