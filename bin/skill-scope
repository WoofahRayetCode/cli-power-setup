#!/usr/bin/env python3
"""skill-scope: limit which ~/.claude/skills load for a repo (or set the global default).

  skill-scope <repo> <skill>...    turn on CORE + listed skills for <repo>, turn off the rest
  skill-scope <repo> --show        show the repo's current overrides
  skill-scope --global             global default: CORE on, every other skill name-only

Writes skillOverrides to <repo>/.claude/settings.local.json (or ~/.claude/settings.json).
Every skill gets an explicit value, so the result doesn't depend on how scopes merge.
Takes effect in the next Claude Code session.
"""
import json
import os
import sys
import tempfile
from pathlib import Path

SKILLS_DIR = Path.home() / ".claude" / "skills"
CORE = {"linux-systems-engineering", "local-model-coprocessor", "project-memory-bank"}


def all_skills() -> list[str]:
    return sorted(p.parent.name for p in SKILLS_DIR.glob("*/SKILL.md"))


def write_overrides(path: Path, overrides: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        cfg = json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        cfg = {}
    cfg["skillOverrides"] = overrides
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def git_exclude(repo: Path) -> None:
    exclude = repo / ".git" / "info" / "exclude"
    if exclude.parent.is_dir():
        line = ".claude/settings.local.json"
        text = exclude.read_text() if exclude.exists() else ""
        if line not in text.split("\n"):
            exclude.write_text(text + ("" if text.endswith("\n") or not text else "\n") + line + "\n")


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    skills = all_skills()

    if argv[0] == "--global":
        overrides = {s: ("on" if s in CORE else "name-only") for s in skills}
        write_overrides(Path.home() / ".claude" / "settings.json", overrides)
        print(f"global: on = {', '.join(sorted(CORE & set(skills)))}; {len(skills) - len(CORE & set(skills))} others name-only")
        return 0

    repo = Path(argv[0]).expanduser().resolve()
    if not repo.is_dir():
        print(f"not a directory: {repo}", file=sys.stderr)
        return 1
    settings = repo / ".claude" / "settings.local.json"

    if argv[1:] == ["--show"]:
        try:
            ov = json.loads(settings.read_text()).get("skillOverrides", {})
        except FileNotFoundError:
            ov = {}
        for s in skills:
            print(f"{ov.get(s, '(unset)'):10s} {s}")
        return 0

    wanted = set(argv[1:])
    unknown = wanted - set(skills)
    if unknown:
        print(f"unknown skills: {', '.join(sorted(unknown))}\navailable: {' '.join(skills)}", file=sys.stderr)
        return 1
    on = (CORE | wanted) & set(skills)
    write_overrides(settings, {s: ("on" if s in on else "off") for s in skills})
    git_exclude(repo)
    print(f"{repo.name}: on = {', '.join(sorted(on))}")
    print(f"off = {', '.join(s for s in skills if s not in on)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
