#!/usr/bin/env python3
"""
agy-mic-button: Clickable Floating Voice Dictation Mic Pill for Antigravity (agy) Terminal
Provides a sleek, frameless, non-focus-stealing clickable [🎙️ Talk] + [⏎ Send] + [⚡ Auto] pill
that triggers agy's native `/voice` (F5) speech-to-text dictation in KDE Konsole, tmux, Kitty,
and Windows 10/11 Terminal without touching the keyboard.
"""

import argparse
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time

IS_WINDOWS = os.name == "nt"
TMP_DIR = Path(tempfile.gettempdir())
PID_FILE = TMP_DIR / "agy_mic_button.pid"
STATE_FILE = TMP_DIR / "agy_mic_state.json"


def write_state(
    recording: bool,
    auto_send: bool = False,
    start_ts: float = 0.0,
    closed_by_user: bool = False,
    pinned: bool = False,
) -> None:
    try:
        STATE_FILE.write_text(
            json.dumps(
                {
                    "recording": recording,
                    "auto_send": auto_send,
                    "pinned": pinned,
                    "start_ts": start_ts,
                    "closed_by_user": closed_by_user,
                    "updated_at": time.time(),
                }
            ),
            encoding="utf-8",
        )
    except Exception:
        pass


def send_key_to_agy(key_type: str = "F5") -> tuple[bool, str]:
    """
    Deliver F5 (\x1b[15~) or Enter (\r) directly to the active `agy` terminal session.
    Supports:
    1. KDE Konsole via D-Bus (`qdbus6 org.kde.konsole-* /Sessions/N org.kde.konsole.Session.sendText`)
    2. tmux panes running `agy` (`tmux send-keys -t <pane> F5` or `Enter`)
    3. Kitty remote control (`kitty @ send-text`)
    4. Windows 10/11 `keybd_event` (`VK_F5` / `VK_RETURN`)
    """
    seq = "\x1b[15~" if key_type == "F5" else "\r"
    targets_hit = []

    if IS_WINDOWS:
        try:
            import ctypes
            vk = 0x74 if key_type == "F5" else 0x0D  # VK_F5 or VK_RETURN
            ctypes.windll.user32.keybd_event(vk, 0, 0, 0)
            time.sleep(0.02)
            ctypes.windll.user32.keybd_event(vk, 0, 2, 0)
            return True, "Win32 VK_F5"
        except Exception as e:
            return False, str(e)

    # 1. KDE Konsole D-Bus inspection (prefer session with 'agy' in title or foreground process)
    qdbus_bin = shutil.which("qdbus6") or shutil.which("qdbus")
    if qdbus_bin:
        try:
            svcs = subprocess.check_output([qdbus_bin], text=True, stderr=subprocess.DEVNULL).splitlines()
            konsole_svcs = [s.strip() for s in svcs if "org.kde.konsole" in s]
            fallback_target = None
            for svc in konsole_svcs:
                sessions_out = subprocess.check_output(
                    [qdbus_bin, svc], text=True, stderr=subprocess.DEVNULL
                ).splitlines()
                for s_path in sessions_out:
                    s_path = s_path.strip()
                    if not s_path.startswith("/Sessions/"):
                        continue
                    if fallback_target is None:
                        fallback_target = (svc, s_path)
                    title = subprocess.run(
                        [qdbus_bin, svc, s_path, "org.kde.konsole.Session.title", "1"],
                        capture_output=True,
                        text=True,
                    ).stdout.strip().lower()
                    if "agy" in title or "antigravity" in title:
                        subprocess.run(
                            [qdbus_bin, svc, s_path, "org.kde.konsole.Session.sendText", seq],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            check=False,
                        )
                        targets_hit.append(f"Konsole({s_path})")
            if not targets_hit and fallback_target:
                svc, s_path = fallback_target
                subprocess.run(
                    [qdbus_bin, svc, s_path, "org.kde.konsole.Session.sendText", seq],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                targets_hit.append(f"Konsole({s_path})")
        except Exception:
            pass

    # 2. If no Konsole session was hit, check tmux panes running `agy`
    if not targets_hit and shutil.which("tmux"):
        try:
            panes = subprocess.check_output(
                ["tmux", "list-panes", "-a", "-F", "#{pane_id} #{pane_current_command}"],
                text=True,
                stderr=subprocess.DEVNULL,
            ).splitlines()
            for line in panes:
                parts = line.strip().split(None, 1)
                if len(parts) == 2 and "agy" in parts[1].lower():
                    tmux_key = "F5" if key_type == "F5" else "Enter"
                    subprocess.run(
                        ["tmux", "send-keys", "-t", parts[0], tmux_key],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        check=False,
                    )
                    targets_hit.append(f"tmux({parts[0]})")
                    break
        except Exception:
            pass

    if targets_hit:
        return True, ", ".join(targets_hit)
    return False, "No active agy terminal found"


def is_already_running() -> int | None:
    if not PID_FILE.is_file():
        return None
    try:
        pid = int(PID_FILE.read_text(encoding="utf-8").strip())
        os.kill(pid, 0)
        return pid
    except Exception:
        try:
            PID_FILE.unlink()
        except OSError:
            pass
        return None


def stop_existing() -> bool:
    pid = is_already_running()
    if not pid:
        write_state(False, False)
        return False
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
    try:
        PID_FILE.unlink()
    except OSError:
        pass
    write_state(False, False)
    return True


POS_FILE = Path.home() / ".cache" / "agy_mic_pos.json"


def has_active_agy_process() -> bool:
    """Return True if at least one `agy` CLI process is currently running."""
    if IS_WINDOWS:
        try:
            out = subprocess.check_output(
                ["tasklist", "/FI", "IMAGENAME eq agy.exe", "/NH"],
                text=True,
                stderr=subprocess.DEVNULL,
            )
            return "agy.exe" in out.lower()
        except Exception:
            return True
    try:
        res = subprocess.run(
            ["pgrep", "-x", "agy"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return res.returncode == 0
    except Exception:
        return True


def run_gui() -> None:
    if not IS_WINDOWS:
        # Use XCB (XWayland) on Linux/KDE Wayland so self.move(x, y), position persistence,
        # and startSystemMove() dragging work smoothly without Wayland coordinate restrictions.
        os.environ["QT_QPA_PLATFORM"] = "xcb"

    from PySide6.QtCore import Qt, QTimer, QPoint, QEvent, QObject
    from PySide6.QtGui import QFont, QCursor
    from PySide6.QtWidgets import (
        QApplication,
        QHBoxLayout,
        QLabel,
        QPushButton,
        QWidget,
    )

    app = QApplication(sys.argv)
    app.setApplicationName("AGY Mic Button")

    class MicPillWindow(QWidget):
        def __init__(self) -> None:
            super().__init__()
            self.recording = False
            self.auto_send = False
            self.pinned = False
            self.record_start = 0.0
            self.drag_pos: QPoint | None = None
            self.launch_ts = time.time()
            self.saw_agy = has_active_agy_process()

            # Frameless, always-on-top window that does not steal focus from terminal
            flags = (
                Qt.WindowType.FramelessWindowHint
                | Qt.WindowType.WindowStaysOnTopHint
                | Qt.WindowType.Tool
                | Qt.WindowType.WindowDoesNotAcceptFocus
            )
            self.setWindowFlags(flags)
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground, True)
            self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating, True)

            self.container = QWidget(self)
            self.container.setObjectName("pillContainer")
            layout = QHBoxLayout(self.container)
            layout.setContentsMargins(10, 6, 10, 6)
            layout.setSpacing(6)

            # Drag grip label
            self.grip = QLabel("⋮⋮ AGY")
            self.grip.setFont(QFont("Sans Serif", 9, QFont.Weight.Bold))
            self.grip.setStyleSheet("color: #88c0d0; padding: 4px 4px;")
            self.grip.setCursor(QCursor(Qt.CursorShape.SizeAllCursor))
            self.grip.setToolTip("Left-drag here (or right-drag anywhere on the pill) to move when unpinned")
            layout.addWidget(self.grip)

            # Talk / Stop Mic button
            self.mic_btn = QPushButton("🎙️ Talk")
            self.mic_btn.setFont(QFont("Sans Serif", 10, QFont.Weight.Bold))
            self.mic_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
            self.mic_btn.setToolTip("Click to start/stop AGY voice dictation (sends F5 / /voice)")
            self.mic_btn.clicked.connect(self.toggle_mic)
            layout.addWidget(self.mic_btn)

            # Send (Enter) button
            self.send_btn = QPushButton("⏎ Send")
            self.send_btn.setFont(QFont("Sans Serif", 9, QFont.Weight.Bold))
            self.send_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
            self.send_btn.setToolTip("Click to submit prompt (sends Enter to AGY terminal)")
            self.send_btn.clicked.connect(self.send_enter)
            layout.addWidget(self.send_btn)

            # Auto-Send toggle button
            self.auto_btn = QPushButton("⚡Auto:OFF")
            self.auto_btn.setFont(QFont("Sans Serif", 8, QFont.Weight.Bold))
            self.auto_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
            self.auto_btn.setToolTip("When ON, stopping the mic automatically presses Enter after 0.8s")
            self.auto_btn.clicked.connect(self.toggle_auto)
            layout.addWidget(self.auto_btn)

            # Pin toggle button (locks position + enforces always-on-top; right-click snaps to terminal top-right)
            self.pin_btn = QPushButton("📌")
            self.pin_btn.setFont(QFont("Sans Serif", 9, QFont.Weight.Bold))
            self.pin_btn.setFixedWidth(28)
            self.pin_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
            self.pin_btn.setToolTip(
                "Left-click: Pin/Unpin position on AGY terminal (locks dragging & stays on top)\n"
                "Right-click: Snap to active AGY terminal top-right corner & pin"
            )
            self.pin_btn.clicked.connect(self.toggle_pin)
            layout.addWidget(self.pin_btn)

            # Close button
            self.close_btn = QPushButton("×")
            self.close_btn.setFont(QFont("Sans Serif", 10, QFont.Weight.Bold))
            self.close_btn.setFixedWidth(22)
            self.close_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
            self.close_btn.setToolTip("Close AGY Mic Button (re-launch anytime with `agy-mic-button`)")
            self.close_btn.clicked.connect(lambda: self.close_cleanly(closed_by_user=True))
            layout.addWidget(self.close_btn)

            outer = QHBoxLayout(self)
            outer.setContentsMargins(0, 0, 0, 0)
            outer.addWidget(self.container)

            # Install event filter on grip, container, and buttons
            for w in (self, self.container, self.grip, self.mic_btn, self.send_btn, self.auto_btn, self.pin_btn):
                w.installEventFilter(self)

            self.timer = QTimer(self)
            self.timer.timeout.connect(self.tick_timer)
            self.timer.start(500)

            self.restore_or_position()
            self.apply_pin_ui()
            self.update_styles()
            self.adjustSize()
            write_state(False, self.auto_send, 0.0, closed_by_user=False, pinned=self.pinned)

        def restore_or_position(self) -> None:
            if POS_FILE.is_file():
                try:
                    pos = json.loads(POS_FILE.read_text(encoding="utf-8"))
                    self.pinned = bool(pos.get("pinned", False))
                    self.auto_send = bool(pos.get("auto_send", False))
                    self.auto_btn.setText("⚡Auto:ON" if self.auto_send else "⚡Auto:OFF")
                    if "x" in pos and "y" in pos:
                        self.move(int(pos["x"]), int(pos["y"]))
                        return
                except Exception:
                    pass
            screen = QApplication.primaryScreen()
            if screen:
                geo = screen.availableGeometry()
                x = geo.right() - self.width() - 28
                y = geo.bottom() - self.height() - 48
                self.move(max(20, x), max(20, y))

        def save_position(self) -> None:
            try:
                POS_FILE.parent.mkdir(parents=True, exist_ok=True)
                POS_FILE.write_text(
                    json.dumps(
                        {
                            "x": self.x(),
                            "y": self.y(),
                            "pinned": self.pinned,
                            "auto_send": self.auto_send,
                        }
                    ),
                    encoding="utf-8",
                )
            except Exception:
                pass

        def apply_pin_ui(self) -> None:
            if self.pinned:
                self.grip.setText("🔒 AGY")
                self.grip.setCursor(QCursor(Qt.CursorShape.ArrowCursor))
                self.pin_btn.setText("📍")
                self.raise_()
            else:
                self.grip.setText("⋮⋮ AGY")
                self.grip.setCursor(QCursor(Qt.CursorShape.SizeAllCursor))
                self.pin_btn.setText("📌")

        def toggle_pin(self) -> None:
            self.pinned = not self.pinned
            self.apply_pin_ui()
            self.save_position()
            write_state(self.recording, self.auto_send, self.record_start, pinned=self.pinned)
            self.update_styles()
            self.adjustSize()

        def snap_to_terminal_and_pin(self) -> None:
            """Snap pill to top-right header area of active terminal window (or screen) and pin."""
            snapped = False
            if not IS_WINDOWS and shutil.which("xdotool"):
                try:
                    out = subprocess.check_output(
                        ["xdotool", "getactivewindow", "getwindowgeometry", "--shell"],
                        text=True,
                        stderr=subprocess.DEVNULL,
                        timeout=0.5,
                    )
                    vals = {}
                    for line in out.splitlines():
                        if "=" in line:
                            k, v = line.split("=", 1)
                            vals[k.strip()] = int(v.strip())
                    if "X" in vals and "Y" in vals and "WIDTH" in vals and vals["WIDTH"] > 350:
                        tx = vals["X"] + vals["WIDTH"] - self.width() - 24
                        ty = vals["Y"] + 12
                        self.move(max(10, tx), max(10, ty))
                        snapped = True
                except Exception:
                    pass
            if not snapped:
                screen = QApplication.primaryScreen()
                if screen:
                    geo = screen.availableGeometry()
                    self.move(max(20, geo.right() - self.width() - 28), max(20, geo.top() + 16))
            self.pinned = True
            self.apply_pin_ui()
            self.save_position()
            write_state(self.recording, self.auto_send, self.record_start, pinned=self.pinned)
            self.update_styles()
            self.adjustSize()

        def eventFilter(self, obj: QObject, event: QEvent) -> bool:
            etype = event.type()
            if etype == QEvent.Type.MouseButtonPress:
                btn = event.button()
                # Right-click on Pin button snaps to terminal & pins
                if obj == self.pin_btn and btn == Qt.MouseButton.RightButton:
                    self.snap_to_terminal_and_pin()
                    return True
                # When pinned, lock position and ignore drag initiation
                if self.pinned:
                    return super().eventFilter(obj, event)
                is_grip_or_bg = obj in (self, self.container, self.grip)
                if (is_grip_or_bg and btn == Qt.MouseButton.LeftButton) or btn == Qt.MouseButton.RightButton:
                    self.drag_pos = event.globalPosition().toPoint() - self.frameGeometry().topLeft()
                    wh = self.windowHandle()
                    if wh is not None and btn == Qt.MouseButton.LeftButton and is_grip_or_bg:
                        wh.startSystemMove()
                    return True
            elif etype == QEvent.Type.MouseMove:
                if not self.pinned and self.drag_pos is not None and (
                    event.buttons() & (Qt.MouseButton.LeftButton | Qt.MouseButton.RightButton)
                ):
                    self.move(event.globalPosition().toPoint() - self.drag_pos)
                    return True
            elif etype == QEvent.Type.MouseButtonRelease:
                if self.drag_pos is not None:
                    self.drag_pos = None
                    self.save_position()
                    return True
            return super().eventFilter(obj, event)

        def moveEvent(self, event) -> None:
            super().moveEvent(event)
            self.save_position()

        def update_styles(self) -> None:
            if self.recording:
                border_col = "#bf616a"
            elif self.pinned:
                border_col = "#88c0d0"
            else:
                border_col = "#4c566a"
            self.container.setStyleSheet(
                f"""
                QWidget#pillContainer {{
                    background-color: rgba(20, 23, 34, 242);
                    border: 2px solid {border_col};
                    border-radius: 16px;
                }}
                """
            )
            if self.recording:
                self.mic_btn.setStyleSheet(
                    """
                    QPushButton {
                        background-color: #bf616a;
                        color: #ffffff;
                        border: none;
                        border-radius: 11px;
                        padding: 5px 12px;
                    }
                    QPushButton:hover { background-color: #d08770; }
                    """
                )
            else:
                self.mic_btn.setStyleSheet(
                    """
                    QPushButton {
                        background-color: #2e3440;
                        color: #a3be8c;
                        border: 1px solid #a3be8c;
                        border-radius: 11px;
                        padding: 5px 12px;
                    }
                    QPushButton:hover { background-color: #3b4252; }
                    """
                )

            self.send_btn.setStyleSheet(
                """
                QPushButton {
                    background-color: #2e3440;
                    color: #88c0d0;
                    border: 1px solid #5e81ac;
                    border-radius: 10px;
                    padding: 5px 10px;
                }
                QPushButton:hover { background-color: #3b4252; }
                """
            )

            auto_col = "#ebcb8b" if self.auto_send else "#616e88"
            self.auto_btn.setStyleSheet(
                f"""
                QPushButton {{
                    background-color: #242933;
                    color: {auto_col};
                    border: 1px solid {auto_col};
                    border-radius: 9px;
                    padding: 4px 7px;
                }}
                QPushButton:hover {{ background-color: #2e3440; }}
                """
            )

            pin_col = "#88c0d0" if self.pinned else "#616e88"
            pin_bg = "#2e3440" if self.pinned else "#242933"
            self.pin_btn.setStyleSheet(
                f"""
                QPushButton {{
                    background-color: {pin_bg};
                    color: {pin_col};
                    border: 1px solid {pin_col};
                    border-radius: 9px;
                    padding: 4px 4px;
                }}
                QPushButton:hover {{ background-color: #3b4252; }}
                """
            )

            self.close_btn.setStyleSheet(
                """
                QPushButton {
                    background-color: transparent;
                    color: #616e88;
                    border: none;
                }
                QPushButton:hover { color: #bf616a; }
                """
            )

        def toggle_mic(self) -> None:
            send_key_to_agy("F5")
            self.recording = not self.recording
            if self.recording:
                self.record_start = time.time()
                self.mic_btn.setText("🔴 Stop (0:00)")
            else:
                self.mic_btn.setText("🎙️ Talk")
                if self.auto_send:
                    QTimer.singleShot(850, self.send_enter)
            write_state(self.recording, self.auto_send, self.record_start, pinned=self.pinned)
            self.update_styles()
            self.adjustSize()

        def send_enter(self) -> None:
            if self.recording:
                send_key_to_agy("F5")
                self.recording = False
                self.mic_btn.setText("🎙️ Talk")
                write_state(False, self.auto_send, 0.0, pinned=self.pinned)
                self.update_styles()
                QTimer.singleShot(700, lambda: send_key_to_agy("ENTER"))
            else:
                send_key_to_agy("ENTER")

        def toggle_auto(self) -> None:
            self.auto_send = not self.auto_send
            self.auto_btn.setText("⚡Auto:ON" if self.auto_send else "⚡Auto:OFF")
            self.save_position()
            write_state(self.recording, self.auto_send, self.record_start, pinned=self.pinned)
            self.update_styles()
            self.adjustSize()

        def tick_timer(self) -> None:
            # Auto-close when all `agy` terminal sessions have exited
            active_now = has_active_agy_process()
            if active_now:
                self.saw_agy = True
            elif self.saw_agy or (time.time() - self.launch_ts > 6.0):
                self.close_cleanly(closed_by_user=False)
                return

            # Sync external CLI `--pin` / `--unpin` state changes
            if POS_FILE.is_file():
                try:
                    disk_pos = json.loads(POS_FILE.read_text(encoding="utf-8"))
                    disk_pin = bool(disk_pos.get("pinned", self.pinned))
                    if disk_pin != self.pinned:
                        self.pinned = disk_pin
                        self.apply_pin_ui()
                        self.update_styles()
                        self.adjustSize()
                except Exception:
                    pass

            if self.pinned:
                self.raise_()

            if self.recording:
                elapsed = int(time.time() - self.record_start)
                if elapsed >= 205:
                    self.toggle_mic()
                    return
                mins, secs = divmod(elapsed, 60)
                self.mic_btn.setText(f"🔴 Stop ({mins}:{secs:02d})")

        def close_cleanly(self, closed_by_user: bool = True) -> None:
            if self.recording:
                send_key_to_agy("F5")
            write_state(False, self.auto_send, 0.0, closed_by_user=closed_by_user, pinned=self.pinned)
            try:
                PID_FILE.unlink()
            except OSError:
                pass
            app.quit()

    PID_FILE.write_text(str(os.getpid()), encoding="utf-8")
    win = MicPillWindow()
    win.show()
    sys.exit(app.exec())


def spawn_daemon() -> None:
    existing = is_already_running()
    if existing:
        print(f"[✓] AGY Mic Button is already active on desktop (PID {existing}).")
        return
    env = os.environ.copy()
    uid = os.getuid() if hasattr(os, "getuid") else 1000
    env.setdefault("DISPLAY", ":0")
    env.setdefault("WAYLAND_DISPLAY", "wayland-0")
    env["QT_QPA_PLATFORM"] = "xcb"
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path=/run/user/{uid}/bus")

    pinned_init = False
    if POS_FILE.is_file():
        try:
            pinned_init = bool(json.loads(POS_FILE.read_text(encoding="utf-8")).get("pinned", False))
        except Exception:
            pass
    write_state(False, False, 0.0, closed_by_user=False, pinned=pinned_init)

    script_path = str(Path(__file__).resolve())
    if not IS_WINDOWS and shutil.which("systemd-run"):
        subprocess.run(
            [
                "systemd-run",
                "--user",
                "--collect",
                "--setenv=DISPLAY=:0",
                "--setenv=WAYLAND_DISPLAY=wayland-0",
                "--setenv=QT_QPA_PLATFORM=xcb",
                sys.executable,
                script_path,
                "--foreground",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=env,
            check=False,
        )
    else:
        subprocess.Popen(
            [sys.executable, script_path, "--foreground"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            env=env,
            start_new_session=True,
        )
    time.sleep(0.35)
    pid = is_already_running()
    print(f"🎙️ [AGY Mic Button Active] Floating [🎙️ Talk | ⏎ Send | ⚡Auto | 📌Pin] pill launched (PID {pid}).")


def set_pin_from_cli(pin_state: bool) -> None:
    pos = {"x": 1450, "y": 980, "pinned": pin_state, "auto_send": False}
    if POS_FILE.is_file():
        try:
            pos.update(json.loads(POS_FILE.read_text(encoding="utf-8")))
        except Exception:
            pass
    pos["pinned"] = pin_state
    POS_FILE.parent.mkdir(parents=True, exist_ok=True)
    POS_FILE.write_text(json.dumps(pos), encoding="utf-8")
    if STATE_FILE.is_file():
        try:
            st = json.loads(STATE_FILE.read_text(encoding="utf-8"))
            st["pinned"] = pin_state
            STATE_FILE.write_text(json.dumps(st), encoding="utf-8")
        except Exception:
            pass
    print(f"[✓] AGY Mic Button pin state set to: {'📍 Pinned (Locked)' if pin_state else '📌 Unpinned (Draggable)'}")


def main() -> None:
    parser = argparse.ArgumentParser(description="Clickable Floating Voice Mic Pill for Antigravity (agy)")
    parser.add_argument("--foreground", action="store_true", help="Run GUI in foreground")
    parser.add_argument("--stop", action="store_true", help="Stop running AGY Mic Button overlay")
    parser.add_argument("--toggle", action="store_true", help="Trigger F5 voice dictation toggle from CLI")
    parser.add_argument("--pin", action="store_true", help="Pin/lock the AGY Mic Button at its current position")
    parser.add_argument("--unpin", action="store_true", help="Unpin/unlock the AGY Mic Button so it can be dragged")
    parser.add_argument("--status", action="store_true", help="Show current AGY Mic Button status")
    args = parser.parse_args()

    if args.stop:
        stopped = stop_existing()
        print(f"[✓] AGY Mic Button stopped: {stopped}")
    elif args.pin:
        set_pin_from_cli(True)
    elif args.unpin:
        set_pin_from_cli(False)
    elif args.toggle:
        ok, target = send_key_to_agy("F5")
        print(f"[✓] Sent F5 (/voice toggle) -> {target} (ok={ok})")
    elif args.status:
        pid = is_already_running()
        state = {}
        if STATE_FILE.is_file():
            try:
                state = json.loads(STATE_FILE.read_text(encoding="utf-8"))
            except Exception:
                pass
        print(f"AGY Mic Button: {'Running (PID ' + str(pid) + ')' if pid else 'Stopped'} | State: {state}")
    elif args.foreground:
        run_gui()
    else:
        spawn_daemon()


if __name__ == "__main__":
    main()
