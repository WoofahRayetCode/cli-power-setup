#!/usr/bin/env bash
# Game Weather & Lighting FX Tuner Launcher
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TOOL_SCRIPT="${SCRIPT_DIR}/config/skills/game-weather-lighting-fx/scripts/weather_lighting_tuner.py"

if [ ! -f "${TOOL_SCRIPT}" ]; then
    TOOL_SCRIPT="${HOME}/.gemini/config/skills/game-weather-lighting-fx/scripts/weather_lighting_tuner.py"
fi

if [ ! -f "${TOOL_SCRIPT}" ]; then
    TOOL_SCRIPT="${HOME}/.gemini/config/skills/game-weather-lighting-fx/scripts/weather_lighting_tuner.py"
fi

exec python3 "${TOOL_SCRIPT}" "$@"
