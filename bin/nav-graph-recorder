#!/usr/bin/env bash
# Autonomous Game Navigation & Route Replayer Launcher
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TOOL_SCRIPT="${SCRIPT_DIR}/config/skills/game-autonomous-navigation-ai/scripts/nav_graph_recorder.py"

if [ ! -f "${TOOL_SCRIPT}" ]; then
    TOOL_SCRIPT="${HOME}/.claude/skills/autonomous-game-qa-playtesting/scripts/nav_graph_recorder.py"
fi

if [ ! -f "${TOOL_SCRIPT}" ]; then
    TOOL_SCRIPT="${HOME}/.claude/skills/autonomous-game-qa-playtesting/scripts/nav_graph_recorder.py"
fi

exec python3 "${TOOL_SCRIPT}" "$@"
