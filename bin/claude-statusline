#!/usr/bin/env python3
"""
Claude Code CLI Dedicated Statusline Monitor (claude-statusline)
Pipes real-time session telemetry from Claude Code CLI via stdin.
"""
import sys
import json
from datetime import datetime

def make_bar(pct, width=8):
    pct = max(0.0, min(100.0, float(pct)))
    filled = int(round((pct / 100.0) * width))
    empty = width - filled
    return "█" * filled + "░" * empty

def main():
    raw = sys.stdin.read() if not sys.stdin.isatty() else ""
    if not raw.strip():
        # Fallback when run standalone or testing
        print("⚡ Claude: Standby (Active when run inside Claude Code CLI)")
        return

    try:
        data = json.loads(raw)
    except Exception:
        print("⚡ Claude: Session Active")
        return

    parts = []

    # 1. Model Name
    model_obj = data.get("model", {})
    model_name = model_obj.get("display_name", "Claude") if isinstance(model_obj, dict) else str(model_obj)
    short_model = model_name.replace("Claude ", "").replace("Anthropic ", "")
    parts.append(f"⚡ Claude [{short_model}]")

    # 2. Rate Limits (5-Hour & 7-Day Rolling Windows)
    rate_limits = data.get("rate_limits", {})
    five_h = rate_limits.get("five_hour", {})
    if five_h:
        used = five_h.get("used_percentage")
        resets_at = five_h.get("resets_at")
        if used is not None:
            rem = max(0, 100 - int(round(used)))
            reset_str = ""
            if resets_at:
                try:
                    dt = datetime.fromtimestamp(resets_at).astimezone()
                    reset_str = f" (reset {dt.strftime('%H:%M')})"
                except Exception:
                    pass
            parts.append(f"5h: {rem}%{reset_str}")

    seven_d = rate_limits.get("seven_day", {})
    if seven_d:
        used = seven_d.get("used_percentage")
        if used is not None:
            rem = max(0, 100 - int(round(used)))
            parts.append(f"Wk: {rem}%")

    # 3. Context Window Usage with Visual Progress Bar
    ctx = data.get("context_window", {})
    used_pct = ctx.get("used_percentage")
    if used_pct is not None:
        bar = make_bar(used_pct, width=6)
        parts.append(f"🧠 Ctx: [{bar}] {float(used_pct):.0f}%")

    # 4. Session Cost & Lines Changed
    cost_info = data.get("cost", {})
    if isinstance(cost_info, dict):
        cost_usd = cost_info.get("total_cost_usd", 0.0)
        lines_add = cost_info.get("total_lines_added", 0)
        lines_del = cost_info.get("total_lines_removed", 0)
        
        cost_parts = []
        if cost_usd > 0:
            cost_parts.append(f"${cost_usd:.2f}")
        if lines_add > 0 or lines_del > 0:
            cost_parts.append(f"+{lines_add}/-{lines_del}")
            
        if cost_parts:
            parts.append(f"💲 {' '.join(cost_parts)}")

    # 5. Git Worktree / Branch (if present)
    worktree = data.get("worktree", {})
    wt_name = worktree.get("name") if isinstance(worktree, dict) else None
    if wt_name:
        parts.append(f"🌿 {wt_name}")

    print(" | ".join(parts))

if __name__ == "__main__":
    main()
