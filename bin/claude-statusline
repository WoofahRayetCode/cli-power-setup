#!/usr/bin/env python3
"""
Claude Code CLI Dedicated Statusline Monitor (claude-statusline)
Pipes real-time session telemetry from Claude Code CLI via stdin.
"""
import os
import sys
import json
import subprocess
import shutil
from datetime import datetime

def wrap_segments(segments, max_width, sep=" | "):
    """
    Dynamically wrap segments into lines so that no line exceeds max_width,
    breaking cleanly at segment boundaries.
    """
    segs = [s.strip() for s in segments if s and s.strip()]
    if not segs:
        return ""

    lines = []
    cur_line = []
    cur_len = 0
    sep_len = len(sep)

    for seg in segs:
        seg_len = len(seg)
        if not cur_line:
            cur_line.append(seg)
            cur_len = seg_len
        else:
            if cur_len + sep_len + seg_len <= max_width:
                cur_line.append(seg)
                cur_len += sep_len + seg_len
            else:
                lines.append(sep.join(cur_line))
                cur_line = [seg]
                cur_len = seg_len

    if cur_line:
        lines.append(sep.join(cur_line))

    return "\n".join(lines)

def make_bar(pct, width=6):
    pct = max(0.0, min(100.0, float(pct)))
    filled = int(round((pct / 100.0) * width))
    empty = width - filled
    return "█" * filled + "░" * empty

def fmt_tok(n):
    if n >= 1_000_000_000:
        return f"{n / 1_000_000_000:.2f}B"
    elif n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    elif n >= 1_000:
        return f"{n / 1_000:.0f}k"
    return str(n)

def get_cache_savings(transcript_path):
    if not transcript_path or not os.path.exists(transcript_path):
        return None, None
    total_cached = 0
    total_uncached = 0
    try:
        with open(transcript_path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if '"cache_read_input_tokens"' in line:
                    try:
                        row = json.loads(line)
                        msg = row.get("message", {})
                        if isinstance(msg, dict):
                            u = msg.get("usage", {})
                            if u:
                                c = u.get("cache_read_input_tokens", 0)
                                if c:
                                    total_cached += c
                                total_uncached += u.get("input_tokens", 0) + u.get("cache_creation_input_tokens", 0)
                    except Exception:
                        pass
    except Exception:
        return None, None
    if total_cached <= 0:
        return None, None
    total_in = total_cached + total_uncached
    hit_pct = int(round((total_cached / total_in) * 100)) if total_in > 0 else 0
    return total_cached, hit_pct

def main():
    raw = sys.stdin.read() if not sys.stdin.isatty() else ""
    if not raw.strip():
        # Fallback when run standalone or testing
        print("⚡ Claude: Standby (Active when run inside Claude Code CLI)")
        return

    try:
        data = json.loads(raw)
    except Exception:
        print("⚡ Claude: Session Active")
        return

    parts = []

    # 1. Model Name with Turbo mode detection
    model_obj = data.get("model", {})
    model_name = model_obj.get("display_name", "Claude") if isinstance(model_obj, dict) else str(model_obj)
    short_model = model_name.replace("Claude ", "").replace("Anthropic ", "")
    is_turbo = os.environ.get("CLAUDE_TURBO") == "1" or os.environ.get("MAX_THINKING_TOKENS") == "1024"
    mode_tag = " • Turbo" if is_turbo else ""
    parts.append(f"⚡ Claude [{short_model}{mode_tag}]")

    # 2. Rate Limits (5-Hour & 7-Day Rolling Windows)
    rate_limits = data.get("rate_limits", {})
    five_h = rate_limits.get("five_hour", {})
    rem_5h = None
    reset_5h = None
    rem_wk = None
    if five_h:
        used = five_h.get("used_percentage")
        resets_at = five_h.get("resets_at")
        if used is not None:
            rem_5h = max(0, 100 - int(round(used)))
            reset_str = ""
            if resets_at:
                try:
                    dt = datetime.fromtimestamp(resets_at).astimezone()
                    reset_5h = dt.strftime('%H:%M')
                    reset_str = f" (reset {reset_5h})"
                except Exception:
                    pass
            parts.append(f"5h: {rem_5h}%{reset_str}")

    seven_d = rate_limits.get("seven_day", {})
    reset_wk = None
    reset_wk_epoch = None
    if seven_d:
        used = seven_d.get("used_percentage")
        resets_at_wk = seven_d.get("resets_at")
        if used is not None:
            rem_wk = max(0, 100 - int(round(used)))
            reset_str_wk = ""
            if resets_at_wk:
                try:
                    reset_wk_epoch = resets_at_wk
                    dt_wk = datetime.fromtimestamp(resets_at_wk).astimezone()
                    now_dt = datetime.now().astimezone()
                    diff_sec = (dt_wk - now_dt).total_seconds()
                    if diff_sec > 0 and diff_sec < 86400:
                        mins = int(round(diff_sec / 60))
                        if mins < 60:
                            reset_str_wk = f" (reset in {mins}m)"
                        else:
                            hrs = mins // 60
                            rem_m = mins % 60
                            reset_str_wk = f" (reset in {hrs}h {rem_m}m)"
                        reset_wk = dt_wk.strftime('%H:%M')
                    else:
                        reset_wk = dt_wk.strftime('%a %H:%M')
                        reset_str_wk = f" (reset {reset_wk})"
                except Exception:
                    pass
            parts.append(f"Wk: {rem_wk}%{reset_str_wk}")

    ctx = data.get("context_window", {})
    used_pct = ctx.get("used_percentage")
    raw_tok = ctx.get("total_input_tokens")

    if rem_5h is not None or rem_wk is not None or used_pct is not None:
        try:
            with open("/tmp/claude_quota_state.json", "w") as f:
                json.dump({
                    "updated_at": datetime.now().isoformat(),
                    "five_hour_remaining": rem_5h,
                    "five_hour_resets_at": reset_5h,
                    "five_hour_resets_epoch": five_h.get("resets_at") if five_h else None,
                    "weekly_remaining": rem_wk,
                    "weekly_resets_at": reset_wk,
                    "weekly_resets_epoch": reset_wk_epoch,
                    "context_used_pct": float(used_pct) if used_pct is not None else None,
                    "context_tokens": raw_tok
                }, f, indent=2)
        except Exception:
            pass

    # 3. Context Window Usage with Visual Progress Bar & Automatic Compaction Staging
    if used_pct is not None:
        pct_val = float(used_pct)
        bar = make_bar(pct_val, width=6)
        tok_str = fmt_tok(raw_tok) if raw_tok else fmt_tok(int((pct_val / 100.0) * 200_000))
        
        if pct_val >= 50.0:
            # Spawn detached background stager to automatically stage activeContext.md
            proj_dir = data.get("cwd") or data.get("workspace") or os.getcwd()
            watchdog_candidates = [
                os.path.expanduser("~/.local/bin/context-watchdog"),
                "/home/ericparsley/Documents/GitHub/cli-power-setup/bin/context-watchdog"
            ]
            for cand in watchdog_candidates:
                if os.path.exists(cand):
                    try:
                        cmd = [
                            cand, "check",
                            "--pct", str(pct_val),
                            "--tokens", str(raw_tok or int((pct_val / 100.0) * 200_000)),
                            "--project-dir", str(proj_dir)
                        ]
                        subprocess.Popen(
                            cmd,
                            cwd=str(proj_dir) if os.path.isdir(str(proj_dir)) else None,
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL
                        )
                    except Exception:
                        pass
                    break
            parts.append(f"🧠 Ctx: [{bar}] {pct_val:.0f}% ({tok_str} ⚠️ Staged • Run /compact)")
        else:
            parts.append(f"🧠 Ctx: [{bar}] {pct_val:.0f}% ({tok_str})")

    # 4. Prompt Cache Token Savings
    transcript_path = data.get("transcript_path")
    cached_tok = None
    hit_pct = None
    if transcript_path:
        cached_tok, hit_pct = get_cache_savings(transcript_path)
    if cached_tok:
        parts.append(f"💾 Saved: {fmt_tok(cached_tok)} tok ({hit_pct}% cache)")
    else:
        # Fall back to persistent lifetime token ledger if available
        ledger_path = os.path.expanduser("~/.cli_power_setup/token_ledger.json")
        if os.path.exists(ledger_path):
            try:
                with open(ledger_path, "r") as lf:
                    ld = json.load(lf)
                    ls = ld.get("lifetime_summary", {})
                    lt_tok = ls.get("total_cached_tokens_saved", 0)
                    lt_hit = ls.get("cache_hit_rate_pct", 0)
                    if lt_tok > 0:
                        parts.append(f"💾 Lifetime: {fmt_tok(lt_tok)} tok ({lt_hit:.1f}% cache)")
            except Exception:
                pass

    # 5. Session Cost & Lines Changed
    cost_info = data.get("cost", {})
    if isinstance(cost_info, dict):
        cost_usd = cost_info.get("total_cost_usd", 0.0)
        lines_add = cost_info.get("total_lines_added", 0)
        lines_del = cost_info.get("total_lines_removed", 0)
        
        cost_parts = []
        if cost_usd > 0:
            cost_parts.append(f"${cost_usd:.2f}")
        if lines_add > 0 or lines_del > 0:
            cost_parts.append(f"+{lines_add}/-{lines_del}")
            
        if cost_parts:
            parts.append(f"💲 {' '.join(cost_parts)}")

    # 6. Git Worktree / Branch (if present)
    worktree = data.get("worktree", {})
    wt_name = worktree.get("name") if isinstance(worktree, dict) else None
    if wt_name:
        parts.append(f"🌿 {wt_name}")

    # Determine terminal width
    term_width = data.get("terminal_width") or data.get("columns")
    if not term_width or not isinstance(term_width, int):
        if "COLUMNS" in os.environ and os.environ["COLUMNS"].isdigit():
            term_width = int(os.environ["COLUMNS"])
        else:
            try:
                term_width = shutil.get_terminal_size((100, 24)).columns
            except Exception:
                term_width = 100

    print(wrap_segments(parts, max_width=term_width, sep=" | "))

if __name__ == "__main__":
    main()
