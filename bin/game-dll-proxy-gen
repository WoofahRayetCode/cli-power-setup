#!/usr/bin/env bash
# Game DLL Proxy Generator Launcher
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TOOL_SCRIPT="${SCRIPT_DIR}/config/skills/game-dll-proxy-generator/scripts/dll_proxy_generator.py"

if [ ! -f "${TOOL_SCRIPT}" ]; then
    # Fallback if running from ~/.local/bin
    TOOL_SCRIPT="${HOME}/.gemini/config/skills/game-dll-proxy-generator/scripts/dll_proxy_generator.py"
fi

if [ ! -f "${TOOL_SCRIPT}" ]; then
    TOOL_SCRIPT="${HOME}/.claude/skills/game-dll-proxy-generator/scripts/dll_proxy_generator.py"
fi

exec python3 "${TOOL_SCRIPT}" "$@"
