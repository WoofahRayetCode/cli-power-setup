#!/usr/bin/env python3
"""local-worker: use a local Ollama model as a one-job "subagent": it drafts, a validator checks the output, failures are fed back for a retry,
and every result is logged so model choice improves by itself. Costs no cloud tokens. Claude still reviews what is applied.
  local-worker run --kind lua|python|xml|json|ltx|text|blender|edit --task "what to write" [--ctx FILE ...] [--models a,b] [--retries 2] [--out FILE]
  local-worker run --kind edit --file F --task "change X" --out F.new     revise a file, validated by its suffix (.script/.lua .py .xml .json .ltx)
  local-worker run --kind blender --task "..." --out job.py              bpy/bmesh script (only bpy, bmesh, mathutils, math, random allowed; run it yourself in headless Blender)
  local-worker batch jobs.json [--parallel auto|N]                       many different jobs; auto = hardware governor (1 while the game runs / low VRAM, RAM or high load, else 2)
  local-worker stats                 success rate / seconds per (kind, model) from ~/.cache/local-worker/runs.jsonl
  local-worker lessons               recurring validator errors per kind (feed these into the skill with skill-evolve --append-rule)
Routing: models for a kind are ranked by (ok+1)/(n+2) then speed; a model with 3 failures in a row for that kind is skipped until others have been tried.
Game-aware: uses the project's llmrun.ask (CPU only while the game runs) when available, else the Ollama HTTP API directly."""
import argparse, ast, json, os, re, subprocess, sys, tempfile, time, urllib.request
from pathlib import Path
S = Path.home() / ".cache/local-worker"; S.mkdir(parents=True, exist_ok=True); RUNS = S / "runs.jsonl"
DEFAULTS = {"lua": ["qwen2.5-coder:7b", "qwen3-coder:30b", "gpt-oss:20b", "deepseek-coder:6.7b-instruct", "qwen2.5-coder:1.5b", "qwen2.5:7b", "nemotron-3-nano:4b"], "python": ["qwen2.5-coder:7b", "qwen3-coder:30b", "gpt-oss:20b", "deepcoder:14b", "deepseek-coder:6.7b-instruct", "qwen2.5:7b", "nemotron-3-nano:4b"],
            "xml": ["qwen2.5-coder:7b", "qwen3-coder:30b", "qwen2.5:7b"], "json": ["qwen2.5-coder:7b", "qwen3-coder:30b", "qwen2.5:7b"], "ltx": ["qwen2.5-coder:7b", "qwen3-coder:30b", "qwen2.5:7b"], "text": ["qwen2.5:7b", "gpt-oss:20b", "llama3.1:8b", "gemma2:9b", "nemotron-3-nano:4b"],
            "blender": ["blender-architect:latest", "blenderllm:7b-q4", "qwen3-coder:30b", "gpt-oss:20b", "qwen2.5-coder:7b"], "edit": ["qwen2.5-coder:7b", "qwen3-coder:30b", "deepseek-coder:6.7b-instruct", "qwen2.5:7b"]}
BAD_IMPORTS = {"os", "subprocess", "socket", "shutil", "urllib", "requests", "ctypes", "sys", "pathlib"}   # a Blender worker script may only build geometry
SUFFIX_KIND = {".lua": "lua", ".script": "lua", ".py": "python", ".xml": "xml", ".json": "json", ".ltx": "ltx"}
def installed():
    out = set()
    for port in (11434, 11435):
        try: out |= {m["name"] for m in json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/api/tags", timeout=3))["models"]}
        except Exception: pass
    return out
def ask(model, prompt):
    pr = os.environ.get("LLMRUN_DIR") or str(Path.home() / "Documents/GitHub/ogsr-complete-merge/tools")
    if (Path(pr) / "llmrun.py").exists():
        sys.path.insert(0, pr); import llmrun; return llmrun.ask(model, prompt, timeout=900)
    body = json.dumps({"model": model, "prompt": prompt, "stream": False}).encode()
    return json.load(urllib.request.urlopen(urllib.request.Request("http://127.0.0.1:11434/api/generate", body, {"Content-Type": "application/json"}), timeout=900))["response"]
def strip(t):
    m = re.search(r"```[a-zA-Z]*\n(.*?)```", t, re.S)
    return (m.group(1) if m else t).strip() + "\n"
def validate(kind, code):
    """returns None when fine, else the error text to feed back"""
    if not code.strip(): return "empty output"
    try:
        if kind == "lua":
            with tempfile.NamedTemporaryFile("w", suffix=".lua", delete=False) as f: f.write(code)
            r = subprocess.run(["luajit", "-bl", f.name], capture_output=True, text=True); os.unlink(f.name)
            return None if r.returncode == 0 else r.stderr.strip()[:400]
        if kind == "blender":
            tree = ast.parse(code); bad = sorted({(n.module or "").split(".")[0] if isinstance(n, ast.ImportFrom) else a.name.split(".")[0] for n in ast.walk(tree) if isinstance(n, (ast.Import, ast.ImportFrom)) for a in (n.names if isinstance(n, ast.Import) else [n])} & BAD_IMPORTS)
            if bad: return f"forbidden import(s) {bad}: a Blender worker script may only use bpy, bmesh, mathutils, math, random"
            if "bpy" not in code: return "the script never uses bpy"
        elif kind == "python": ast.parse(code)
        elif kind == "json": json.loads(code)
        elif kind == "xml":
            import xml.etree.ElementTree as ET; ET.fromstring(code)
        elif kind == "ltx":
            for i, l in enumerate(code.splitlines(), 1):
                s = l.strip()
                if s and not s.startswith(";") and not re.match(r"^(\[[\w\.\-@]+\](\s*:\s*[\w,\s\.\-]+)?|[\w\.\-]+\s*(=.*)?)$", s): return f"line {i} is not valid LTX: {s[:60]}"
    except Exception as e: return f"{type(e).__name__}: {e}"[:400]
    return None
def stats():
    st = {}
    if RUNS.exists():
        for l in RUNS.read_text().splitlines():
            try: r = json.loads(l)
            except Exception: continue
            e = st.setdefault((r["kind"], r["model"]), {"n": 0, "ok": 0, "s": 0.0, "streak": 0}); e["n"] += 1; e["ok"] += r["ok"]; e["s"] += r["sec"]; e["streak"] = 0 if r["ok"] else e["streak"] + 1
    return st
NEW_MODELS = {"qwen3-coder:30b", "gpt-oss:20b", "deepcoder:14b", "qwen3-vl:8b"}     # added 2026-10-18 without a separate test: they learn their rank from real jobs
def rank(kind, models):
    st = stats(); have = installed()
    def key(m):
        e = st.get((kind, m), {"n": 0, "ok": 0, "s": 0, "streak": 0})
        score = 0.8 if e["n"] < 3 and m in NEW_MODELS else (e["ok"] + 1) / (e["n"] + 2)      # new models are tried first (optimism) until they have 3 logged runs, then the real pass rate decides
        return (e["streak"] >= 3, -score, e["s"] / max(1, e["n"]))
    return sorted([m for m in models if m in have or not have], key=key)
def auto_parallel():
    """How many workers this laptop can take right now (RTX 5060 8 GB, 32 threads, 30 GB RAM; the game and the night walk come first):
    game running -> 1 (CPU-only models share cores with it); less than 5 GB free VRAM or 8 GB free RAM -> 1; load above 70 % of the threads -> 1; else 2 (one per Ollama server)."""
    try:
        if subprocess.run("pgrep -f '[x]rEngine.exe -nointro' >/dev/null", shell=True).returncode == 0: return 1
        free_mb = int(subprocess.run(["nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits"], capture_output=True, text=True).stdout.split()[0])
        mem_kb = int([l for l in open("/proc/meminfo") if l.startswith("MemAvailable")][0].split()[1])
        if free_mb < 5000 or mem_kb < 8 * 1024 * 1024 or os.getloadavg()[0] > 0.7 * (os.cpu_count() or 8): return 1
    except Exception: return 1
    return 2
HINTS = {"ltx": "LTX format (S.T.A.L.K.E.R. config): a section header is `[name]` or `[name]:parent` on its own line (the colon comes AFTER the bracket, e.g. `[zf_test]:parent`), then `key = value` lines; comments start with `;`. No other syntax, no markdown.",
         "xml": "Output well-formed XML only, one root element, every tag closed.", "json": "Output valid JSON only (double quotes, no trailing commas, no comments).",
         "lua": "Lua 5.1 / LuaJIT only (no goto, no integer division //, no bit operators; use bit.band etc.). Comments start with --."}
def run(a):
    if a.kind == "edit":
        if not a.file: sys.exit("local-worker: --kind edit needs --file FILE (the file to revise)")
        a.target_kind = SUFFIX_KIND.get(Path(a.file).suffix, "text"); a.ctx = (a.ctx or []) + [a.file]
        a.task = f"Revise the file {Path(a.file).name} as follows and output the COMPLETE revised file: {a.task}"
    try: learned = json.loads((S / "lessons.json").read_text()).get(a.kind, [])[:5]
    except Exception: learned = []
    fb0 = ("\nKnown pitfalls from earlier failed runs of this kind (avoid them):\n" + "\n".join("- " + x for x in learned) + "\n") if learned else ""
    ctx = "".join(f"\n--- {p} ---\n{Path(p).read_text(errors='replace')[:6000]}\n" for p in (a.ctx or []))
    models = rank(a.kind, a.models.split(",") if a.models else DEFAULTS[a.kind]); fb = fb0
    if not models: sys.exit("local-worker: no installed model for this kind")
    for attempt in range(a.retries + 1):
        m = models[min(attempt, len(models) - 1)]; t0 = time.time()
        prompt = f"You are a precise {a.kind} code generator. Output ONLY the {a.kind} content, no explanations.\n{HINTS.get(getattr(a, 'target_kind', a.kind), '')}\nTask: {a.task}\n{ctx}{fb}"
        try: code = strip(ask(m, prompt)); err = validate(getattr(a, "target_kind", a.kind), code)
        except Exception as e: code, err = "", f"model call failed: {e}"
        if len(RUNS.read_text().splitlines()) % 5 == 0 if RUNS.exists() else False:
            try: evolve()
            except Exception: pass
        open(RUNS, "a").write(json.dumps({"t": time.strftime("%F %T"), "kind": a.kind, "model": m, "ok": int(err is None), "sec": round(time.time() - t0, 1), "err": err, "task": a.task[:80], "attempt": attempt + 1, "out_head": code[:160], "out_len": len(code), "ctx_files": len(a.ctx or []), "load": round(os.getloadavg()[0], 1), "mem_free_gb": round(int([l for l in open("/proc/meminfo") if l.startswith("MemAvailable")][0].split()[1]) / 1048576, 1), "game": subprocess.run("pgrep -f '[x]rEngine.exe' >/dev/null", shell=True).returncode == 0}) + "\n")
        if err is None:
            try:                                                         # every VALIDATED output is training data for our own small model (docs/learn/sft_dataset.jsonl)
                sft = Path.home() / "Documents/GitHub/ogsr-complete-merge/docs/learn/sft_dataset.jsonl"; sft.parent.mkdir(exist_ok=True)
                open(sft, "a").write(json.dumps({"kind": a.kind, "task": a.task, "ctx": ctx[:3000], "output": code, "model": m, "attempt": attempt + 1}) + "\n")
            except Exception: pass
            if a.out: Path(a.out).write_text(code)
            else: print(code)
            print(f"[local-worker ok model={m} attempt={attempt + 1}]", file=sys.stderr); return 0
        fb = f"\nYour previous answer failed validation: {err}\nFix it and output the complete corrected {a.kind} again.\n"
    print(f"[local-worker FAILED after {a.retries + 1} attempts: {err}]", file=sys.stderr); return 1
SKILL = Path.home() / ".claude/skills/local-model-subagent-workers/SKILL.md"
def evolve():
    """Self-improvement: validator errors that repeat (3+ times per kind) become 'Learned pitfalls' lines in the skill, and the best model per kind is recorded. Idempotent."""
    from collections import Counter
    c = Counter()
    for l in (RUNS.read_text().splitlines() if RUNS.exists() else []):
        r = json.loads(l)
        if r.get("err"): c[(r["kind"], re.sub(r"\d+", "N", r["err"]).split(":")[0][:80] + (" (e.g. " + r["err"].split(":", 1)[1].strip()[:50] + ")" if ":" in r["err"] else ""))] += 1
    st = stats(); best = {}
    for (k, m), e in st.items():
        if e["n"] >= 3 and (k not in best or (e["ok"] + 1) / (e["n"] + 2) > best[k][1]): best[k] = (m, (e["ok"] + 1) / (e["n"] + 2))
    les = {}
    for (k, e), n in c.most_common():
        if n >= 2: les.setdefault(k, []).append(f"the validator rejected output with: {e} (seen {n}x)")
    (S / "lessons.json").write_text(json.dumps(les))
    lines = [f"- [{k}] validator error seen {n}x: `{e}` -> mention how to avoid it in the task text" for (k, e), n in c.most_common() if n >= 3]
    lines += [f"- best model so far for {k}: `{m}` (score {sc:.2f})" for k, (m, sc) in sorted(best.items())]
    if not SKILL.exists(): return print("skill file missing:", SKILL)
    txt = SKILL.read_text(); head = txt.split("## Learned pitfalls (auto)")[0].rstrip() + "\n\n## Learned pitfalls (auto)\n"
    SKILL.write_text(head + ("\n".join(lines) if lines else "(none yet)") + "\n"); print(f"skill updated: {len(lines)} lines")
def status():
    """compact text for the status window: running workers with their resource use, loaded models (VRAM/RAM), GPU, last results, governor"""
    ps = subprocess.run("ps -eww -eo pid,pcpu,rss,etimes,args | grep -E 'local-worker (run|batch)' | grep -v grep", shell=True, capture_output=True, text=True).stdout.splitlines()
    print(f"workers running: {len(ps)}   parallel now: {auto_parallel()}")
    for l in ps[:4]:
        f = l.split(None, 4); kind = (re.search(r"--kind (\w+)", f[4]) or re.search(r"(batch)", f[4]) or [0, "?"])[1]
        el = int(f[3]); m = re.search(r"--task (.*?)(?: --\w+|$)", f[4]); task = m.group(1) if m else ""
        print(f" #{f[0]} {kind:7} {el // 60}:{el % 60:02d} cpu {float(f[1]):3.0f}% ram {int(f[2]) // 1024}MB")
        if task: print(f"   > {task[:70]}")
    tot_cpu = subprocess.run("ps -eo pcpu,args | grep -E 'ollama|llama-server' | grep -v grep | awk '{s+=$1} END {print int(s)}'", shell=True, capture_output=True, text=True).stdout.strip() or "0"
    for port in (11434, 11435):
        try:
            for m in json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/api/ps", timeout=2))["models"]:
                vram, tot = m.get("size_vram", 0) / 2**30, m.get("size", 0) / 2**30
                print(f" model {m['name'][:24]} :{port}  VRAM {vram:.1f} GB / RAM {tot - vram:.1f} GB")
        except Exception: pass
    print(f"ollama cpu {tot_cpu}% (100% = 1 thread of {os.cpu_count()})")
    try:
        g = subprocess.run(["nvidia-smi", "--query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu", "--format=csv,noheader,nounits"], capture_output=True, text=True).stdout.split(",")
        print(f"GPU {g[0].strip()}%  VRAM {int(g[1]) / 1024:.1f}/{int(g[2]) / 1024:.1f} GB  {g[3].strip()}C")
    except Exception: pass
    rows = [json.loads(l) for l in RUNS.read_text().splitlines()[-200:]] if RUNS.exists() else []
    ok = sum(r["ok"] for r in rows)
    print(f"last {len(rows)} jobs: {ok} ok, {len(rows) - ok} failed")
    for r in rows[-3:]: print(f" {r['t'][11:16]} {r['kind']:7} {r['model'].split(':')[0][:16]:16} {'ok' if r['ok'] else 'FAIL'} {r['sec']:.0f}s")
def main():
    p = argparse.ArgumentParser(); sub = p.add_subparsers(dest="c", required=True)
    r = sub.add_parser("run"); r.add_argument("--kind", required=True, choices=list(DEFAULTS)); r.add_argument("--task", required=True); r.add_argument("--ctx", nargs="*"); r.add_argument("--models"); r.add_argument("--retries", type=int, default=2); r.add_argument("--out"); r.add_argument("--file")
    b = sub.add_parser("batch"); b.add_argument("jobs", help="JSON file: a list of {kind, task, out, ctx?, file?, models?}"); b.add_argument("--parallel", default="auto", help="auto (hardware governor), or a number")
    sub.add_parser("stats"); sub.add_parser("lessons"); sub.add_parser("evolve"); sub.add_parser("status"); a = p.parse_args()
    if a.c == "run": sys.exit(run(a))
    if a.c == "evolve": return evolve()
    if a.c == "status": return status()
    if a.c == "batch":
        from concurrent.futures import ThreadPoolExecutor
        def one(j):
            r = subprocess.run([sys.argv[0], "run", "--kind", j["kind"], "--task", j["task"], "--out", j["out"]] + (["--file", j["file"]] if j.get("file") else []) + (["--ctx"] + j["ctx"] if j.get("ctx") else []) + (["--models", j["models"]] if j.get("models") else []), capture_output=True, text=True)
            return f"{'ok  ' if r.returncode == 0 else 'FAIL'} {j['kind']:7} -> {j['out']}  {r.stderr.strip().splitlines()[-1] if r.stderr.strip() else ''}"
        n = auto_parallel() if a.parallel == "auto" else max(1, int(a.parallel)); print(f"[local-worker batch: {n} at a time]", file=sys.stderr)
        with ThreadPoolExecutor(n) as ex:
            for line in ex.map(one, json.load(open(a.jobs))): print(line)
        return
    if a.c == "stats":
        for (k, m), e in sorted(stats().items()): print(f"{k:7} {m:34} ok {e['ok']}/{e['n']}  avg {e['s'] / e['n']:.0f}s  fail-streak {e['streak']}")
    else:
        from collections import Counter
        c = Counter()
        for l in (RUNS.read_text().splitlines() if RUNS.exists() else []):
            r = json.loads(l)
            if r.get("err"): c[(r["kind"], re.sub(r"\d+", "N", r["err"])[:90])] += 1
        for (k, e), n in c.most_common(10): print(f"{n:3}x {k}: {e}")
main()
