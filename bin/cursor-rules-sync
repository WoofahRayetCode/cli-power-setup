#!/usr/bin/env python3
"""
Cursor Rules Synchronizer (cursor-rules-sync)
Converts and synchronizes all skills and discipline rules into Cursor Rules (.mdc)
and unified .cursorrules for seamless operation with xAI Grok, Claude, OpenAI, and DeepSeek.
"""

import sys
import os
import shutil
from pathlib import Path

REPO_DIR = Path("/home/ericparsley/Documents/GitHub/cli-power-setup")
SKILLS_DIR = REPO_DIR / "config/skills"
CONFIG_CURSOR_DIR = REPO_DIR / "config/cursor"
CONFIG_CURSOR_RULES = CONFIG_CURSOR_DIR / "rules"
REPO_CURSOR_RULES = REPO_DIR / ".cursor/rules"
USER_CURSOR_DIR = Path.home() / ".cursor"
USER_CURSOR_RULES = USER_CURSOR_DIR / "rules"
USER_CURSORRULES = Path.home() / ".cursorrules"
REPO_CURSORRULES = REPO_DIR / ".cursorrules"

def parse_skill(skill_md: Path) -> tuple:
    """Parses frontmatter and body from a SKILL.md file."""
    content = skill_md.read_text(encoding="utf-8", errors="ignore")
    lines = content.splitlines()
    if not (lines and lines[0].strip() == "---"):
        return {}, content
    
    meta = {}
    end_idx = 1
    for i, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            end_idx = i
            break
        if ":" in line:
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip()
            
    body = "\n".join(lines[end_idx + 1:]).strip()
    return meta, body

def sync_cursor():
    print("[→] Generating Cursor rules and multi-model configurations...")
    CONFIG_CURSOR_RULES.mkdir(parents=True, exist_ok=True)
    REPO_CURSOR_RULES.mkdir(parents=True, exist_ok=True)
    USER_CURSOR_RULES.mkdir(parents=True, exist_ok=True)

    # 1. Copy core rules
    core_discipline = CONFIG_CURSOR_DIR / "000-cursor-global-discipline.mdc"
    core_multimodel = CONFIG_CURSOR_DIR / "001-multi-model-optimization.mdc"

    if core_discipline.exists():
        shutil.copy2(core_discipline, CONFIG_CURSOR_RULES / "000-cursor-global-discipline.mdc")
        shutil.copy2(core_discipline, REPO_CURSOR_RULES / "000-cursor-global-discipline.mdc")
        shutil.copy2(core_discipline, USER_CURSOR_RULES / "000-cursor-global-discipline.mdc")

    if core_multimodel.exists():
        shutil.copy2(core_multimodel, CONFIG_CURSOR_RULES / "001-multi-model-optimization.mdc")
        shutil.copy2(core_multimodel, REPO_CURSOR_RULES / "001-multi-model-optimization.mdc")
        shutil.copy2(core_multimodel, USER_CURSOR_RULES / "001-multi-model-optimization.mdc")

    # 2. Convert all 157 skills to .mdc format
    skill_entries = []
    converted_count = 0
    for skill_path in sorted(SKILLS_DIR.iterdir()):
        if not skill_path.is_dir():
            continue
        skill_name = skill_path.name
        skill_md = skill_path / "SKILL.md"
        if not skill_md.exists():
            continue

        meta, body = parse_skill(skill_md)
        description = meta.get("description", f"Instructions and best practices for {skill_name}")
        skill_entries.append((skill_name, description))

        mdc_content = f"""---
description: {description}
globs: 
alwaysApply: false
---

{body}
"""
        mdc_file = CONFIG_CURSOR_RULES / f"{skill_name}.mdc"
        mdc_file.write_text(mdc_content, encoding="utf-8")
        shutil.copy2(mdc_file, REPO_CURSOR_RULES / f"{skill_name}.mdc")
        shutil.copy2(mdc_file, USER_CURSOR_RULES / f"{skill_name}.mdc")
        converted_count += 1

    # 3. Generate unified .cursorrules file
    discipline_text = core_discipline.read_text(encoding="utf-8") if core_discipline.exists() else ""
    multimodel_text = core_multimodel.read_text(encoding="utf-8") if core_multimodel.exists() else ""

    # Strip YAML frontmatter from text for .cursorrules
    def strip_frontmatter(txt):
        lines = txt.splitlines()
        if lines and lines[0].strip() == "---":
            for i, line in enumerate(lines[1:], start=1):
                if line.strip() == "---":
                    return "\n".join(lines[i+1:]).strip()
        return txt

    clean_discipline = strip_frontmatter(discipline_text)
    clean_multimodel = strip_frontmatter(multimodel_text)

    skills_table_rows = "\n".join([f"| **`{s}`** | {d} |" for s, d in skill_entries])

    cursorrules_content = f"""# Cursor AI Unified Rules & Multi-Model Power Configuration

{clean_discipline}

---

{clean_multimodel}

---

## Complete Skills Catalog ({converted_count} Specialized Capabilities)
All skills below are also indexed individually as modular rules in `.cursor/rules/<skill-name>.mdc`. When tackling any relevant task, invoke the corresponding workflows, scripts in `~/.local/bin/`, or reference specifications:

| Skill | Capabilities & When to Use |
| :--- | :--- |
{skills_table_rows}
"""
    (CONFIG_CURSOR_DIR / ".cursorrules").write_text(cursorrules_content, encoding="utf-8")
    REPO_CURSORRULES.write_text(cursorrules_content, encoding="utf-8")
    USER_CURSORRULES.write_text(cursorrules_content, encoding="utf-8")

    print(f"[✓] Successfully generated {converted_count} Cursor .mdc skill rules.")
    print(f"[✓] Synchronized .cursor/rules in repo ({REPO_CURSOR_RULES}) and user profile ({USER_CURSOR_RULES}).")
    print(f"[✓] Deployed unified .cursorrules to {USER_CURSORRULES} and {REPO_CURSORRULES}.")
    return 0

if __name__ == "__main__":
    sys.exit(sync_cursor())
