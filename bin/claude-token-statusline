#!/usr/bin/env python3
"""Claude Code status line: measured token usage, prompt-cache savings, and the global token ledger.

Every number shown is read from real data:
  * Claude Code transcripts (~/.claude/projects/**/*.jsonl, per-API-call `usage` blocks, de-duplicated by message id)
  * the status-line JSON Claude Code pipes on stdin (model, cost, context window, rate limits when present)
  * ~/.cli_power_setup/token_ledger.json (the global all-time ledger; this script also records Claude Code totals into it)

"cache-read" tokens are input tokens served from the prompt cache, billed at 10% of the base input rate,
so 90% of their input cost is saved. Local-LLM savings in the ledger are estimates written by local-coprocessor.

Usage:
  claude-token-statusline            # status line mode (reads JSON on stdin)
  claude-token-statusline --ledger   # print the global all-time ledger
"""

from __future__ import annotations

import fcntl
import json
import os
import sys
import tempfile
from datetime import datetime
from pathlib import Path

PROJECTS = Path.home() / ".claude" / "projects"
STATE_DIR = Path.home() / ".cache" / "claude-token-statusline"
STATE_FILE = STATE_DIR / "state.json"
LEDGER = Path.home() / ".cli_power_setup" / "token_ledger.json"
LEDGER_LOCK = Path.home() / ".cli_power_setup" / ".token_ledger.lock"
KEYS = ("input", "cache_write", "cache_read", "output", "calls")


def fmt(n: float) -> str:
    n = float(n)
    for div, suf in ((1e9, "B"), (1e6, "M"), (1e3, "k")):
        if abs(n) >= div:
            v = n / div
            return f"{v:.1f}{suf}" if v < 100 else f"{v:.0f}{suf}"
    return f"{int(n)}"


def load_json(p: Path, default):
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return default


def atomic_write_json(p: Path, data) -> None:
    p.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(p.parent), prefix=p.name + ".")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, os.path.realpath(p))


def scan_transcripts(state: dict) -> bool:
    """Incrementally fold new transcript lines into per-file totals. Returns True if anything changed."""
    files = state.setdefault("files", {})
    changed = False
    for path in PROJECTS.glob("**/*.jsonl"):
        key = str(path)
        try:
            size = path.stat().st_size
        except OSError:
            continue
        ent = files.get(key)
        if ent is None or size < ent.get("offset", 0):  # new or truncated/rewritten file
            ent = {"offset": 0, "ids": [], "model": "", "last_ctx": 0, **{k: 0 for k in KEYS}}
            files[key] = ent
        if size == ent["offset"]:
            continue
        with open(path, "rb") as f:
            f.seek(ent["offset"])
            chunk = f.read(size - ent["offset"])
        end = chunk.rfind(b"\n")
        if end < 0:
            continue
        seen = set(ent["ids"])
        for raw in chunk[: end + 1].splitlines():
            if b'"usage"' not in raw:
                continue
            try:
                row = json.loads(raw)
            except ValueError:
                continue
            msg = row.get("message")
            if row.get("type") != "assistant" or not isinstance(msg, dict):
                continue
            u = msg.get("usage") or {}
            mid = msg.get("id") or row.get("requestId")
            if not u or mid in seen:
                continue  # one API call is written as several lines (one per content block)
            seen.add(mid)
            ent["ids"].append(mid)
            ent["input"] += u.get("input_tokens", 0) or 0
            ent["cache_write"] += u.get("cache_creation_input_tokens", 0) or 0
            ent["cache_read"] += u.get("cache_read_input_tokens", 0) or 0
            ent["output"] += u.get("output_tokens", 0) or 0
            ent["calls"] += 1
            ent["model"] = msg.get("model") or ent["model"]
            if not row.get("isSidechain"):
                ent["last_ctx"] = (u.get("input_tokens", 0) or 0) + (u.get("cache_creation_input_tokens", 0) or 0) + (
                    u.get("cache_read_input_tokens", 0) or 0)
        ent["ids"] = ent["ids"][-200:]
        ent["offset"] += end + 1
        changed = True
    return changed


def sum_entries(entries) -> dict:
    tot = {k: 0 for k in KEYS}
    for e in entries:
        for k in KEYS:
            tot[k] += e.get(k, 0)
    return tot


def session_entries(state: dict, transcript: str):
    if not transcript:
        return []
    base = transcript[:-6] if transcript.endswith(".jsonl") else transcript
    return [e for p, e in state["files"].items() if p == transcript or p.startswith(base + os.sep)]


def record_in_ledger(all_time: dict, sessions: int) -> dict:
    """Store measured Claude Code totals in the global ledger (under its own key, never mixed with estimates)."""
    LEDGER_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(LEDGER_LOCK, "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        ld = load_json(LEDGER, {})
        cc = {
            "source": "measured: Claude Code transcript usage blocks (~/.claude/projects)",
            "sessions_tracked": sessions,
            "api_calls": all_time["calls"],
            "uncached_input_tokens": all_time["input"],
            "cache_write_tokens": all_time["cache_write"],
            "cache_read_tokens": all_time["cache_read"],
            "output_tokens": all_time["output"],
            "cache_hit_rate_pct": round(100.0 * all_time["cache_read"] / max(1, all_time["input"] + all_time["cache_write"] + all_time["cache_read"]), 2),
        }
        old = {k: v for k, v in ld.get("claude_code", {}).items() if k != "last_updated"}
        if old != cc:
            cc["last_updated"] = datetime.now().isoformat(timespec="seconds")
            ld["claude_code"] = cc
            atomic_write_json(LEDGER, ld)
        return ld


def ledger_global(ld: dict) -> dict:
    cc = ld.get("claude_code", {})
    return {
        "claude_cache": cc.get("cache_read_tokens", 0),
        "local_est": ld.get("local_llm_savings", {}).get("total_cloud_tokens_saved", 0),
    }


def bar(pct: float, width: int = 10) -> str:
    n = max(0, min(width, round(width * pct / 100.0)))
    return "▰" * n + "▱" * (width - n)


def status_line(inp: dict) -> str:
    state = load_json(STATE_FILE, {})
    state.setdefault("files", {})
    if scan_transcripts(state):
        atomic_write_json(STATE_FILE, state)
    all_time = sum_entries(state["files"].values())
    main_files = [p for p in state["files"] if "/subagents/" not in p]
    try:
        ld = record_in_ledger(all_time, len(main_files))
    except Exception:
        ld = load_json(LEDGER, {})

    transcript = inp.get("transcript_path") or ""
    sess_list = session_entries(state, transcript)
    sess = sum_entries(sess_list)
    main = state["files"].get(transcript, {})

    model = (inp.get("model") or {}).get("display_name") or main.get("model") or "Claude"
    parts1 = [f"⚡ {model}"]

    cw = inp.get("context_window") or {}
    size = cw.get("context_window_size") or 0
    cur = cw.get("current_usage") or {}
    ctx = sum(cur.get(k, 0) or 0 for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens")) if cur else main.get("last_ctx", 0)
    if size:
        pct = cw.get("used_percentage")
        pct = float(pct) if pct is not None else 100.0 * ctx / size
        parts1.append(f"ctx {bar(pct)} {pct:.0f}% ({fmt(ctx)}/{fmt(size)})")
    elif ctx:
        parts1.append(f"ctx {fmt(ctx)}")

    rl = inp.get("rate_limits") or {}
    lims = []
    for key, label in (("five_hour", "5h"), ("seven_day", "7d")):
        v = rl.get(key) or {}
        p = v.get("used_percentage", v.get("utilization"))
        if p is not None:
            lims.append(f"{label} {float(p):.0f}%")
    if lims:
        parts1.append(" · ".join(lims))

    cost = (inp.get("cost") or {}).get("total_cost_usd")
    if cost is not None:
        parts1.append(f"${cost:.2f}")

    tot_in = sess["input"] + sess["cache_write"] + sess["cache_read"]
    hit = 100.0 * sess["cache_read"] / tot_in if tot_in else 0.0
    parts2 = [
        f"💾 session in {fmt(tot_in)} · out {fmt(sess['output'])} · ♻ cached {fmt(sess['cache_read'])} ({hit:.0f}%, -90% cost)",
    ]
    g = ledger_global(ld)
    parts2.append(f"🌐 ledger ♻ {fmt(g['claude_cache'])} all-time")
    return " │ ".join(parts1) + "\n" + " │ ".join(parts2)


def print_ledger() -> None:
    state = load_json(STATE_FILE, {})
    state.setdefault("files", {})
    if scan_transcripts(state):
        atomic_write_json(STATE_FILE, state)
    all_time = sum_entries(state["files"].values())
    ld = record_in_ledger(all_time, len([p for p in state["files"] if "/subagents/" not in p]))
    cc = ld.get("claude_code", {})
    loc = ld.get("local_llm_savings", {})
    print(f"Global token ledger: {os.path.realpath(LEDGER)}\n")
    print("Claude Code (measured from transcripts)")
    print(f"  sessions {cc.get('sessions_tracked', 0)} · API calls {cc.get('api_calls', 0):,}")
    print(f"  cache-read {cc.get('cache_read_tokens', 0):,} · cache-write {cc.get('cache_write_tokens', 0):,} · uncached in {cc.get('uncached_input_tokens', 0):,} · out {cc.get('output_tokens', 0):,}")
    print(f"  cache hit rate {cc.get('cache_hit_rate_pct', 0)}% · input-token cost avoided ≈ {int(0.9 * cc.get('cache_read_tokens', 0)):,} token-equivalents\n")
    print("Local LLM offload (estimates written by local-coprocessor, not measured cloud usage)")
    print(f"  calls {loc.get('total_calls', 0)} · local tokens {loc.get('total_local_tokens', 0):,} · est. cloud tokens saved {loc.get('total_cloud_tokens_saved', 0):,}")
    for m, v in sorted(loc.get("by_model", {}).items(), key=lambda kv: -kv[1].get("cloud_tokens_saved", 0)):
        print(f"    {m:30s} {v.get('cloud_tokens_saved', 0):>9,} est. saved · {v.get('calls', 0)} calls")


def main() -> int:
    if "--ledger" in sys.argv[1:]:
        print_ledger()
        return 0
    try:
        inp = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        inp = {}
    try:
        print(status_line(inp))
    except Exception as e:  # never break the prompt
        print(f"⚡ status line error: {e}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
