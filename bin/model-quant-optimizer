def get_hardware_telemetry() -> dict[str, Any]:
    hw = {
        "cpu_threads": os.cpu_count() or 32,
        "ram_gb": 30.4,
        "vram_mb": 8151,
        "vram_free_mb": 6700,
        "nvme_free_gb": 523
    }
    try:
        with open("/proc/meminfo") as f:
            for l in f:
                if l.startswith("MemTotal:"):
                    hw["ram_gb"] = round(int(l.split()[1]) / (1024 * 1024), 1)
                    break
    except Exception:
        pass
    try:
        out = subprocess.check_output(
            ["nvidia-smi", "--query-gpu=memory.total,memory.free", "--format=csv,noheader,nounits"],
            text=True, stderr=subprocess.DEVNULL
        ).strip().splitlines()[0]
        parts = [int(p.strip()) for p in out.split(",")]
        hw["vram_mb"] = parts[0]
        hw["vram_free_mb"] = parts[1]
    except Exception:
        pass
    try:
        df_out = subprocess.check_output(["df", "-k", "/var/lib/ollama"], text=True, stderr=subprocess.DEVNULL)
        lines = df_out.strip().splitlines()
        if len(lines) >= 2:
            hw["nvme_free_gb"] = round(int(lines[1].split()[3]) / (1024 * 1024), 1)
    except Exception:
        pass
    return hw


def generate_modelfile(model_key: str) -> str:
    m = CURATED_ULTRA_MODELS.get(model_key)
    if not m:
        return ""
    return f"""# Modelfile for {m['name']} ({m['recommended_quant']})
# Hardware target: 32 CPU Threads + 30GB RAM + 8GB RTX 5060 VRAM
FROM {m['ollama_hf_pull']}

# Context & Memory Optimization
PARAMETER num_ctx 32768
PARAMETER num_predict 4096
PARAMETER num_thread 32
PARAMETER num_gpu 33
PARAMETER temperature 0.2

SYSTEM \"\"\"You are an expert low-level systems, reverse engineering, and software architecture intelligence.
You reason step-by-step, verify byte alignments, pointer arithmetic, and struct layouts formally,
and provide deterministic, high-density C++20 and decompiled code reconstructions.
Omit conversational filler, preambles, and speculative monologues.\"\"\"
"""


def main():
    parser = argparse.ArgumentParser(description="Model Quantization Optimizer - Ultra-Large Model Hardware Planner")
    parser.add_argument("--list", "-l", action="store_true", help="List curated ultra-large models (70B-405B) for this machine")
    parser.add_argument("--modelfile", "-m", choices=list(CURATED_ULTRA_MODELS.keys()), help="Generate Modelfile for target model")
    parser.add_argument("--airllm-script", action="store_true", help="Generate ready-to-run AirLLM Python layer-streaming script for 405B")
    parser.add_argument("--check", "-c", action="store_true", help="Check system hardware capability for running ultra-large models")
    parser.add_argument("--json", action="store_true", help="Output JSON telemetry")

    args = parser.parse_args()
    hw = get_hardware_telemetry()

    if args.json:
        payload = {
            "hardware": hw,
            "curated_models": CURATED_ULTRA_MODELS
        }
        print(json.dumps(payload, indent=2))
        return

    if args.modelfile:
        mf = generate_modelfile(args.modelfile)
        print(mf)
        return

    if args.airllm_script:
        script = """#!/usr/bin/env python3
\"\"\"
AirLLM 405B Layer-Streaming Runner
Runs Meta-Llama-3.1-405B on an 8GB RTX 5060 by streaming transformer layers from NVMe SSD.
Install prerequisites: pip install airllm torch transformers
\"\"\"
from airllm import AutoModel
import time

print("[🚀 AirLLM] Initializing Meta-Llama-3.1-405B Layer-Wise Streaming...")
model = AutoModel.from_pretrained(
    "meta-llama/Meta-Llama-3.1-405B-Instruct",
    compression="4bit", # Compresses layer weights on NVMe
    device_map="auto"
)

prompt = "Analyze this binary procedure assembly and prove the struct alignment invariant:"
input_text = f"<|start_header_id|>user<|end_header_id|>\\n\\n{prompt}<|eot_id|><|start_header_id|>assistant<|end_header_id|>\\n\\n"

print("[⚡] Generating inference across 405 billion parameters...")
t0 = time.time()
output = model.generate(
    [input_text],
    max_new_tokens=256,
    use_cache=True
)
elapsed = time.time() - t0
print(f"[✓] Completed in {elapsed:.1f}s:\\n")
print(output[0])
"""
        print(script)
        return

    print(f"\n{BOLD}═══════════════════════════════════════════════════════════════{RESET}")
    print(f"{CYAN}{BOLD}  🚀 ULTRA-LARGE MODEL HARDWARE & QUANTIZATION OPTIMIZER{RESET}")
    print(f"{BOLD}═══════════════════════════════════════════════════════════════{RESET}\n")

    print(f"  💻 {BOLD}Host Hardware Profile:{RESET}")
    print(f"     • CPU Compute       : {GREEN}{hw['cpu_threads']} Threads (AMD Zen AVX2 / AVX-512){RESET}")
    print(f"     • System Memory     : {GREEN}{hw['ram_gb']} GB DDR5 RAM{RESET}")
    print(f"     • GPU Acceleration  : {GREEN}NVIDIA RTX 5060 ({hw['vram_mb']} MB GDDR7, {hw['vram_free_mb']} MB free){RESET}")
    print(f"     • NVMe SSD Storage  : {GREEN}{hw['nvme_free_gb']} GB Free (~7,000 MB/s Gen4 Read){RESET}\n")

    print(f"{BOLD}🎯 Supported Ultra-Large Model Architectures on This System:{RESET}\n")

    for k, m in CURATED_ULTRA_MODELS.items():
        fits = m['weights_ram_gb'] <= (hw['ram_gb'] - 3.0)
        status_tag = f"{GREEN}[FITS 100% IN RAM]{RESET}" if fits else f"{YELLOW}[NVMe STREAMING REQUIRED]{RESET}"
        print(f"  • {BOLD}{m['name']}{RESET} ({CYAN}{m['params']}{RESET}) - {status_tag}")
        print(f"    - Role         : {m['type']}")
        print(f"    - Optimal Quant: {MAGENTA}{m['recommended_quant']}{RESET} (RAM Footprint: ~{m['weights_ram_gb']} GB)")
        print(f"    - Strategy     : {m['strategy']}")
        print(f"    - Direct Run   : {DIM}`ollama run {m['ollama_hf_pull']}`{RESET}\n")

    print(f"{BOLD}💡 Key Techniques Enabling Ultra-Large Models on This Laptop:{RESET}")
    print("  1. " + BOLD + "Importance Matrix (imatrix) Quantization (IQ2_XXS/IQ2_XS):" + RESET + " Calibrates weight importance on real code, shrinking 70B models from 140GB down to ~22GB RAM.")
    print("  2. " + BOLD + "Sparse Mixture-of-Experts (MoE):" + RESET + " Models like DeepSeek-Coder-V2 (236B) calculate only 21B active weights per token, running 10x faster.")
    print("  3. " + BOLD + "AirLLM Layer-Wise NVMe Streaming:" + RESET + " Streams single transformer blocks from PCIe Gen4 SSD into 8GB VRAM on demand, unlocking 405B models.")
    print("  4. " + BOLD + "Quantized KV Cache (q4_0):" + RESET + " Reduces 32k context memory by 75% in Ollama, preventing out-of-memory errors.\n")


if __name__ == "__main__":
    main()
