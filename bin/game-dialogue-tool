#!/usr/bin/env bash
# Game Dialogue & Conversation UI Localization Tool Launcher
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TOOL_SCRIPT="${SCRIPT_DIR}/config/skills/game-dialogue-ui-localization/scripts/dialogue_tool.py"

if [ ! -f "${TOOL_SCRIPT}" ]; then
    # Fallback if running from ~/.local/bin
    TOOL_SCRIPT="${HOME}/.gemini/config/skills/game-dialogue-ui-localization/scripts/dialogue_tool.py"
fi

if [ ! -f "${TOOL_SCRIPT}" ]; then
    TOOL_SCRIPT="${HOME}/.gemini/config/skills/game-dialogue-ui-localization/scripts/dialogue_tool.py"
fi

exec python3 "${TOOL_SCRIPT}" "$@"
