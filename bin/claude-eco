#!/usr/bin/env bash
# ==============================================================================
# Claude Code CLI Eco Launcher (claude-eco)
# Launches Claude Code in maximum quota-conservation mode:
# - Low extended thinking effort (--effort low, <= 1024 thinking tokens)
# - Prompt cache alignment & strict prefix stabilization
# - Automatic token-guard protection for terminal commands
# ==============================================================================
export CLAUDE_TURBO=1
export MAX_THINKING_TOKENS=1024
export CLAUDE_CODE_NO_FLICKER=1
export CLAUDE_MODE=1

[ -t 1 ] && command -v agy-cheatsheet >/dev/null 2>&1 && agy-cheatsheet --banner
echo -e "\033[32m[🛡️ Claude Eco Mode Active]\033[0m Quota Sentinel enabled: low thinking effort + prompt cache protection."

exec claude --effort low "$@"
