#!/usr/bin/env python3
"""
agy-omni-mode (bin/agy-omni-mode)
Autonomous Dynamic Orchestrator for Antigravity & Local Language Model Fleet.
Dynamically switches between Gemini models (Pro / Flash / Flash-Lite) and local
Ollama models based on task complexity, active step lifecycle, project file types,
and real-time rolling 5-hour quota headroom.
"""

from __future__ import annotations
import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path
from typing import Any

BOLD = "\033[1m"
GREEN = "\033[32m"
CYAN = "\033[36m"
YELLOW = "\033[33m"
RED = "\033[31m"
MAGENTA = "\033[35m"
DIM = "\033[2m"
RESET = "\033[0m"

STATE_FILE = Path(".agents/memory/omni_mode_state.json")
QUOTA_CACHE_FILE = Path(tempfile.gettempdir()) / "agy_quota_cache.json"

# Local models mapped to specialized domains
DOMAIN_LOCAL_MODELS = {
